# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# In production these are read from Rails encrypted credentials (see config/initializers/devise.rb),
# so this file is only needed for local development (dotenv is :development/:test scoped).

# --- Google OAuth (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (Sign in with GitHub) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Sign in with Apple ---
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
# Paste the complete .p8 value. Keep this file local and never commit the value.
APPLE_PRIVATE_KEY="paste-your-private-key-here"

# --- Local dev OmniAuth host override (optional) ---
OMNIAUTH_DEV_FULL_HOST=
