# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# Raw values live in .kamal/secrets.d/ (gitignored). See DEPLOYMENT.md for how to bootstrap.

# Docker Hub access token (create at https://hub.docker.com/settings/security)
KAMAL_REGISTRY_PASSWORD=$(cat .kamal/secrets.d/dockerhub_pat)

# Rails master key - read from file (works both locally and in CI)
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# PostgreSQL password
POSTGRES_PASSWORD=$(cat .kamal/secrets.d/postgres_password)

# Database URL - constructed with the password
DATABASE_URL=postgres://my_signer:$(cat .kamal/secrets.d/postgres_password)@my-signer-db:5432/my_signer_production

# Active Record Encryption keys
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(cat .kamal/secrets.d/active_record_encryption_primary_key)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(cat .kamal/secrets.d/active_record_encryption_deterministic_key)
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(cat .kamal/secrets.d/active_record_encryption_key_derivation_salt)
# Optional during in-flight keyring rotation. The files exist only during
# active rotation and are removed afterwards. `2>/dev/null || echo ""`
# keeps the env vars defined-but-empty in steady state so deploy.yml's
# `env: secret:` lookup resolves cleanly (Kamal halts on missing entries);
# the initializer's `ENV[...].presence` collapses "" back to nil so no
# stale `previous` provider is registered. See mysigner-33.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY_PREVIOUS=$(cat .kamal/secrets.d/active_record_encryption_primary_key_previous 2>/dev/null || echo "")
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY_PREVIOUS=$(cat .kamal/secrets.d/active_record_encryption_deterministic_key_previous 2>/dev/null || echo "")

# Paddle Billing (production/live)
PADDLE_API_KEY=$(cat .kamal/secrets.d/paddle_api_key)
PADDLE_CLIENT_SIDE_TOKEN=$(cat .kamal/secrets.d/paddle_client_side_token)
PADDLE_WEBHOOK_SECRET=$(cat .kamal/secrets.d/paddle_webhook_secret)

# OpenAI (used by AI rewriter, translators) - read from gitignored file
OPENAI_API_KEY=$(cat config/credentials/openai.key)

# AWS KMS — wraps DEKs for customer credential envelope encryption (mysigner-26)
AWS_ACCESS_KEY_ID=$(cat .kamal/secrets.d/aws_access_key_id)
AWS_SECRET_ACCESS_KEY=$(cat .kamal/secrets.d/aws_secret_access_key)
AWS_REGION=$(cat .kamal/secrets.d/aws_region)
MYSIGNER_KMS_KEY_ARN=$(cat .kamal/secrets.d/kms_key_arn)
