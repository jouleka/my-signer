*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/
/log/*.log*

# macOS system files
.DS_Store

# Used by dotenv library to load environment variables.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Apple private keys (App Store Connect API)
*.p8
AuthKey_*.p8

# Local dev/test SQLite databases (never commit data)
storage/*.sqlite3
storage/*.sqlite3-*

# Ignore Byebug command history file.
.byebug_history

## Specific to RubyMotion:
.dat*
.repl_history
build/
*.bridgesupport
build-iPhoneOS/
build-iPhoneSimulator/

## Specific to RubyMotion (use of CocoaPods):
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# vendor/Pods/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*

/app/assets/builds/*
!/app/assets/builds/.keep

/config/credentials/*.key
/config/master.key

# Kamal secret values (raw — referenced from .kamal/secrets via $(cat …))
/.kamal/secrets.d/

/public/assets
/storage/*
!/storage/.keep

# Deepwatch cache
.deepwatch/

# Git worktrees
.worktrees/
.superpowers/
.claude/

# Local signing and cloud-service credentials
*.p12
*.pem
*.key
*.jks
*.keystore
google-service-account*.json
service-account*.json
auth.json

# Internal positioning / feature notes (contains competitor pricing,
# infra detail, and copy that's NOT for public consumption). Keep as a
# working doc — never publish.
MYSIGNER_FEATURES.md
