<%#
  Transactional email shell. Mirrors the MySigner app brand directly:
  warm near-black surface, bright lavender primary, Instrument Serif
  italic accent on the headline, JetBrains Mono for technical
  artifacts, the same violet→pink gradient logo from the web app.

  The email is dark-first because the app is dark-first (see the
  landing page and the auth-shell). Clients that strictly enforce a
  light render get a graceful warm-cream fallback via the
  `@media (prefers-color-scheme: light)` block, but the default
  experience is the dark one — that's the brand.

  Implementation notes
  --------------------
  * Tables for layout (Outlook 2016/2019 limitation).
  * Inline styles for everything load-bearing; <style> only carries
    media queries / scheme overrides (Gmail iOS strips <style>).
  * `<meta name="color-scheme" content="dark light">` opts the email
    in to dark mode in Apple Mail / Outlook 365 / iOS Mail.
  * `[data-ogsc]` selectors honor Outlook.com / Gmail Android
    auto-inversion overrides.
  * Web fonts via Google Fonts <link>. Outlook 2016 desktop falls
    back through the system stack (Georgia for serif, Consolas for
    mono).
  * `@preheader` is the inbox preview line — set with
    `@preheader = "..."` in each mailer template.
%>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, address=no, email=no, date=no, url=no">
  <meta name="color-scheme" content="dark light">
  <meta name="supported-color-schemes" content="dark light">
  <title>MySigner</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!--[if mso]>
  <style type="text/css">
    body, table, td, p, h1, h2, h3 { font-family: Georgia, 'Times New Roman', serif !important; }
    .ms-mono { font-family: Consolas, 'Courier New', monospace !important; }
  </style>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->

  <style type="text/css">
    /* Resets ------------------------------------------------------- */
    body, html { margin: 0 !important; padding: 0 !important; height: 100% !important; width: 100% !important; }
    * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt !important; mso-table-rspace: 0pt !important; border-collapse: collapse !important; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    a { color: inherit; text-decoration: none; }
    .ms-link {
      color: #c8a8f5;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(200,168,245,0.45);
    }

    /* Light-mode override (most clients default to dark for this
       email since color-scheme is dark-first; light is the fallback
       for clients that strictly enforce a light render). */
    @media (prefers-color-scheme: light) {
      body, .ms-body { background: #f5efe2 !important; }
      .ms-paper { background: #f5efe2 !important; }
      .ms-card { background: #fcf8ee !important; border-color: #d6cdb8 !important; box-shadow: 0 1px 0 rgba(31,27,21,0.04) !important; }
      .ms-card-edge { background-color: rgba(79,46,170,0.12) !important; }
      .ms-ink { color: #1f1b15 !important; }
      .ms-mute { color: #4a4439 !important; }
      .ms-faint { color: #8a8378 !important; }
      .ms-rule, .ms-rule-hr td { background-color: #d6cdb8 !important; }
      .ms-eyebrow-rule { background-color: #c4b89e !important; }
      .ms-primary { color: #4f2eaa !important; }
      .ms-link { color: #4f2eaa !important; text-decoration-color: rgba(79,46,170,0.4) !important; }
      .ms-cta-fill a { color: #ffffff !important; }
      .ms-callout-neutral { background: #f0e8d6 !important; border-color: #d6cdb8 !important; }
      .ms-callout-neutral-text, .ms-callout-neutral .ms-callout-text { color: #1f1b15 !important; }
      .ms-callout-success { background: #e6efe5 !important; border-color: #b6cdb1 !important; }
      .ms-callout-success-text { color: #2a5e35 !important; }
      .ms-callout-warning { background: #f6ecd2 !important; border-color: #d6c182 !important; }
      .ms-callout-warning-text { color: #6e4d12 !important; }
      .ms-callout-danger { background: #f3dcd6 !important; border-color: #d6a59b !important; }
      .ms-callout-danger-text { color: #7a2820 !important; }
      .ms-callout-info { background: #e2e8f4 !important; border-color: #a8b8d6 !important; }
      .ms-callout-info-text { color: #243b6e !important; }
      .ms-token-block, .ms-token-block-cell { background: #f0e8d6 !important; color: #1f1b15 !important; border-color: #d6cdb8 !important; }
      .ms-table-head td { background: #f0e8d6 !important; color: #6b6258 !important; border-color: #d6cdb8 !important; }
      .ms-table-row td { color: #1f1b15 !important; border-color: #ebe2d0 !important; }
      .ms-table-row .ms-table-mute { color: #6b6258 !important; }
      .ms-meta-pill { background: rgba(31,27,21,0.06) !important; border-color: rgba(31,27,21,0.14) !important; color: #1f1b15 !important; }
      .ms-pricing-cell { background: #f0e8d6 !important; }
      .ms-wordmark { color: #1f1b15 !important; }
    }

    /* Mobile ------------------------------------------------------ */
    @media only screen and (max-width: 620px) {
      .ms-paper-cell { padding: 28px 14px 36px 14px !important; }
      .ms-shell { width: 100% !important; }
      .ms-card-inner { padding: 30px 22px 34px 22px !important; }
      .ms-headline { font-size: 30px !important; line-height: 1.08 !important; }
      .ms-display-num { font-size: 64px !important; line-height: 0.85 !important; }
      .ms-cta-cell a { padding: 13px 22px !important; font-size: 13.5px !important; }
      .ms-table-cell { padding: 10px 12px !important; font-size: 13px !important; }
      .ms-mobile-hide { display: none !important; }
      .ms-twocol-stack td.ms-twocol { display: block !important; width: 100% !important; padding: 0 0 12px 0 !important; }
      .ms-fromto td { padding: 8px 14px !important; }
      .ms-fromto-arrow { font-size: 16px !important; padding: 4px !important; }
    }
  </style>
</head>
<body class="ms-body" bgcolor="#14110d" style="margin:0; padding:0; background-color:#14110d; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; font-family:'Instrument Serif', Georgia, 'Times New Roman', serif;">

  <% if defined?(@preheader) && @preheader.present? %>
    <div style="display:none; visibility:hidden; opacity:0; color:transparent; height:0; width:0; max-height:0; max-width:0; mso-hide:all; overflow:hidden;">
      <%= @preheader %>
      &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
    </div>
  <% end %>

  <table role="presentation" class="ms-body" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#14110d" style="background-color:#14110d; width:100%;">
    <tr>
      <td align="center" valign="top" class="ms-paper ms-paper-cell" style="padding:48px 24px 56px 24px; background-color:#14110d;">

        <table role="presentation" class="ms-shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px;">

          <%# ── Header: real logo + wordmark + date sigil ───────── %>
          <tr>
            <td align="left" style="padding:0 4px 32px 4px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                <tr>
                  <td align="left" valign="middle" style="vertical-align:middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td valign="middle" style="vertical-align:middle; padding-right:12px; line-height:0;">
                          <img src="data:image/svg+xml;base64," alt="MySigner" width="32" height="32" style="display:block; border-radius:50%;">
                        </td>
                        <td valign="middle" style="vertical-align:middle;">
                          <span class="ms-wordmark" style="font-family:'Instrument Serif', Georgia, 'Times New Roman', serif; font-size:22px; line-height:1; letter-spacing:-0.005em; color:#f4ede0;">MySigner</span>
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" valign="middle" class="ms-mobile-hide" style="vertical-align:middle;">
                    <span class="ms-faint" style="font-family:'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#6e685e;"><%= Date.current.strftime("%Y · %B").upcase %></span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <%# ── Card ──────────────────────────────────────────────── %>
          <tr>
            <td class="ms-card" bgcolor="#1f1a14" style="background-color:#1f1a14; border:1px solid #2c2820; border-radius:8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="ms-card-edge" height="2" style="height:2px; line-height:2px; font-size:0; background-color:rgba(200,168,245,0.4); border-top-left-radius:8px; border-top-right-radius:8px;">&nbsp;</td>
                </tr>
                <tr>
                  <td class="ms-card-inner" style="padding:42px 40px 44px 40px;">
                    <%= yield %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <%# ── Footer ────────────────────────────────────────────── %>
          <tr>
            <td align="center" style="padding:36px 12px 0 12px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="width:100%;">
                <tr>
                  <td align="center" class="ms-mute" style="font-family:'Instrument Serif', Georgia, 'Times New Roman', serif; font-size:14px; line-height:1.6; color:#a8a094;">
                    <span style="font-style:italic;">Sent from</span>
                    <a href="https://mysigner.dev" class="ms-link" style="color:#c8a8f5; text-decoration:none;">MySigner</a>
                    &mdash; ship from your terminal, not a tab.
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top:14px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="ms-rule" width="40" height="1" style="width:40px; height:1px; line-height:1px; font-size:0; background-color:#2c2820;">&nbsp;</td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top:14px;">
                    <span class="ms-faint" style="font-family:'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#6e685e;">
                      &copy; <%= Date.current.year %> MySigner &nbsp;·&nbsp; All rights reserved
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
