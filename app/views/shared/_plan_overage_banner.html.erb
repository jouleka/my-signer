<%
  status = local_assigns.fetch(:status)
  current_project = local_assigns[:current_project]
  compact = local_assigns.fetch(:compact, false)
%>

<% if status&.any? %>
  <div class="rounded-xl border border-warning/15 bg-warning/5 px-4 py-3.5 space-y-3">
    <%# Header %>
    <div class="flex items-start gap-2.5">
      <i class="fa-solid fa-triangle-exclamation text-warning text-xs mt-0.5"></i>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-base-content/85">Usage exceeds plan limits</p>
        <% unless compact %>
          <p class="mt-0.5 text-xs text-base-content/50">Reduce usage or upgrade before the next renewal.</p>
        <% end %>
      </div>
    </div>

    <%# Overage sections %>
    <div class="space-y-2">
      <% status.sections.each do |section| %>
        <div class="flex items-start justify-between gap-3 rounded-lg bg-base-100/60 px-3.5 py-2.5">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-base-content/75"><%= section[:title] %></span>
              <span class="badge badge-warning badge-xs"><%= section[:badge] %></span>
            </div>
            <p class="mt-0.5 text-xs text-base-content/50"><%= section[:summary] %></p>
          </div>
        </div>

        <% if section[:overflow_projects].present? %>
          <div class="flex flex-wrap gap-1.5 pl-3.5">
            <% section[:overflow_projects].each do |project| %>
              <span class="inline-flex items-center gap-1 rounded-md bg-warning/10 px-2 py-0.5 text-xs text-warning">
                <i class="fa-solid fa-folder text-[10px]"></i>
                <%= project.name %>
              </span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Current project overflow notice %>
    <% if current_project.present? && status.project_overflow?(current_project) %>
      <div class="flex items-center gap-2 rounded-lg bg-info/5 border border-info/10 px-3 py-2 text-xs text-base-content/60">
        <i class="fa-solid fa-circle-info text-info text-[10px]"></i>
        <span><strong class="text-base-content/75"><%= current_project.name %></strong> is above the project limit for your plan.</span>
      </div>
    <% end %>
  </div>
<% end %>
