<%# Shared placeholder for upcoming features %>
<%= breadcrumbs(local_assigns[:breadcrumb_items] || [{ label: local_assigns[:title] || "Coming Soon" }]) %>

<div class="space-y-8">
  <div class="hero min-h-[50vh] bg-base-200/20 rounded-box border border-base-200">
    <div class="hero-content text-center">
      <div class="max-w-xl">
        <div class="mb-6 inline-flex items-center justify-center p-4 bg-base-100 rounded-full shadow-sm border border-base-200">
          <i class="<%= local_assigns[:icon] || 'fa-solid fa-rocket' %> text-3xl text-primary"></i>
        </div>
        <% if local_assigns[:pro_badge] %>
          <div class="mb-4">
            <span class="badge badge-primary badge-sm gap-1">
              <i class="fa-solid fa-crown text-xs" aria-hidden="true"></i>
              Pro+
            </span>
          </div>
        <% end %>
        <h1 class="text-3xl font-bold mb-4"><%= local_assigns[:title] || "Coming Soon" %></h1>
        <p class="text-base-content/60 text-lg mb-6"><%= local_assigns[:description] %></p>

        <% if local_assigns[:features].present? %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left mb-8 max-w-lg mx-auto">
            <% local_assigns[:features].each do |feature| %>
              <div class="flex items-start gap-2 p-3 rounded-lg bg-base-100 border border-base-200">
                <i class="fa-solid fa-check text-success mt-0.5" aria-hidden="true"></i>
                <span class="text-sm"><%= feature %></span>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <span class="badge badge-lg badge-outline gap-2">
            <i class="fa-solid fa-clock" aria-hidden="true"></i>
            In Development
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
