<%# Shared error/warning target for the Apple Ads credential flow. Rendered
    in the standalone new page AND inside the connect modal so the controller
    can always turbo_stream.replace this single ID — whichever surface
    triggered the submission keeps its errors inline and stays put.

    Locals:
      credential — the AppleAdsCredential (for .errors and .last_error)

    SECURITY: only surface error messages here. Never echo the submitted
    private_key_pem or any field value — the PEM would leak into HTML. %>
<div id="apple-ads-credential-errors" class="<%= 'space-y-3' if credential.errors.any? || credential.last_error.present? %>" role="alert">
  <% if credential.errors.any? %>
    <div class="<%= sn_error_classes %>">
      <div class="flex items-start gap-2.5 p-1">
        <div class="<%= sn_icon_error_classes %>">
          <i class="fa-solid fa-circle-exclamation text-[0.6rem]"></i>
        </div>
        <div class="text-xs text-error/90 flex-1 min-w-0">
          <strong>We couldn't save this credential.</strong>
          <ul class="mt-1 list-disc list-inside space-y-0.5 text-error/80">
            <% credential.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <% if credential.last_error.present? %>
    <div class="<%= sn_warning_classes %>">
      <div class="flex items-start gap-2.5 p-1">
        <div class="<%= sn_icon_warning_classes %>">
          <i class="fa-solid fa-triangle-exclamation text-[0.6rem]"></i>
        </div>
        <div class="text-xs text-warning/90 flex-1 min-w-0">
          <strong>Connection test failed:</strong>
          <span class="text-warning/80"><%= credential.last_error %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>
