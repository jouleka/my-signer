<% @preheader = "Your #{@resource_type.to_s.downcase} \"#{@resource_name}\" has expired. Builds will fail until renewed." %>

<%= ms_eyebrow(41, "Credentials · Expired") %>

<%= ms_stamp("Expired") %>

<%= ms_headline("#{ERB::Util.h(@resource_type)} <em style=\"font-style:italic; color:#f57c97;\" class=\"ms-callout-danger-text\">has expired.</em>", size: 40) %>

<%= ms_lead("Hello #{ERB::Util.h(@user.name || @user.email)},") %>

<%= ms_meta_row("Resource", "<span class=\"ms-ink\" style=\"color:#f4ede0;\">#{ERB::Util.h(@resource_name)}</span>".html_safe) %>
<%= ms_meta_row("Type", "<span class=\"ms-mute\" style=\"color:#cdc4b6; font-style:italic;\">#{ERB::Util.h(@resource_type)}</span>".html_safe) %>
<%= ms_meta_row("Expired on", "<span class=\"ms-ink\" style=\"color:#f4ede0; font-style:italic;\">#{@resource.expires_at.strftime('%B %-d, %Y')}</span>".html_safe) %>

<%= ms_callout(
  "This resource is no longer valid. Builds depending on it will fail until renewed. Apple typically allows you to issue a replacement immediately from the developer portal &mdash; re-upload it here when you do.",
  variant: :danger,
  accent_label: "Builds at risk"
) %>

<% url = case @resource
         when AppleCertificate
           organization_apple_certificates_url(@resource.organization)
         when AppleProvisioningProfile
           organization_apple_provisioning_profiles_url(@resource.organization)
         else
           polymorphic_url([@resource.organization, @resource])
         end %>

<%= ms_cta("Replace now", url, variant: :danger, margin_top: 4, margin_bottom: 22) %>

<%= ms_fine_print("MySigner detects expirations the same day they occur. We'll stop reminding you once you've uploaded a replacement.") %>
