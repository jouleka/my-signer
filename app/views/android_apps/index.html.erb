<%= render "shared/android_breadcrumbs", organization: @organization, active_tab: :apps %>

<% gp_credential = @organization.google_play_credentials.active.first %>
<% if gp_credential&.play_reporting_api_disabled? %>
  <%= render "shared/play_reporting_api_alert", credential: gp_credential %>
<% end %>
<% if gp_credential && %w[error partial].include?(gp_credential.last_sync_status) && gp_credential.last_sync_error.present? %>
  <div class="card bg-base-200/50 border border-warning/30 mb-4 overflow-hidden">
    <div class="card-body p-3 sm:p-4">
      <div class="flex flex-col sm:flex-row items-start gap-3 sm:gap-4">
        <div class="flex items-start gap-3 flex-1 min-w-0">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-warning/10 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-circle-exclamation text-warning"></i>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-semibold text-sm">
                <%= gp_credential.last_sync_status == 'partial' ? 'Some Apps Failed to Sync' : 'Sync Failed' %>
              </h3>
              <span class="badge badge-warning badge-xs"><%= gp_credential.last_sync_status %></span>
            </div>
            <div class="text-xs text-base-content/70 whitespace-pre-wrap font-mono bg-base-300/50 rounded-lg p-2 sm:p-3 mt-2 max-h-32 sm:max-h-48 overflow-y-auto break-words" style="overflow-wrap: anywhere;"><%= gp_credential.last_sync_error %></div>
          </div>
        </div>
        <button type="button"
                data-controller="sync"
                data-sync-url-value="<%= sync_google_play_api_v1_organization_path(@organization) %>"
                data-sync-status-url-value="<%= sync_status_google_play_organization_path(@organization) %>"
                data-sync-badge-id-value="gplay-sync-badge"
                data-action="click->sync#start"
                data-sync-target="button"
                class="btn btn-sm btn-outline btn-warning gap-2 shrink-0 w-full sm:w-auto">
          <i class="fa-solid fa-arrows-rotate"></i>
          Retry
        </button>
      </div>
    </div>
  </div>
<% end %>

<section class="space-y-4 sm:space-y-6 min-w-0 w-full overflow-hidden">
  <%= render "shared/page_header",
             title: "Android Apps",
             description: "Monitor your Google Play apps, track build uploads, and manage release configurations.",
             gradient: "from-emerald-500/15 via-base-100 to-lime-500/10",
             badge_icon: "fa-brands fa-android",
             badge_text: "Google Play",
             stats: (capture do %>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">Total</div>
          <div class="stat-value text-xl sm:text-2xl"><%= @total_apps %></div>
          <div class="stat-desc">apps</div>
        </div>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">Builds</div>
          <div class="stat-value text-xl sm:text-2xl text-success"><%= @total_builds %></div>
          <div class="stat-desc">uploaded</div>
        </div>
        <% if @q_query.present? %>
          <div class="stat py-2 px-3 sm:py-3 sm:px-5">
            <div class="stat-title text-xs">Filtered</div>
            <div class="stat-value text-xl sm:text-2xl text-accent"><%= @apps.size %></div>
            <div class="stat-desc">showing</div>
          </div>
        <% end %>
             <% end),
             actions: (capture do %>
      <%= link_to organization_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="hidden sm:inline">Back to Organization</span>
        <span class="sm:hidden">Back</span>
      <% end %>
      <% developer_account_id = @organization.google_play_credentials.active.first&.developer_account_id %>
      <% if developer_account_id.present? %>
        <a href="https://play.google.com/console/developers/<%= developer_account_id %>/app-list"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-ghost btn-sm sm:btn-md gap-2">
          <i class="fa-solid fa-external-link"></i>
          <span class="hidden sm:inline">Google Play Console</span>
          <span class="sm:hidden">Console</span>
        </a>
      <% end %>
      <%= link_to new_organization_android_app_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-plus"></i>
        Add App
      <% end %>
             <% end) %>

  <%# Apps Card %>
  <%= render "shared/content_card",
             filter: (capture do %>
    <%= form_with url: organization_android_apps_path(@organization), method: :get, local: true, class: "flex flex-col sm:flex-row gap-3 sm:gap-4 flex-1 min-w-0" do %>
      <div class="form-control flex-1 min-w-0">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-magnifying-glass text-[10px] text-base-content/50"></i>
            Search
          </span>
        </label>
        <input type="text"
               name="q"
               value="<%= @q_query %>"
               placeholder="Package name or app name..."
               class="input input-bordered input-sm w-full" />
      </div>
      <div class="flex items-end gap-2">
        <button class="btn btn-primary btn-sm gap-2" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
          Search
        </button>
        <% if @q_query.present? %>
          <%= link_to organization_android_apps_path(@organization), class: "btn btn-ghost btn-sm gap-2" do %>
            <i class="fa-solid fa-xmark"></i>
            Clear
          <% end %>
        <% end %>
      </div>
    <% end %>
             <% end) do %>

    <% if @apps.any? %>
        <%# Desktop Table %>
        <div class="hidden lg:block">
          <div class="overflow-x-auto rounded-2xl border border-base-200">
            <table class="table">
              <thead>
                <tr class="bg-base-200/50 text-xs uppercase text-base-content/60 font-bold tracking-wider">
                  <th>App</th>
                  <th>Package Name</th>
                  <th>Builds</th>
                  <th>Tracks</th>
                  <th>Latest Release</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @apps.each do |app| %>
                  <% latest = app.play_store_release %>
                  <tr class="hover:bg-base-200/30 transition-colors">
                    <td>
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500/20 to-green-500/20 flex items-center justify-center">
                          <i class="fa-brands fa-android text-emerald-600"></i>
                        </div>
                        <div>
                          <%= link_to organization_android_app_path(@organization, app), class: "font-semibold hover:text-primary transition-colors" do %>
                            <%= app.name.presence || "Unnamed App" %>
                          <% end %>
                          <% if app.default_language.present? %>
                            <div class="text-xs text-base-content/50"><%= app.default_language %></div>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="flex items-center gap-2">
                        <code class="text-xs bg-base-200 px-2 py-1 rounded"><%= app.package_name %></code>
                        <button type="button" class="btn btn-ghost btn-xs btn-square"
                                data-controller="copy"
                                data-action="click->copy#copy"
                                data-copy-text-value="<%= app.package_name %>">
                          <i class="fa-solid fa-copy text-base-content/50"></i>
                        </button>
                      </div>
                    </td>
                    <td>
                      <span class="badge badge-ghost gap-1.5">
                        <i class="fa-solid fa-cube text-[10px]"></i>
                        <%= app.android_builds.size %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-ghost gap-1.5">
                        <i class="fa-solid fa-code-branch text-[10px]"></i>
                        <%= app.android_tracks.size %>
                      </span>
                    </td>
                    <td>
                      <% if latest %>
                        <div class="flex items-center gap-2">
                          <%
                            track_badge = case latest.track
                              when "production" then "badge-success"
                              when "beta" then "badge-warning"
                              when "alpha" then "badge-info"
                              else "badge-ghost"
                            end
                          %>
                          <span class="badge <%= track_badge %> badge-sm capitalize"><%= latest.track %></span>
                          <span class="text-xs text-base-content/60 font-mono">v<%= latest.version_code %></span>
                        </div>
                      <% else %>
                        <span class="text-base-content/30">&mdash;</span>
                      <% end %>
                    </td>
                    <td class="text-right">
                      <div class="flex items-center justify-end gap-1">
                        <%= link_to organization_android_app_path(@organization, app), class: "btn btn-ghost btn-xs gap-1.5" do %>
                          <i class="fa-solid fa-eye"></i>
                          View
                        <% end %>
                        <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                                data-controller="raw-json"
                                data-action="click->raw-json#show"
                                data-raw-json-content-value="<%= app.raw_json %>"
                                data-raw-json-title-value="App: <%= app.name %>">
                          <i class="fa-solid fa-code"></i>
                          JSON
                        </button>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# Mobile Cards %>
        <div class="lg:hidden space-y-3">
          <% @apps.each do |app| %>
            <% latest = app.play_store_release %>
            <div class="card border border-base-200 shadow-sm overflow-hidden">
              <div class="card-body p-3 sm:p-4 space-y-3 min-w-0">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-emerald-500/20 to-green-500/20 flex items-center justify-center shrink-0">
                    <i class="fa-brands fa-android text-emerald-600 sm:text-lg"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <%= link_to organization_android_app_path(@organization, app), class: "font-semibold text-sm sm:text-base hover:text-primary transition-colors block truncate" do %>
                      <%= app.name.presence || "Unnamed App" %>
                    <% end %>
                    <code class="text-xs text-base-content/60 block truncate"><%= app.package_name %></code>
                  </div>
                </div>

                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  <span class="badge badge-ghost gap-1 badge-sm">
                    <i class="fa-solid fa-cube text-[8px]"></i>
                    <%= app.android_builds.size %> builds
                  </span>
                  <span class="badge badge-ghost gap-1 badge-sm">
                    <i class="fa-solid fa-code-branch text-[8px]"></i>
                    <%= app.android_tracks.size %> tracks
                  </span>
                  <% if latest %>
                    <%
                      track_badge = case latest.track
                        when "production" then "badge-success"
                        when "beta" then "badge-warning"
                        when "alpha" then "badge-info"
                        else "badge-ghost"
                      end
                    %>
                    <span class="badge <%= track_badge %> badge-sm capitalize"><%= latest.track %> v<%= latest.version_code %></span>
                  <% end %>
                </div>

                <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-1">
                  <%= link_to organization_android_app_path(@organization, app), class: "btn btn-primary btn-xs gap-1.5" do %>
                    <i class="fa-solid fa-eye"></i>
                    View
                  <% end %>
                  <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                          data-controller="copy"
                          data-action="click->copy#copy"
                          data-copy-text-value="<%= app.package_name %>">
                    <i class="fa-solid fa-copy"></i>
                    Copy
                  </button>
                  <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                          data-controller="raw-json"
                          data-action="click->raw-json#show"
                          data-raw-json-content-value="<%= app.raw_json %>"
                          data-raw-json-title-value="App: <%= app.name %>">
                    <i class="fa-solid fa-code"></i>
                    JSON
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%# Empty State %>
        <div class="flex flex-col items-center justify-center py-10 sm:py-16 text-center px-2">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-emerald-500/20 to-green-500/20 flex items-center justify-center mb-4">
            <i class="fa-brands fa-android text-2xl sm:text-3xl text-emerald-500/50"></i>
          </div>
          <h3 class="text-lg sm:text-xl font-bold">No Apps Found</h3>
          <% if @q_query.present? %>
            <p class="text-base-content/60 max-w-sm mt-2 mb-6 text-sm break-words">
              No apps match "<strong><%= @q_query %></strong>". Try a different search.
            </p>
            <div class="flex gap-3">
              <%= link_to organization_android_apps_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
                <i class="fa-solid fa-xmark"></i>
                Clear Search
              <% end %>
            </div>
          <% else %>
            <p class="text-base-content/60 max-w-md mt-2 mb-6 text-sm break-words">
              Google Play API doesn't automatically discover apps. Add your apps manually or grant your service account access to specific apps in Google Play Console.
            </p>
            <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-6 sm:mb-8">
              <%= link_to new_organization_android_app_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
                <i class="fa-solid fa-plus"></i>
                Add App Manually
              <% end %>
              <%= link_to organization_path(@organization, anchor: "google-play-credentials"), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
                <i class="fa-solid fa-key"></i>
                Credentials
              <% end %>
            </div>

            <%# Collapsible Help Section %>
            <div class="collapse collapse-arrow bg-base-200/50 border border-base-200 max-w-xl mx-auto text-left overflow-hidden">
              <input type="checkbox" />
              <div class="collapse-title font-medium flex items-center gap-2 text-sm">
                <i class="fa-solid fa-circle-question text-info"></i>
                Why don't my apps appear automatically?
              </div>
              <div class="collapse-content">
                <div class="space-y-4 pt-2">
                  <p class="text-sm text-base-content/70 break-words">
                    Unlike iOS, the Google Play API <strong>doesn't support app discovery</strong>. Your apps will only appear if:
                  </p>
                  <div class="space-y-3">
                    <div class="flex items-start gap-3 text-sm">
                      <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center shrink-0 mt-0.5">
                        <span class="text-xs font-bold text-primary">1</span>
                      </div>
                      <div class="min-w-0">
                        <p class="font-medium">Add apps manually here</p>
                        <p class="text-base-content/60 text-xs mt-0.5 break-words">
                          Click "Add App Manually" and enter the package name. Metadata will sync when credentials have access.
                        </p>
                      </div>
                    </div>
                    <div class="flex items-start gap-3 text-sm">
                      <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center shrink-0 mt-0.5">
                        <span class="text-xs font-bold text-primary">2</span>
                      </div>
                      <div class="min-w-0">
                        <p class="font-medium">Grant per-app access in Google Play Console</p>
                        <p class="text-base-content/60 text-xs mt-0.5 break-words">
                          Go to <strong>Users and permissions</strong> &rarr; select your service account &rarr; <strong>Add app</strong> to grant access.
                        </p>
                        <% dev_id = @organization.google_play_credentials.active.first&.developer_account_id %>
                        <% if dev_id.present? %>
                          <a href="https://play.google.com/console/developers/<%= dev_id %>/users-and-permissions"
                             target="_blank"
                             rel="noopener noreferrer"
                             class="link link-primary text-xs mt-1 inline-flex items-center gap-1">
                            Open Users & Permissions
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                          </a>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="divider my-2"></div>
                  <p class="text-xs text-base-content/50 break-words">
                    <i class="fa-solid fa-lightbulb text-warning mr-1"></i>
                    Tip: Adding an app manually is the fastest way to get started.
                  </p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
  <% end %>
</section>
