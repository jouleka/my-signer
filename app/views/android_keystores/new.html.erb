<%= render "shared/android_breadcrumbs", organization: @organization, active_tab: :keystores %>

<section class="space-y-4 sm:space-y-6 min-w-0 w-full overflow-hidden">
  <%= render "shared/page_header",
             title: "Upload Android Keystore",
             description: "Securely upload your signing key. We'll validate the password and alias immediately to ensure everything works correctly.",
             gradient: "from-amber-500/10 via-base-100 to-orange-500/10",
             badge_icon: "fa-solid fa-key",
             badge_text: "New Keystore",
             actions: (capture do %>
      <%= link_to organization_android_keystores_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="hidden sm:inline">Back to Keystores</span>
        <span class="sm:hidden">Back</span>
      <% end %>
             <% end) %>

  <div class="grid lg:grid-cols-3 gap-4 sm:gap-6">
    <%# Main Form Card %>
    <div class="lg:col-span-2 min-w-0 overflow-hidden">
      <div class="card bg-base-100 border border-base-200 shadow-xl overflow-hidden">
        <div class="card-body p-4 sm:p-6 md:p-8 min-w-0">
          <%= form_with model: [@organization, @keystore], local: true, html: { class: "space-y-6 sm:space-y-8 min-w-0", multipart: true }, data: { controller: "keystore-form" } do |f| %>
            <%# Error Messages %>
            <% if @keystore.errors.any? %>
              <div class="alert alert-error shadow-lg text-sm">
                <i class="fa-solid fa-circle-exclamation shrink-0"></i>
                <div class="min-w-0">
                  <h3 class="font-bold">Validation Failed</h3>
                  <ul class="text-sm mt-1 space-y-0.5">
                    <% @keystore.errors.full_messages.each do |msg| %>
                      <li>• <%= msg %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>

            <%# Step 1: Basic Info %>
            <div class="space-y-4">
              <div class="flex items-center gap-3 mb-2 sm:mb-4">
                <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">1</div>
                <h2 class="text-base sm:text-lg font-bold">Basic Information</h2>
              </div>

              <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
                <div class="form-control w-full min-w-0">
                  <label class="label px-0">
                    <span class="label-text font-medium flex items-center gap-2">
                      <i class="fa-solid fa-tag text-xs text-base-content/50"></i>
                      Display Name
                    </span>
                    <span class="label-text-alt badge badge-ghost badge-xs shrink-0">Required</span>
                  </label>
                  <%= f.text_field :name, class: "input input-bordered w-full focus:input-primary", placeholder: "e.g. Production Release Key", required: true %>
                  <p class="text-xs text-base-content/50 mt-1.5 break-words">A friendly name to identify this keystore</p>
                </div>

                <div class="form-control w-full min-w-0">
                  <label class="label px-0">
                    <span class="label-text font-medium flex items-center gap-2">
                      <i class="fa-brands fa-android text-xs text-base-content/50"></i>
                      App Assignment
                    </span>
                    <span class="label-text-alt badge badge-outline badge-xs shrink-0">Optional</span>
                  </label>
                  <%= render "shared/custom_select",
                             name: "android_keystore[android_app_id]",
                             options: [["Organization-wide (all apps)", ""]] + @android_apps.map { |a| [a.package_name, a.id.to_s] },
                             selected: @keystore.android_app_id.to_s,
                             size: "md" %>
                  <p class="text-xs text-base-content/50 mt-1.5 break-words">Link to a specific app or use for all apps</p>
                </div>
              </div>
            </div>

            <div class="divider my-0"></div>

            <%# Step 2: File Upload %>
            <div class="space-y-4">
              <div class="flex items-center gap-3 mb-2 sm:mb-4">
                <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">2</div>
                <h2 class="text-base sm:text-lg font-bold">Keystore File</h2>
              </div>

              <div class="form-control w-full min-w-0">
                <div class="relative group">
                  <div class="border-2 border-dashed border-base-300 rounded-xl sm:rounded-2xl p-5 sm:p-8 text-center transition-all duration-200 group-hover:border-primary/50 group-hover:bg-primary/5" data-keystore-form-target="dropZone">
                    <div class="flex flex-col items-center gap-3 sm:gap-4">
                      <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-primary/10 flex items-center justify-center">
                        <i class="fa-solid fa-file-arrow-up text-xl sm:text-2xl text-primary"></i>
                      </div>
                      <div>
                        <p class="font-medium text-base-content text-sm sm:text-base">
                          Drop your keystore file here
                        </p>
                        <p class="text-xs sm:text-sm text-base-content/60 mt-1">
                          or tap to browse
                        </p>
                      </div>
                      <%= f.file_field :keystore_file,
                          class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer",
                          accept: ".jks,.keystore",
                          data: { keystore_form_target: "fileInput", action: "change->keystore-form#updateFileName" } %>
                      <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-base-content/50">
                        <span class="badge badge-ghost gap-1 badge-sm">
                          <i class="fa-solid fa-file-code text-[10px]"></i>
                          .jks
                        </span>
                        <span class="badge badge-ghost gap-1 badge-sm">
                          <i class="fa-solid fa-file-code text-[10px]"></i>
                          .keystore
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="hidden mt-3 p-3 rounded-xl bg-success/10 border border-success/20" data-keystore-form-target="filePreview">
                    <div class="flex items-center gap-3 min-w-0">
                      <i class="fa-solid fa-file-check text-success shrink-0"></i>
                      <span class="font-medium text-success truncate" data-keystore-form-target="fileName">No file selected</span>
                      <button type="button" class="btn btn-ghost btn-xs btn-circle ml-auto shrink-0" data-action="click->keystore-form#clearFile">
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="divider my-0"></div>

            <%# Step 3: Credentials %>
            <div class="space-y-4">
              <div class="flex items-center gap-3 mb-2 sm:mb-4">
                <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">3</div>
                <h2 class="text-base sm:text-lg font-bold">Credentials</h2>
              </div>

              <div class="bg-base-200/30 p-3 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl space-y-4 sm:space-y-5 border border-base-200 overflow-hidden">
                <div class="grid md:grid-cols-2 gap-4 sm:gap-5">
                  <div class="form-control w-full min-w-0">
                    <label class="label px-0">
                      <span class="label-text font-medium flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-lock text-xs text-base-content/50"></i>
                        Keystore Password
                      </span>
                    </label>
                    <div class="join w-full">
                      <%= f.password_field :keystore_password,
                          class: "input input-bordered join-item flex-1 min-w-0 font-mono text-sm",
                          required: true,
                          autocomplete: "off",
                          placeholder: "••••••••••••",
                          data: { keystore_form_target: "keystorePassword" } %>
                      <button type="button" class="btn btn-ghost join-item shrink-0" tabindex="-1" data-action="click->keystore-form#toggleKeystorePassword">
                        <i class="fa-solid fa-eye text-base-content/50"></i>
                      </button>
                    </div>
                    <p class="text-xs text-base-content/50 mt-1.5">Protects the keystore file itself</p>
                  </div>

                  <div class="form-control w-full min-w-0">
                    <label class="label px-0">
                      <span class="label-text font-medium flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-key text-xs text-base-content/50"></i>
                        Key Password
                      </span>
                    </label>
                    <div class="join w-full">
                      <%= f.password_field :key_password,
                          class: "input input-bordered join-item flex-1 min-w-0 font-mono text-sm",
                          required: true,
                          autocomplete: "off",
                          placeholder: "••••••••••••",
                          data: { keystore_form_target: "keyPassword" } %>
                      <button type="button" class="btn btn-ghost join-item shrink-0" tabindex="-1" data-action="click->keystore-form#toggleKeyPassword">
                        <i class="fa-solid fa-eye text-base-content/50"></i>
                      </button>
                    </div>
                    <p class="text-xs text-base-content/50 mt-1.5">Often the same as keystore password</p>
                  </div>
                </div>

                <div class="form-control w-full min-w-0">
                  <label class="label px-0">
                    <span class="label-text font-medium flex items-center gap-2 text-sm">
                      <i class="fa-solid fa-at text-xs text-base-content/50"></i>
                      Key Alias
                    </span>
                    <span class="label-text-alt">
                      <button type="button" class="link link-hover text-xs" data-action="click->keystore-form#fillDefaultAlias">
                        Use default: key0
                      </button>
                    </span>
                  </label>
                  <%= f.text_field :key_alias,
                      class: "input input-bordered w-full font-mono text-sm focus:input-primary",
                      placeholder: "e.g. key0, upload, release-key",
                      required: true,
                      data: { keystore_form_target: "keyAlias" } %>
                  <p class="text-xs text-base-content/50 mt-1.5 break-words">
                    The name of the key entry inside the keystore.
                    <span class="font-medium">Not</span> the filename.
                  </p>
                </div>
              </div>
            </div>

            <div class="divider my-0"></div>

            <%# Step 4: Options %>
            <div class="space-y-4">
              <div class="flex items-center gap-3 mb-2 sm:mb-4">
                <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">4</div>
                <h2 class="text-base sm:text-lg font-bold">Options</h2>
              </div>

              <label class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 rounded-xl border border-base-200 bg-base-100 cursor-pointer hover:border-primary/50 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                <%= f.check_box :active, class: "checkbox checkbox-primary checkbox-sm sm:checkbox-md mt-0.5", checked: @keystore.active? %>
                <div class="flex-1 min-w-0">
                  <span class="font-semibold block text-sm sm:text-base">Set as active signing keystore</span>
                  <span class="text-xs sm:text-sm text-base-content/60 block mt-0.5 break-words">
                    New builds for the assigned app will automatically use this key for signing.
                  </span>
                </div>
                <i class="fa-solid fa-bolt text-primary opacity-50 shrink-0"></i>
              </label>
            </div>

            <%# Submit Section %>
            <div class="flex flex-col gap-3 pt-4 sm:pt-6 border-t border-base-200">
              <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <p class="text-xs text-base-content/50 flex items-center gap-2 justify-center sm:justify-start">
                  <i class="fa-solid fa-shield-check text-success shrink-0"></i>
                  <span>Your keystore is encrypted at rest</span>
                </p>
                <div class="flex items-center gap-2 sm:gap-3">
                  <%= link_to "Cancel", organization_android_keystores_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md flex-1 sm:flex-initial" %>
                  <%= f.submit "Upload & Validate", class: "btn btn-primary btn-sm sm:btn-md gap-2 px-4 sm:px-6 flex-1 sm:flex-initial" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Sidebar %>
    <div class="space-y-4 sm:space-y-6 min-w-0 overflow-hidden">
      <%# Security Info Card %>
      <div class="card bg-gradient-to-br from-emerald-500/10 to-teal-500/10 border border-success/20 shadow-lg overflow-hidden">
        <div class="card-body p-4 sm:p-5 min-w-0">
          <h3 class="font-bold flex items-center gap-2 text-success text-sm sm:text-base">
            <i class="fa-solid fa-shield-halved shrink-0"></i>
            Security
          </h3>
          <ul class="text-xs sm:text-sm space-y-2.5 sm:space-y-3 mt-2">
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-success text-xs mt-0.5 shrink-0"></i>
              <span class="text-base-content/70">Keystores are encrypted with AES-256-GCM</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-success text-xs mt-0.5 shrink-0"></i>
              <span class="text-base-content/70">Passwords are never stored in plain text</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-success text-xs mt-0.5 shrink-0"></i>
              <span class="text-base-content/70">Keys are validated before being stored</span>
            </li>
          </ul>
        </div>
      </div>

      <%# Tips Card %>
      <div class="card bg-base-100 border border-base-200 shadow-lg overflow-hidden">
        <div class="card-body p-4 sm:p-5 min-w-0">
          <h3 class="font-bold flex items-center gap-2 text-sm sm:text-base">
            <i class="fa-solid fa-lightbulb text-warning shrink-0"></i>
            Tips
          </h3>
          <div class="space-y-3 sm:space-y-4 mt-2 text-sm">
            <div class="flex items-start gap-2.5 sm:gap-3">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-info/10 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-fingerprint text-info text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="font-medium text-base-content text-sm">Key Alias</p>
                <p class="text-base-content/60 text-xs mt-0.5 break-words">
                  Usually <code class="bg-base-200 px-1 rounded text-[11px]">key0</code>, <code class="bg-base-200 px-1 rounded text-[11px]">upload</code>, or your custom name.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-2.5 sm:gap-3">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-warning/10 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-sync text-warning text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="font-medium text-base-content text-sm">Same Passwords?</p>
                <p class="text-base-content/60 text-xs mt-0.5 break-words">
                  Most keystores use the same password for both the file and the key.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-2.5 sm:gap-3">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-error/10 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-triangle-exclamation text-error text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="font-medium text-base-content text-sm">Lost Password?</p>
                <p class="text-base-content/60 text-xs mt-0.5 break-words">
                  Keystore passwords cannot be recovered. You'll need to create a new one.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Need Help Card %>
      <div class="card bg-base-200/50 border border-base-200 overflow-hidden">
        <div class="card-body p-4 sm:p-5 min-w-0">
          <h3 class="font-bold flex items-center gap-2 text-sm">
            <i class="fa-solid fa-circle-question text-info shrink-0"></i>
            Need Help?
          </h3>
          <p class="text-xs text-base-content/60 mt-2 break-words">
            Don't have a keystore yet? You can create one using Android Studio or the command line.
          </p>
          <a href="https://developer.android.com/studio/publish/app-signing" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm gap-2 mt-3 w-full text-xs">
            <i class="fa-brands fa-android"></i>
            Android Docs
            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
