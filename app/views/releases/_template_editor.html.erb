<%# Template editor: NEW / IMPROVED / FIXED bullet lists.
    Wired to release_note_editor_controller.js — items render to a hidden
    rendered_text input via the controller's _renderPreview(). %>
<% note = local_assigns[:release_note] || @release_note %>
<% template_data = (note&.template_data || {}) %>
<% categories = [
  { key: "new",      label: "NEW",      icon: "fa-solid fa-sparkles", target: "newList",      border: "border-l-[var(--color-cat-new)]",      label_color: "text-[var(--color-cat-new)]" },
  { key: "improved", label: "IMPROVED", icon: "fa-solid fa-bolt",     target: "improvedList", border: "border-l-[var(--color-cat-improved)]", label_color: "text-[var(--color-cat-improved)]" },
  { key: "fixed",    label: "FIXED",    icon: "fa-solid fa-wrench",   target: "fixedList",    border: "border-l-[var(--color-cat-fixed)]",    label_color: "text-[var(--color-cat-fixed)]" }
] %>

<div data-release-note-editor-target="templatePanel">
  <% categories.each do |cat| %>
    <% items = (template_data[cat[:key]] || template_data[cat[:key].to_sym] || []).select(&:present?) %>
    <div class="border-l-[3px] pl-4 mb-6 <%= cat[:border] %>">
      <div class="flex items-center gap-2 mb-2">
        <i class="<%= cat[:icon] %> <%= cat[:label_color] %> text-xs"></i>
        <span class="text-[0.6875rem] font-bold uppercase tracking-[0.06em] <%= cat[:label_color] %>"><%= cat[:label] %></span>
      </div>

      <div data-release-note-editor-target="<%= cat[:target] %>">
        <% items.each do |item| %>
          <div class="flex gap-2 items-center mb-2" data-bullet-item>
            <span class="text-sm font-semibold text-base-content/30 shrink-0 w-4 text-center">-</span>
            <input type="text"
                   class="<%= input_field_classes %> flex-1"
                   value="<%= item %>"
                   placeholder="Add <%= cat[:key] %> item..."
                   data-action="input->release-note-editor#updatePreview" />
            <button type="button"
                    class="flex items-center justify-center w-6 h-6 rounded border-0 bg-transparent text-base-content/25 cursor-pointer transition-all hover:bg-error/10 hover:text-error/80 shrink-0"
                    data-action="click->release-note-editor#removeItem"
                    aria-label="Remove">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        <% end %>
      </div>

      <button type="button"
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1.5 rounded-md border border-dashed border-base-content/[0.12] bg-transparent text-base-content/40 cursor-pointer transition-all duration-150 mt-1 hover:border-primary/30 hover:text-primary/80 hover:bg-primary/[0.04]"
              data-action="click->release-note-editor#addItem"
              data-release-note-editor-category-param="<%= cat[:key] %>">
        <i class="fa-solid fa-plus"></i> Add <%= cat[:label].downcase %> item
      </button>
    </div>
  <% end %>
</div>
