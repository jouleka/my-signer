<%# ── What's New Tab ──
    Locale-switched editor. The Locale dropdown selects which panel is shown:
      - Base locale:  Version + Template/Freeform editor (autosaves via
                      update_release_note action)
      - Every other locale with a StoreListing on this app:
                      a single translation textarea (autosaves via
                      update_release_translation action)
    Live refresh is pushed from AI jobs via ReleaseNote#trigger_live_refresh.
    Autosave responses are `head :ok` so the page never navigates mid-keystroke. %>

<% if @release_note %>
  <%= turbo_stream_from @release_note %>
<% end %>

<%# Sub-tab navigation %>
<div class="<%= subtab_bar_classes %>">
  <%= link_to organization_release_path(@organization, params[:id], tab: "whats_new", note_id: @release_note&.id),
      class: (@subtab.blank? ? subtab_active_classes : subtab_inactive_classes) do %>
    Current
  <% end %>
  <%= link_to organization_release_path(@organization, params[:id], tab: "whats_new", subtab: "history"),
      class: (@subtab == 'history' ? subtab_active_classes : subtab_inactive_classes) do %>
    History
  <% end %>
</div>

<% if @subtab == "history" %>
  <%= render "releases/whats_new_history" %>
<% elsif @release_note.nil? %>
  <%# ── Empty state: no release note exists for this version yet ── %>
  <div class="<%= card_container_classes %>">
    <div class="<%= card_body_classes %>">
      <div class="<%= empty_state_classes %>">
        <div class="<%= empty_state_icon_classes %>">
          <i class="fa-solid fa-pen-fancy text-2xl"></i>
        </div>
        <h2 class="<%= empty_state_title_classes %>">No release notes yet</h2>
        <p class="<%= empty_state_text_classes %>">
          Start drafting the "What's New" text for v<%= @app_release.version_string %>.
          You can use the structured template (NEW / IMPROVED / FIXED) or write freeform.
        </p>
        <%= form_with url: create_release_note_organization_release_path(@organization, params[:id]),
            method: :post, class: "inline" do |f| %>
          <%= hidden_field_tag "release_note[version_string]", @app_release.version_string %>
          <%= hidden_field_tag "release_note[locale]", @primary_locale %>
          <button type="submit" class="<%= btn_primary_classes %>">
            <i class="fa-solid fa-plus"></i> Create Release Note
          </button>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <%
    note = @release_note
    can_edit = !(@organization.supports_review_workflow? && note.pending_review?)
    is_freeform_initial = note.template_data.blank? ||
                          (note.template_data.is_a?(Hash) && note.template_data.values.flatten.compact_blank.empty?) && note.rendered_text.present?

    base_locale   = note.locale
    translations  = note.translations.is_a?(Hash) ? note.translations : {}
    other_locales = @organization.store_listings
      .where(listable: note.listable)
      .where.not(locale: base_locale)
      .pluck(:locale)
      .uniq
      .sort
    # Also expose locales that have translation text but no listing yet, so the
    # user can still review/edit them.
    orphan_translation_locales = (translations.keys.map(&:to_s) - other_locales - [base_locale]).sort
    all_locales = ([base_locale] + other_locales + orphan_translation_locales).uniq
  %>

  <section class="flex flex-col gap-6"
           data-controller="release-note-editor locale-switcher"
           data-release-note-editor-char-limit-value="<%= note.char_limit %>"
           data-release-note-editor-platform-value="<%= note.platform %>"
           data-locale-switcher-active-value="<%= base_locale %>"
           data-locale-switcher-base-locale-value="<%= base_locale %>">

    <%# ── Review state banners (only when org supports review workflow) ── %>
    <% if @organization.supports_review_workflow? %>
      <% if note.pending_review? %>
        <div class="<%= sn_warning_classes %>">
          <div class="flex items-start gap-3">
            <div class="<%= sn_icon_warning_classes %> mt-0.5">
              <i class="fa-solid fa-clock text-[0.625rem]"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-base-content/90">Awaiting review</p>
              <p class="text-xs text-base-content/50 mt-1">
                Submitted for review <%= time_ago_in_words(note.submitted_for_review_at) %> ago.
                <% if note.created_by %>by <%= note.created_by.email %><% end %>
              </p>
            </div>
            <% if ReleaseNotePolicy.new(current_user, note).approve_review? %>
              <%= button_to approve_review_organization_release_path(@organization, params[:id], note_id: note.id),
                  method: :post, class: btn_success_sm_classes,
                  form: { class: "inline" } do %>
                <i class="fa-solid fa-check"></i> Approve
              <% end %>
              <button type="button" class="<%= btn_ghost_sm_classes %>"
                      data-controller="modal"
                      data-action="click->modal#open"
                      data-modal-target-value="reject-review-modal">
                <i class="fa-solid fa-xmark"></i> Request Changes
              </button>
            <% end %>
          </div>
        </div>

        <%# Reject modal %>
        <dialog id="reject-review-modal" class="modal">
          <div class="modal-box">
            <form method="dialog">
              <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
                      data-controller="modal"
                      data-action="click->modal#close"
                      data-modal-target-value="reject-review-modal">✕</button>
            </form>
            <h3 class="font-bold text-lg">Request Changes</h3>
            <p class="text-xs text-base-content/50 mt-1 mb-3">Tell the author what needs to change.</p>
            <%= form_with url: reject_review_organization_release_path(@organization, params[:id], note_id: note.id),
                method: :post, local: true do %>
              <textarea name="comment" class="<%= textarea_field_classes %>" rows="4" required
                        placeholder="What needs to change?"></textarea>
              <div class="modal-action">
                <button type="button" class="<%= btn_ghost_classes %>"
                        data-controller="modal"
                        data-action="click->modal#close"
                        data-modal-target-value="reject-review-modal">Cancel</button>
                <button type="submit" class="<%= btn_primary_classes %>">
                  <i class="fa-solid fa-paper-plane"></i> Send
                </button>
              </div>
            <% end %>
          </div>
          <form method="dialog" class="modal-backdrop"><button>close</button></form>
        </dialog>
      <% elsif note.rejected? %>
        <div class="<%= sn_error_classes %>">
          <div class="flex items-start gap-3">
            <div class="<%= sn_icon_error_classes %> mt-0.5">
              <i class="fa-solid fa-xmark text-[0.625rem]"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-base-content/90">Changes requested</p>
              <% if note.review_comment.present? %>
                <p class="text-xs text-base-content/60 mt-1 italic">"<%= note.review_comment %>"</p>
              <% end %>
              <p class="text-xs text-base-content/40 mt-1">
                — <%= note.reviewed_by&.email || "reviewer" %>,
                <%= time_ago_in_words(note.reviewed_at) %> ago
              </p>
            </div>
          </div>
        </div>
      <% elsif note.approved? %>
        <div class="<%= sn_success_classes %>">
          <div class="flex items-center gap-3">
            <div class="<%= sn_icon_success_classes %>">
              <i class="fa-solid fa-check text-[0.625rem]"></i>
            </div>
            <span class="text-sm text-base-content/80">
              Approved by <%= note.reviewed_by&.email || "reviewer" %>
              <span class="text-xs text-base-content/40 ml-1"><%= time_ago_in_words(note.reviewed_at) %> ago</span>
            </span>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# ── Top action row ──
        AI Rewrite and Translate only make sense from the base locale — the
        locale switcher hides them when another locale is active. Apply works
        from any locale (it's a per-note commit to all listings). %>
    <div class="flex items-center gap-2 flex-wrap">
      <% if can_edit %>
        <div data-locale-switcher-target="baseOnlyAction">
          <%= render "releases/ai_rewrite_button" %>
        </div>
        <div data-locale-switcher-target="baseOnlyAction">
          <%= render "releases/translate_button", release_note: note %>
        </div>
        <%= render "releases/apply_button", release_note: note %>

        <% if @organization.supports_review_workflow? && note.status == "draft" && !note.rejected? %>
          <%= button_to submit_for_review_organization_release_path(@organization, params[:id], note_id: note.id),
              method: :post, class: btn_ghost_sm_classes,
              form: { class: "inline" },
              data: { turbo_confirm: "Submit this release note for review?" } do %>
            <i class="fa-solid fa-paper-plane"></i> Submit for Review
          <% end %>
        <% end %>
      <% end %>

      <div class="ml-auto flex items-center gap-2">
        <span data-locale-switcher-target="savingIndicator"
              class="inline-flex items-center gap-1.5 text-[0.625rem] text-success/80">
          <i class="fa-regular fa-circle-check"></i>
          <span>Saved</span>
        </span>
        <% if note.version_string.present? %>
          <span class="<%= version_badge_classes %>">v<%= note.version_string %></span>
        <% end %>
        <span class="<%= status_badge_classes(note.status) %>">
          <%= note.status.tr("_", " ").titleize %>
        </span>
      </div>
    </div>

    <%# ── Editor + sticky preview layout ── %>
    <div class="grid grid-cols-1 xl:grid-cols-[1fr_380px] gap-6 items-start">
      <div class="flex flex-col gap-5 min-w-0">

        <%# ── Version + Locale switcher row ──
            Version autosaves via its own tiny form.
            Locale dropdown is NOT in a form — it just switches panels. %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="<%= label_form_classes %> mb-1.5"><span>Version</span></label>
            <%= form_with(model: note,
                  url: update_release_note_organization_release_path(@organization, params[:id], note_id: note.id),
                  method: :patch,
                  data: {
                    locale_switcher_target: "baseForm",
                    action: "input->locale-switcher#scheduleAutosave focusout->locale-switcher#flushOnBlur"
                  }) do |f| %>
              <%= f.text_field :version_string, class: input_field_classes, placeholder: "e.g. 1.2.3", disabled: !can_edit %>
            <% end %>
          </div>
          <div>
            <label class="<%= label_form_classes %> mb-1.5"><span>Locale</span></label>
            <select data-locale-switcher-target="selector"
                    data-action="change->locale-switcher#switch"
                    class="<%= input_field_classes %>">
              <% all_locales.each do |loc| %>
                <% is_base = loc == base_locale %>
                <% has_translation = translations[loc].to_s.strip.present? %>
                <% label = is_base ? "#{loc} — base" : (has_translation ? loc : "#{loc} — not translated") %>
                <option value="<%= loc %>" <%= "selected" if is_base %>><%= label %></option>
              <% end %>
            </select>
          </div>
        </div>

        <%# ── Base locale panel ──
            Contains the template / freeform editor. Autosaves via the form's
            input->locale-switcher#scheduleAutosave action. Tabs live inside
            the panel (not above) so base and translation locales have the
            same visual layout. %>
        <div data-locale-switcher-target="panel" data-locale="<%= base_locale %>">
          <%= form_with(model: note,
                url: update_release_note_organization_release_path(@organization, params[:id], note_id: note.id),
                method: :patch,
                class: "flex flex-col gap-5",
                data: {
                  locale_switcher_target: "baseForm",
                  action: "input->locale-switcher#scheduleAutosave focusout->locale-switcher#flushOnBlur"
                }) do |f| %>

            <%# Hidden fields the release-note-editor controller writes into. %>
            <%= hidden_field_tag "release_note[rendered_text]", note.rendered_text,
                data: { release_note_editor_target: "renderedTextInput" } %>
            <%= hidden_field_tag "release_note[template_data]", note.template_data.to_json,
                data: { release_note_editor_target: "templateDataInput" } %>

            <%# ── Template / Freeform tabs — same placement as translation panels ── %>
            <% if can_edit %>
              <div class="flex gap-[0.125rem] border-b border-base-content/[0.06]">
                <button type="button"
                        class="<%= is_freeform_initial ? 'is-tab-inactive' : 'is-tab-active' %>"
                        data-mode-tab="template"
                        data-action="click->release-note-editor#switchToTemplate">
                  <i class="fa-solid fa-list-check"></i> Template
                </button>
                <button type="button"
                        class="<%= is_freeform_initial ? 'is-tab-active' : 'is-tab-inactive' %>"
                        data-mode-tab="freeform"
                        data-action="click->release-note-editor#switchToFreeform">
                  <i class="fa-solid fa-pen-nib"></i> Freeform
                </button>
              </div>
            <% end %>

            <%# Template panel %>
            <div class="<%= 'hidden' if is_freeform_initial %>" data-release-note-editor-target="templatePanel">
              <%= render "releases/template_editor", release_note: note %>
            </div>

            <%# Freeform panel %>
            <div class="<%= 'hidden' unless is_freeform_initial %>" data-release-note-editor-target="freeformPanel">
              <div>
                <label class="<%= label_form_classes %> mb-1.5"><span>Release notes (freeform)</span></label>
                <textarea class="<%= textarea_field_classes %> font-mono text-xs"
                          rows="12"
                          data-release-note-editor-target="freeformInput"
                          data-action="input->release-note-editor#syncFromFreeform input->conversion-hints#analyze"
                          placeholder="Write your release notes..."><%= note.rendered_text %></textarea>
              </div>
            </div>

            <% if note.errors.any? %>
              <div class="<%= sn_error_classes %>">
                <div class="flex items-start gap-3">
                  <div class="<%= sn_icon_error_classes %> mt-0.5">
                    <i class="fa-solid fa-xmark text-[0.625rem]"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-base-content/90">Please fix the following errors</p>
                    <ul class="text-xs text-base-content/50 mt-1 space-y-0.5 list-disc list-inside">
                      <% note.errors.full_messages.each do |msg| %>
                        <li><%= msg %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# ── Translation locale panels ──
            One per non-base locale (listings + any orphan translations).
            Each is a tiny form posting translated_text to the per-locale endpoint.
            Live preview + char count update via locale-switcher's
            updateTranslationPreview action. %>
        <% (other_locales + orphan_translation_locales).each do |loc| %>
          <% translation = translations[loc].to_s %>
          <% has_listing = other_locales.include?(loc) %>
          <div data-locale-switcher-target="panel" data-locale="<%= loc %>" class="hidden flex-col gap-3">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <label class="<%= label_form_classes %>">
                <span>Translation for <%= loc %></span>
              </label>
              <% unless has_listing %>
                <span class="text-[0.625rem] text-base-content/40 inline-flex items-center gap-1">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  No store listing for this locale — create one before applying.
                </span>
              <% end %>
            </div>
            <%= form_with(url: update_release_translation_organization_release_path(@organization, params[:id], note_id: note.id, locale: loc),
                  method: :patch,
                  class: "flex flex-col gap-4",
                  data: {
                    locale_switcher_target: "translationForm",
                    locale: loc,
                    action: "input->locale-switcher#scheduleAutosave focusout->locale-switcher#flushOnBlur"
                  }) do %>
              <%# Structured editor — same colored NEW/IMPROVED/FIXED layout as
                  the base locale. translation-editor serializes the inputs
                  into the hidden <textarea name="translated_text"> it owns. %>
              <%= render "releases/translation_editor", note: note, loc: loc %>

              <div class="flex items-center justify-between text-[0.625rem]">
                <span class="text-base-content/40">
                  <i class="fa-regular fa-lightbulb"></i>
                  Edits autosave — switch locales freely.
                </span>
                <span data-locale-switcher-target="translationCharCount"
                      data-locale="<%= loc %>"
                      data-limit="<%= note.char_limit %>"
                      class="tabular-nums <%= translation.length > note.char_limit ? 'text-error' : 'text-base-content/40' %>">
                  <%= translation.length %>/<%= note.char_limit %>
                </span>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# Conversion hints (Android only) — applies to base-locale rendered_text %>
        <%= render "releases/conversion_hints", release_note: note %>

        <%# Delete — visible regardless of active locale %>
        <% if can_edit && (ReleaseNotePolicy.new(current_user, note).destroy? rescue false) %>
          <div class="flex justify-start pt-4 border-t border-base-content/[0.06]">
            <%= button_to destroy_release_note_organization_release_path(@organization, params[:id], note_id: note.id),
                method: :delete, class: btn_ghost_sm_classes,
                form: { class: "inline" },
                data: { turbo_confirm: "Delete this release note? This cannot be undone." } do %>
              <i class="fa-solid fa-trash"></i> Delete
            <% end %>
          </div>
        <% end %>
      </div>

      <%# ── Sticky preview sidebar ──
          One preview per locale; the locale-switcher toggles visibility. %>
      <div class="hidden xl:block xl:sticky xl:top-6 shrink-0">
        <% all_locales.each do |loc| %>
          <% is_base = loc == base_locale %>
          <div data-locale-switcher-target="previewPanel"
               data-locale="<%= loc %>"
               class="<%= 'hidden' unless is_base %>">
            <%= render "releases/whats_new_preview",
                release_note: note,
                locale: loc,
                is_base: is_base %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── AI Rewrite modal (rendered once per page, outside the form) ── %>
  <%= render "releases/ai_rewrite_modal", release_note: note %>
<% end %>
