<%#
  "Translate to all locales" button. Two states:
  - idle    (default): button_to that POSTs to translate_release_note; shows
                       remaining-translations counter; Turbo-confirm before submit.
  - pending (post-submit, turbo_stream'd by ReleasesController#translate_release_note):
            disabled pill with spinner + "Translating…" label.
  Restored to idle by the refresh broadcast fired when the translation job saves
  (ReleaseNote#broadcasts_refreshes → morph refresh).
%>
<% pending = local_assigns.fetch(:pending, false) %>
<% note = local_assigns[:release_note] || @release_note %>
<% if @entitlements&.max_ai_translations_per_month.to_i > 0 && note %>
  <div id="translate-button" class="inline-flex">
    <% if pending %>
      <button type="button" class="<%= btn_accent_sm_classes %>" disabled aria-busy="true">
        <span class="loading loading-spinner loading-xs"></span>
        Translating&hellip;
      </button>
    <% else %>
      <% remaining = @entitlements.ai_translations_remaining(@organization) %>
      <%= button_to translate_release_note_organization_release_path(@organization, params[:id], note_id: note.id),
          method: :post, class: btn_accent_sm_classes,
          form: { class: "inline" },
          disabled: remaining <= 0,
          data: { turbo_confirm: "Translate this release note to all other locales?" } do %>
        <i class="fa-solid fa-language"></i>
        Translate to all locales
        <span class="<%= count_badge_classes %> text-[0.6rem]"><%= remaining %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
