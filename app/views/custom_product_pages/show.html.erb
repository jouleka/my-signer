<%# CPP detail view with tabs %>
<% app_label = @app.name.presence || @app.bundle_id %>

<%= breadcrumbs([
  { label: "Custom Product Pages", path: organization_custom_product_pages_path(@organization) },
  { label: @cpp.name }
]) %>

<section class="flex flex-col gap-4">
  <%# Header %>
  <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
    <div class="flex items-start gap-[0.875rem]">
      <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-primary/[0.08] text-primary/60 shrink-0">
        <i class="fa-solid fa-palette text-lg"></i>
      </div>
      <div>
        <h1 class="text-2xl font-extrabold leading-tight tracking-[-0.02em] text-base-content/95"><%= @cpp.name %></h1>
        <div class="flex items-center gap-2 mt-1.5 flex-wrap">
          <span class="<%= platform_badge_classes %>">
            <i class="fa-brands fa-apple"></i> iOS
          </span>
          <span class="<%= meta_text_classes %>"><%= app_label %></span>
          <% version = @cpp.latest_version %>
          <% if version %>
            <span class="<%= cpp_state_badge_classes(version.state) %>">
              <%= version.published? ? "Published" : "Draft" %>
            </span>
          <% end %>
          <% unless @cpp.visible? %>
            <span class="<%= muted_badge_classes %>">Hidden</span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <% version = @cpp.draft_version || @cpp.latest_version %>
      <% if version&.state == "PREPARE_FOR_SUBMISSION" && @organization.app_store_connect_credentials.where(active: true).exists? %>
        <%= button_to submit_for_review_organization_custom_product_page_path(@organization, @cpp),
            method: :post,
            class: btn_primary_sm_classes,
            disabled: version.submission_status == "submitted",
            data: { turbo_confirm: "Submit this Custom Product Page for App Review?" } do %>
          <i class="fa-solid fa-paper-plane"></i> Submit for Review
        <% end %>
      <% end %>
      <%= button_to organization_custom_product_page_path(@organization, @cpp),
          method: :delete,
          class: btn_destructive_sm_classes,
          data: { turbo_confirm: "Delete this Custom Product Page? This cannot be undone." } do %>
        <i class="fa-solid fa-trash"></i> Delete
      <% end %>
    </div>
  </div>

  <%# Tab navigation %>
  <div class="<%= tab_bar_classes %>">
    <% tabs = [
      { key: "overview",     label: "Overview",     icon: "fa-solid fa-circle-info" },
      { key: "screenshots",  label: "Screenshots",  icon: "fa-solid fa-images" },
      { key: "keywords",     label: "Keywords",     icon: "fa-solid fa-key" },
      { key: "performance",  label: "Performance",  icon: "fa-solid fa-chart-line" }
    ] %>
    <% tabs.each do |t| %>
      <%= link_to organization_custom_product_page_path(@organization, @cpp, tab: t[:key]),
          class: (@tab == t[:key] ? tab_active_classes : tab_inactive_classes) do %>
        <i class="<%= t[:icon] %>"></i> <%= t[:label] %>
      <% end %>
    <% end %>
  </div>

  <%# Tab content %>
  <div>
    <% case @tab %>
    <% when "overview" %>
      <%= render "custom_product_pages/overview_tab" %>
    <% when "screenshots" %>
      <%= render "custom_product_pages/screenshots_tab" %>
    <% when "keywords" %>
      <%= render "custom_product_pages/keywords_tab" %>
    <% when "performance" %>
      <%= render "custom_product_pages/performance_tab" %>
    <% else %>
      <%= render "custom_product_pages/overview_tab" %>
    <% end %>
  </div>
</section>
