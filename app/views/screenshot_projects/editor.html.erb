                </div>
                <input type="range" min="20" max="100" value="<%= s.dig("background_image_brightness") || 100 %>"
                       class="range range-primary range-xs"
                       data-screenshot-editor-target="panoramicBrightness"
                       data-action="change->screenshot-editor#updatePreview input->screenshot-editor#updatePreview">
              </div>
            </div>

            <%# Padding %>
            <div data-screenshot-editor-target="paddingControls" class="<%= "hidden" if bg_val == "none" %>">
              <div class="flex items-center justify-between">
                <span class="text-[10px] text-base-content/50">Padding</span>
                <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="paddingLabel"><%= s.dig("screenshot_padding") || 8 %>%</span>
              </div>
              <input type="range" min="0" max="20" value="<%= s.dig("screenshot_padding") || 8 %>"
                     class="range range-primary range-xs"
                     data-screenshot-editor-target="screenshotPadding"
                     data-action="input->screenshot-editor#updatePreview">

              <div class="flex items-center justify-between mt-2">
                <span class="text-[10px] text-base-content/50">Y Offset</span>
                <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="screenshotOffsetYLabel"><%= s.dig("screenshot_offset_y") || 0 %>%</span>
              </div>
              <input type="range" min="-20" max="50" value="<%= s.dig("screenshot_offset_y") || 0 %>"
                     class="range range-primary range-xs"
                     data-screenshot-editor-target="screenshotOffsetY"
                     data-action="input->screenshot-editor#updatePreview">
            </div>

          </div>

          <%# ════════════════════════════════════════ %>
          <%# TAB 3: DEVICE FRAME                     %>
          <%# ════════════════════════════════════════ %>
          <div id="tab-frame" class="editor-tab-content space-y-3 pb-4" data-screenshot-editor-target="editorTabContent" data-tab="frame">

            <h3 class="text-xs font-semibold flex items-center gap-1.5 text-base-content/70 uppercase tracking-wide">
              <i class="fa-solid fa-mobile-screen text-[10px]"></i> Device Frame
            </h3>

            <% df_val = s.dig("device_frame") || "none"
               df_options = ScreenshotProject::DEVICE_FRAMES.reject { |k, f|
                 (@project.platform == "ios" && f[:platform] == "android") ||
                 (@project.platform == "android" && f[:platform] == "ios")
               }
               df_label = df_options[df_val]&.[](:label) || "No Frame" %>
            <details class="dropdown w-full" data-controller="custom-select">
              <input type="hidden" value="<%= df_val %>"
                     data-custom-select-target="input"
                     data-screenshot-editor-target="deviceFrame"
                     data-action="change->screenshot-editor#updatePreview input->screenshot-editor#updatePreview">
              <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-xs" data-custom-select-target="label"><%= df_label %></summary>
              <ul class="dropdown-content bg-base-200 rounded-box z-[100] w-full p-2 shadow-lg mt-1 flex flex-col gap-1 max-h-60 overflow-y-auto">
                <% df_options.each do |key, frame| %>
                  <li><a href="#" data-action="click->custom-select#select" data-value="<%= key %>" data-label="<%= frame[:label] %>" class="<%= 'active' if key == df_val %>"><%= frame[:label] %></a></li>
                <% end %>
              </ul>
            </details>

            <div class="bg-base-200/30 rounded-2xl p-3 mt-2">
              <div class="text-[10px] text-base-content/50 space-y-1">
                <p><i class="fa-solid fa-circle-info text-[9px] mr-1"></i> Device frames add a phone or tablet bezel around your screenshot.</p>
                <p>Choose "No Frame" for a clean, frameless look. The frame is automatically scaled to fit your export dimensions.</p>
              </div>
            </div>

            <%# ── 3D Perspective ── %>
            <div class="border-t border-base-200 mt-3 pt-3">
              <p class="text-[9px] text-base-content/40 leading-relaxed mb-2">
                <i class="fa-solid fa-circle-info text-[8px] mr-0.5"></i>
                Apply 3D rotation to your screenshot. Pick a preset or customize tilt, depth, shadow and reflection.
              </p>
            </div>

            <h3 class="text-xs font-semibold flex items-center gap-1.5 text-base-content/70 uppercase tracking-wide">
              <i class="fa-solid fa-cube text-[10px]"></i> 3D Perspective
            </h3>

            <input type="hidden" value="<%= s.dig("perspective_preset") || "none" %>"
                   data-screenshot-editor-target="perspectivePreset">

            <% persp_val = s.dig("perspective_preset") || "none" %>
            <div class="grid grid-cols-4 gap-1.5">
              <% ScreenshotProject::PERSPECTIVE_PRESETS.each do |key, preset| %>
                <button type="button"
                        class="perspective-preset-btn <%= 'active' if key == persp_val %>"
                        data-action="click->screenshot-editor#updatePerspectivePreset"
                        data-preset="<%= key %>"
                        data-rotate-x="<%= preset[:rotate_x] %>"
                        data-rotate-y="<%= preset[:rotate_y] %>"
                        data-distance="<%= preset[:distance] %>">
                  <div class="persp-thumb" style="transform: perspective(60px) rotateX(<%= preset[:rotate_x] * 0.6 %>deg) rotateY(<%= preset[:rotate_y] * 0.6 %>deg);"></div>
                  <span class="persp-label"><%= preset[:label] %></span>
                </button>
              <% end %>
            </div>

            <%# Custom sliders (visible when perspective is not "none") %>
            <div data-screenshot-editor-target="perspectiveControls" class="<%= 'hidden' if persp_val == 'none' %> space-y-2 mt-1">

              <%# Tilt X slider %>
              <div>
                <div class="flex justify-between items-center mb-0.5">
                  <span class="text-[10px] font-medium text-base-content/60">Tilt X</span>
                  <span class="text-[10px] tabular-nums text-base-content/50" data-screenshot-editor-target="perspectiveRotateXLabel"><%= s.dig("perspective_rotate_x") || 0 %>&deg;</span>
                </div>
                <input type="range" min="-45" max="45" step="1"
                       value="<%= s.dig("perspective_rotate_x") || 0 %>"
                       class="range range-xs range-primary"
                       data-screenshot-editor-target="perspectiveRotateX"
                       data-action="input->screenshot-editor#updatePerspective">
              </div>

              <%# Tilt Y slider %>
              <div>
                <div class="flex justify-between items-center mb-0.5">
                  <span class="text-[10px] font-medium text-base-content/60">Tilt Y</span>
                  <span class="text-[10px] tabular-nums text-base-content/50" data-screenshot-editor-target="perspectiveRotateYLabel"><%= s.dig("perspective_rotate_y") || 0 %>&deg;</span>
                </div>
                <input type="range" min="-45" max="45" step="1"
                       value="<%= s.dig("perspective_rotate_y") || 0 %>"
                       class="range range-xs range-primary"
                       data-screenshot-editor-target="perspectiveRotateY"
                       data-action="input->screenshot-editor#updatePerspective">
              </div>

              <%# Depth slider %>
              <div>
                <div class="flex justify-between items-center mb-0.5">
                  <span class="text-[10px] font-medium text-base-content/60">Depth</span>
                  <span class="text-[10px] tabular-nums text-base-content/50" data-screenshot-editor-target="perspectiveDistLabel"><%= s.dig("perspective_distance") || 2000 %></span>
                </div>
                <input type="range" min="400" max="2000" step="50"
                       value="<%= s.dig("perspective_distance") || 2000 %>"
                       class="range range-xs range-primary"
                       data-screenshot-editor-target="perspectiveDist"
                       data-action="input->screenshot-editor#updatePerspective">
              </div>

              <%# Shadow toggle %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="toggle toggle-xs toggle-primary"
                       <%= "checked" if s.dig("perspective_shadow") %>
                       data-screenshot-editor-target="perspectiveShadow"
                       data-action="change->screenshot-editor#updatePerspective">
                <span class="text-[10px] font-medium text-base-content/60">Shadow</span>
              </label>

              <%# Reflection toggle %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="toggle toggle-xs toggle-primary"
                       <%= "checked" if s.dig("perspective_reflection") %>
                       data-screenshot-editor-target="perspectiveReflection"
                       data-action="change->screenshot-editor#updatePerspective">
                <span class="text-[10px] font-medium text-base-content/60">Reflection</span>
              </label>

            </div>

          </div>

          <%# ════════════════════════════════════════ %>
          <%# TAB 4: STICKERS                         %>
          <%# ════════════════════════════════════════ %>
          <div id="tab-stickers" class="editor-tab-content space-y-3 pb-4" data-screenshot-editor-target="editorTabContent" data-tab="stickers">

            <%# Section toggle: Emoji / Library %>
            <div class="flex gap-0.5 p-0.5 bg-base-200 rounded-full">
              <button type="button"
                      class="btn btn-xs flex-1 gap-1 btn-active"
                      data-action="click->screenshot-editor#switchStickerSection"
                      data-section="emoji"
                      data-screenshot-editor-target="stickerSectionBtnEmoji">
                <i class="fa-regular fa-face-smile text-[9px]"></i>
                Emoji
              </button>
              <button type="button"
                      class="btn btn-xs flex-1 gap-1 btn-ghost"
                      data-action="click->screenshot-editor#switchStickerSection"
                      data-section="library"
                      data-screenshot-editor-target="stickerSectionBtnLibrary">
                <i class="fa-solid fa-icons text-[9px]"></i>
                Library
              </button>
              <button type="button"
                      class="btn btn-xs flex-1 gap-1 btn-ghost"
                      data-action="click->screenshot-editor#switchStickerSection"
                      data-section="images"
                      data-screenshot-editor-target="stickerSectionBtnImages">
                <i class="fa-solid fa-image text-[9px]"></i>
                Images
              </button>
              <button type="button"
                      class="btn btn-xs flex-1 gap-1 btn-ghost"
                      data-action="click->screenshot-editor#switchStickerSection"
                      data-section="text"
                      data-screenshot-editor-target="stickerSectionBtnText">
                <i class="fa-solid fa-font text-[9px]"></i>
                Text
              </button>
            </div>

            <%# Emoji Section %>
            <div data-screenshot-editor-target="stickerEmojiSection">
              <% emoji_categories = {
                "Smileys" => ScreenshotProject::POPULAR_EMOJIS[:smileys],
                "Hands" => ScreenshotProject::POPULAR_EMOJIS[:hands],
                "People" => ScreenshotProject::POPULAR_EMOJIS[:people],
                "Animals" => ScreenshotProject::POPULAR_EMOJIS[:animals],
                "Food" => ScreenshotProject::POPULAR_EMOJIS[:food],
                "Objects" => ScreenshotProject::POPULAR_EMOJIS[:objects],
                "Symbols" => ScreenshotProject::POPULAR_EMOJIS[:symbols],
                "Flags" => ScreenshotProject::POPULAR_EMOJIS[:flags]
              } %>

              <div role="tablist" class="tabs tabs-xs tabs-boxed bg-base-200/50 gap-0">
                <% emoji_categories.each_with_index do |(cat_name, _emojis), idx| %>
                  <input type="radio" name="sticker_tabs" role="tab" class="tab text-[10px] !px-1.5"
                         aria-label="<%= cat_name %>" <%= 'checked' if idx == 0 %>>
                  <div role="tabpanel" class="tab-content pt-2">
                    <div class="grid grid-cols-8 gap-0.5">
                      <% emoji_categories[cat_name].each do |emoji| %>
                        <button type="button"
                                class="btn btn-ghost btn-xs text-base leading-none p-0 h-7 min-h-0"
                                data-action="click->screenshot-editor#addSticker"
                                data-emoji="<%= emoji %>"><%= emoji %></button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <%# Library Section %>
            <div class="hidden" data-screenshot-editor-target="stickerLibrarySection">
              <div class="space-y-2">
                <input type="text" placeholder="Search all stickers..."
                       class="input input-xs input-bordered w-full"
                       data-screenshot-editor-target="stickerLibrarySearch"
                       data-action="input->screenshot-editor#filterLibraryStickers">

                <div class="max-h-64 overflow-y-auto space-y-1 pr-0.5">
                  <% library = ScreenshotProject::STICKER_LIBRARY %>
                  <% library.each do |cat_key, cat_data| %>
                    <details class="group sticker-lib-category" open>
                      <summary class="flex items-center justify-between cursor-pointer py-1.5 px-1 rounded-2xl hover:bg-base-200/50 sticky top-0 bg-base-100 z-[1]">
                        <span class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wide flex items-center gap-1.5">
                          <i class="<%= cat_data[:icon] %> text-[9px]"></i>
                          <%= cat_data[:label] %>
                          <span class="badge badge-ghost badge-xs font-normal normal-case"><%= cat_data[:items].size %></span>
                        </span>
                        <i class="fa-solid fa-chevron-down text-[7px] text-base-content/30 transition-transform group-open:rotate-180"></i>
                      </summary>
                      <% if cat_key == :badges %>
                        <div class="grid grid-cols-2 gap-1.5 pt-1 pb-2">
                          <% cat_data[:items].each do |item| %>
                            <button type="button"
                                    class="sticker-lib-item btn btn-ghost btn-xs px-2 h-10 min-h-0 w-full flex items-center justify-start gap-1"
                                    title="<%= item[:label] %>"
                                    data-action="click->screenshot-editor#addLibrarySticker"
                                    data-asset-key="<%= item[:key] %>"
                                    data-image-url="<%= image_path(item[:file]) %>"
                                    data-tags="<%= item[:tags] %>"
                                    data-category="<%= cat_key %>">
                              <img src="<%= image_path(item[:file]) %>" loading="lazy"
                                   class="h-5 w-auto [filter:invert(0.85)]"
                                   alt="<%= item[:label] %>">
                              <span class="text-[9px] truncate text-base-content/50"><%= item[:label] %></span>
                            </button>
                          <% end %>
                        </div>
                      <% else %>
                        <div class="grid grid-cols-5 gap-1 pt-1 pb-2">
                          <% cat_data[:items].each do |item| %>
                            <button type="button"
                                    class="sticker-lib-item btn btn-ghost btn-xs p-0.5 h-8 min-h-0 flex items-center justify-center"
                                    title="<%= item[:label] %>"
                                    data-action="click->screenshot-editor#addLibrarySticker"
                                    data-asset-key="<%= item[:key] %>"
                                    data-image-url="<%= image_path(item[:file]) %>"
                                    data-tags="<%= item[:tags] %>"
                                    data-category="<%= cat_key %>">
                              <img src="<%= image_path(item[:file]) %>" loading="lazy"
                                   class="w-5 h-5 [filter:invert(0.85)]"
                                   alt="<%= item[:label] %>">
                            </button>
                          <% end %>
                        </div>
                      <% end %>
                    </details>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Images Section (custom uploads) %>
            <div class="hidden" data-screenshot-editor-target="stickerImagesSection">
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <label class="btn btn-xs btn-outline gap-1 flex-1 cursor-pointer">
                    <i class="fa-solid fa-upload text-[9px]"></i>
                    Upload Image
                    <input type="file"
                           accept="image/png,image/jpeg,image/webp"
                           class="hidden"
                           data-screenshot-editor-target="customImageUpload"
                           data-action="change->screenshot-editor#uploadCustomStickerImage">
                  </label>
                </div>
                <p class="text-[10px] text-base-content/40">PNG, JPEG, or WebP. Max 5 MB per image.</p>
                <div class="grid grid-cols-3 gap-2" data-screenshot-editor-target="customImageGallery">
                  <% if @project.custom_sticker_images.any? %>
                    <% @project.custom_sticker_images.each do |attachment| %>
                      <div class="relative group">
                        <button type="button"
                                class="w-full aspect-square rounded-lg border border-base-200 hover:border-primary/50 overflow-hidden flex items-center justify-center bg-base-200/30 transition-all"
                                data-action="click->screenshot-editor#addCustomImageSticker"
                                data-image-url="<%= "#{organization_screenshot_project_path(@organization, @project)}/custom_sticker_images/#{attachment.id}" %>"
                                data-attachment-id="<%= attachment.id %>"
                                data-signed-id="<%= attachment.blob.signed_id %>"
                                title="<%= attachment.blob.filename %>">
                          <img src="<%= "#{organization_screenshot_project_path(@organization, @project)}/custom_sticker_images/#{attachment.id}" %>"
                               class="max-w-full max-h-full object-contain"
                               alt="<%= attachment.blob.filename %>"
                               loading="lazy">
                        </button>
                        <button type="button"
                                class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-error text-error-content flex items-center justify-center text-[10px] opacity-0 group-hover:opacity-100 transition-opacity shadow-sm"
                                data-action="click->screenshot-editor#deleteCustomStickerImage"
                                data-signed-id="<%= attachment.blob.signed_id %>"
                                data-attachment-id="<%= attachment.id %>"
                                title="Delete image">
                          <i class="fa-solid fa-xmark"></i>
                        </button>
                      </div>
                    <% end %>
                  <% else %>
                    <p class="text-xs text-base-content/40 text-center py-3 col-span-3">No images uploaded yet</p>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Text Section %>
            <div class="hidden" data-screenshot-editor-target="stickerTextSection">
              <div class="space-y-2">
                <p class="text-[10px] text-base-content/50">Add a text label, badge, or callout overlay.</p>

                <div class="flex gap-1.5">
                  <input type="text" placeholder="Enter text..."
                         class="input input-xs input-bordered flex-1"
                         data-screenshot-editor-target="newTextStickerInput">
                  <button type="button"
                          class="btn btn-xs btn-primary gap-1"
                          data-action="click->screenshot-editor#addTextSticker">
                    <i class="fa-solid fa-plus text-[9px]"></i> Add
                  </button>
                </div>

                <div class="grid grid-cols-3 gap-1">
                  <% [ ["Label", "700", "rgba(99,102,241,0.85)"],
                       ["Badge", "800", "rgba(239,68,68,0.85)"],
                       ["Note", "600", "rgba(234,179,8,0.9)"],
                       ["NEW", "800", "rgba(16,185,129,0.85)"],
                       ["Beta", "700", "rgba(139,92,246,0.85)"],
                       ["Tip", "700", "rgba(59,130,246,0.85)"]
                  ].each do |text, weight, bg| %>
                    <button type="button"
                            class="btn btn-xs btn-ghost border border-base-200 text-[10px]"
                            data-action="click->screenshot-editor#addTextSticker"
                            data-text="<%= text %>"
                            data-font-weight="<%= weight %>"
                            data-bg-color="<%= bg %>">
                      <%= text %>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Selected sticker controls %>
            <div class="hidden space-y-1.5 pt-1 border-t border-base-200"
                 data-screenshot-editor-target="stickerControls">
              <div class="flex items-center gap-2">
                <label class="text-[10px] text-base-content/60 w-10">Size</label>
                <input type="range" min="24" max="400" value="64" step="1"
                       class="range range-xs range-primary flex-1"
                       data-screenshot-editor-target="stickerSize"
                       data-action="input->screenshot-editor#updateStickerSize">
                <span class="text-[10px] text-base-content/50 w-10 text-right"
                      data-screenshot-editor-target="stickerSizeLabel">64px</span>
              </div>

              <div class="hidden flex items-center gap-2"
                   data-screenshot-editor-target="stickerColorControls">
                <label class="text-[10px] text-base-content/60 w-10">Color</label>
                <input type="color" value="#FFFFFF"
                       class="w-6 h-6 rounded-lg cursor-pointer border border-base-300"
                       data-screenshot-editor-target="stickerColor"
                       data-action="input->screenshot-editor#updateStickerColor">
                <input type="text" value="#FFFFFF" maxlength="7"
                       class="input input-xs input-bordered flex-1 font-mono text-[10px]"
                       data-screenshot-editor-target="stickerColorText"
                       data-action="change->screenshot-editor#updateStickerColorFromText">
              </div>

              <div class="hidden flex items-center gap-2"
                   data-screenshot-editor-target="stickerTextControls">
                <label class="text-[10px] text-base-content/60 w-10">Text</label>
                <input type="text" value="" placeholder="Type here..."
                       class="input input-xs input-bordered flex-1"
                       data-screenshot-editor-target="stickerText"
                       data-action="input->screenshot-editor#updateStickerText">
              </div>

              <div class="hidden flex items-center gap-2"
                   data-screenshot-editor-target="stickerBgColorControls">
                <label class="text-[10px] text-base-content/60 w-10">Bg</label>
                <input type="color" value="#000000"
                       class="w-6 h-6 rounded-lg cursor-pointer border border-base-300"
                       data-screenshot-editor-target="stickerBgColor"
                       data-action="input->screenshot-editor#updateStickerBgColor">
                <label class="flex items-center gap-1 text-[10px] text-base-content/60 cursor-pointer ml-auto">
                  <input type="checkbox" checked
                         class="checkbox checkbox-xs checkbox-primary"
                         data-screenshot-editor-target="stickerBgEnabled"
                         data-action="change->screenshot-editor#updateStickerBgEnabled">
                  Show
                </label>
              </div>

              <button type="button"
                      class="btn btn-error btn-xs btn-outline w-full gap-1"
                      data-action="click->screenshot-editor#deleteSelectedSticker">
                <i class="fa-solid fa-trash-can text-[10px]"></i> Delete Sticker
              </button>
            </div>

          </div>

        </div><%# end panel scroll %>

        <%# ── Pinned Save + Export Bar ── %>
    <% if @scenes.any? %>
      <div class="border-t border-base-200 p-3 flex gap-2">
        <button type="button"
                class="btn btn-primary btn-sm flex-1 gap-1.5 px-3 text-xs"
                data-action="click->screenshot-editor#saveCurrentScene"
                    data-screenshot-editor-target="saveButton">
              <i class="fa-solid fa-floppy-disk text-[10px]" data-screenshot-editor-target="saveIcon"></i>
              <span data-screenshot-editor-target="saveLabel">Save</span>
            </button>
        <button class="btn btn-sm gap-2 btn-outline" data-action="click->screenshot-export#openModal">
          <i class="fa-solid fa-download text-[10px]"></i>
          Export
        </button>
        <button class="btn btn-sm btn-accent gap-2"
                data-action="click->screenshot-store-upload#openModal"
                title="Upload to Store">
          <i class="fa-solid fa-cloud-arrow-up text-[10px]"></i>
          <span class="hidden sm:inline">Upload</span>
        </button>
      </div>
    <% end %>

      </div><%# end settings card %>
    </div><%# end settings column %>

  </div><%# end main grid %>

  <%# ══════════════════════════════════════════ %>
  <%# Modals & Hidden Data (unchanged) %>
  <%# ══════════════════════════════════════════ %>

  <%# Export Modal %>
  <%= render "export_modal", project: @project %>

  <%# Store Upload Modal %>
  <%= render "store_upload_modal",
             project: @project,
             apple_apps: @apple_apps,
             android_apps: @android_apps,
             editable_versions: @editable_versions,
             has_asc_credentials: @has_asc_credentials,
             has_gp_credentials: @has_gp_credentials,
             custom_product_pages: @custom_product_pages || [] %>

  <%# Delete Scene Confirmation Dialog %>
  <dialog id="delete_scene_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-error/10 flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-trash text-error text-lg"></i>
        </div>
        <div class="space-y-2">
          <h3 class="text-lg font-bold">Delete scene?</h3>
          <p class="text-sm text-base-content/70">
            Are you sure you want to delete <span id="delete_scene_name" class="font-semibold"></span>?
            This action cannot be undone.
          </p>
        </div>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Cancel</button>
        </form>
        <form id="delete_scene_form" method="post">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit" class="btn btn-error gap-2">
            <i class="fa-solid fa-trash"></i>
            Delete
          </button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <%# Hidden data for scenes %>
  <% @scenes.each do |scene| %>
    <div class="hidden"
         data-screenshot-editor-target="sceneData"
         data-scene-id="<%= scene.id %>"
         data-scene-caption="<%= scene.caption_text %>"
         data-scene-subtitle="<%= scene.subtitle_text %>"
         data-scene-overrides="<%= (scene.overrides || {}).to_json %>"
         data-scene-locale-variants="<%= (scene.locale_variants || {}).to_json %>"
         data-scene-image-url="<%= image_organization_screenshot_project_screenshot_scene_path(@organization, @project, scene) %>"
         data-scene-update-url="<%= organization_screenshot_project_screenshot_scene_path(@organization, @project, scene) %>"
         data-scene-position="<%= scene.position %>">
    </div>
  <% end %>

  <%# Bulk Edit Modal %>
  <dialog id="bulk_edit_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-5xl p-0">
      <div class="flex items-center justify-between px-5 pt-5 pb-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center">
            <i class="fa-solid fa-table-cells-large text-primary text-sm"></i>
          </div>
          <div>
            <h3 class="text-base font-bold leading-tight">Bulk Edit Captions</h3>
            <p class="text-xs text-base-content/50 mt-0.5">Click any cell to edit. Press Enter to move down, Tab to move right.</p>
          </div>
        </div>
        <form method="dialog">
          <button class="btn btn-ghost btn-sm btn-circle">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </form>
      </div>
      <div class="overflow-x-auto max-h-[26rem] border-y border-base-200">
        <table class="w-full border-collapse [&_th]:border-b [&_th]:border-base-200 [&_td]:border-b [&_td]:border-base-200/50"
               data-screenshot-bulk-edit-target="bulkTable">
          <thead class="sticky top-0 z-10 bg-base-200/80 backdrop-blur-sm">
            <tr data-screenshot-bulk-edit-target="tableHead"></tr>
          </thead>
          <tbody data-screenshot-bulk-edit-target="tableBody"></tbody>
        </table>
      </div>
      <div class="flex items-center justify-between px-5 py-3">
        <span class="text-xs text-base-content/40" data-screenshot-bulk-edit-target="cellCount"></span>
        <div class="flex items-center gap-2">
          <form method="dialog">
            <button class="btn btn-ghost btn-sm">Cancel</button>
          </form>
          <button class="btn btn-primary btn-sm gap-2" data-action="click->screenshot-bulk-edit#saveBulk">
            <i class="fa-solid fa-floppy-disk text-xs"></i>
            Save All
          </button>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <%# Keyboard Shortcuts Help Dialog %>
  <dialog id="shortcuts_help_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-base-200 flex items-center justify-center">
          <i class="fa-solid fa-keyboard text-base-content/70"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold">Keyboard Shortcuts</h3>
          <p class="text-sm text-base-content/60">Quick actions for the editor</p>
        </div>
      </div>
      <div class="space-y-2 text-sm">
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Save Scene</span>
          <div class="flex gap-1"><kbd class="kbd kbd-sm">Ctrl</kbd><kbd class="kbd kbd-sm">S</kbd></div>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Save All Scenes</span>
          <div class="flex gap-1"><kbd class="kbd kbd-sm">Ctrl</kbd><kbd class="kbd kbd-sm">Shift</kbd><kbd class="kbd kbd-sm">S</kbd></div>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Undo</span>
          <div class="flex gap-1"><kbd class="kbd kbd-sm">Ctrl</kbd><kbd class="kbd kbd-sm">Z</kbd></div>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Redo</span>
          <div class="flex gap-1"><kbd class="kbd kbd-sm">Ctrl</kbd><kbd class="kbd kbd-sm">Shift</kbd><kbd class="kbd kbd-sm">Z</kbd></div>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Export</span>
          <div class="flex gap-1"><kbd class="kbd kbd-sm">Ctrl</kbd><kbd class="kbd kbd-sm">E</kbd></div>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Previous Scene</span>
          <kbd class="kbd kbd-sm">&larr;</kbd>
        </div>
        <div class="flex items-center justify-between py-1.5 border-b border-base-200">
          <span>Next Scene</span>
          <kbd class="kbd kbd-sm">&rarr;</kbd>
        </div>
        <div class="flex items-center justify-between py-1.5">
          <span>Show Shortcuts</span>
          <kbd class="kbd kbd-sm">?</kbd>
        </div>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost btn-sm">Close</button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <%# Copy Scene Modal %>
  <% other_projects = @organization.screenshot_projects.where.not(id: @project.id).order(:name) %>
  <% if other_projects.any? %>
    <dialog id="copy_scene_modal" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <i class="fa-solid fa-copy text-primary"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold">Copy Scene to Project</h3>
            <p class="text-sm text-base-content/60">Duplicate this scene into another project</p>
          </div>
        </div>
        <form id="copy_scene_form" method="post"
              data-base-url="<%= copy_organization_screenshot_project_screenshot_scene_path(@organization, @project, "__SCENE_ID__") %>">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <div class="form-control w-full mb-4">
            <label class="label"><span class="label-text font-medium">Target Project</span></label>
            <select name="target_project_id" class="select select-bordered w-full" required>
              <% other_projects.each do |p| %>
                <option value="<%= p.id %>"><%= p.name %> (<%= p.scenes_count %> scenes)</option>
              <% end %>
            </select>
          </div>
          <div class="modal-action">
            <button type="button"
                    class="btn btn-ghost"
                    data-action="click->screenshot-editor#closeCopySceneModal">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary gap-2">
              <i class="fa-solid fa-copy"></i>
              Copy
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
  <% end %>
</section>
