              </div>
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] text-base-content/50">Brightness</span>
                  <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="backgroundImageBrightnessLabel"><%= s.dig("background_image_brightness") || 100 %>%</span>
                </div>
                <input type="range" min="20" max="100" value="<%= s.dig("background_image_brightness") || 100 %>"
                       class="range range-primary range-xs"
                       data-screenshot-editor-target="backgroundImageBrightness"
                       data-action="input->screenshot-editor#updatePreview">
              </div>
