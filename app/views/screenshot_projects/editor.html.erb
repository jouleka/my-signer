                </div>
              </div>
            </details>

          </div>

          <%# ════════════════════════════════════════ %>
          <%# TAB 2: STYLE (Background + Padding)      %>
          <%# ════════════════════════════════════════ %>
          <div id="tab-style" class="editor-tab-content space-y-3 pb-4" data-screenshot-editor-target="editorTabContent" data-tab="style">

            <%# Background %>
            <h3 class="text-xs font-semibold flex items-center gap-1.5 text-base-content/70 uppercase tracking-wide">
              <i class="fa-solid fa-fill-drip text-[10px]"></i> Background
            </h3>

            <% bg_val = s.dig("background_type").presence || "solid"
               bg_types = [
                 { key: "none", label: "None", icon: "fa-solid fa-ban", icon_style: "color: oklch(var(--bc) / 0.3)", bg_style: "" },
                 { key: "solid", label: "Solid", icon: nil, icon_style: nil, bg_style: "background: #{s.dig('background_color') || '#000000'}" },
                 { key: "gradient", label: "Gradient", icon: nil, icon_style: nil, bg_style: "background: linear-gradient(135deg, #{s.dig('gradient_start') || '#000000'}, #{s.dig('gradient_end') || '#764BA2'})" },
                 { key: "mesh", label: "Mesh", icon: nil, icon_style: nil, bg_style: "background: radial-gradient(circle at 30% 30%, #FF6B35, transparent 70%), radial-gradient(circle at 70% 50%, #F7931E, transparent 60%), #1a0533" },
                 { key: "pattern", label: "Pattern", icon: nil, icon_style: nil, bg_style: "background: repeating-conic-gradient(rgba(255,255,255,0.35) 0% 25%, transparent 0% 50%) 0 0 / 8px 8px; background-color: #1a1a2e" },
                 { key: "image", label: "Image", icon: "fa-solid fa-image", icon_style: "color: oklch(var(--bc) / 0.4); font-size: 12px", bg_style: "background: oklch(var(--b2))" },
                 { key: "panoramic", label: "Panoramic", icon: "fa-solid fa-panorama", icon_style: "color: oklch(var(--bc) / 0.4); font-size: 11px", bg_style: "background: linear-gradient(90deg, #E67E22 0%, #3498DB 33%, #2ECC71 66%, #9B59B6 100%)" }
               ] %>
            <input type="hidden" value="<%= bg_val %>"
                   data-screenshot-editor-target="backgroundType">
            <div class="grid grid-cols-4 gap-1.5">
              <% bg_types.each do |bt| %>
                <button type="button"
                        class="bg-type-btn <%= 'active' if bt[:key] == bg_val %>"
                        data-action="click->screenshot-editor#selectBgType"
                        data-bg-type="<%= bt[:key] %>">
                  <div class="bg-type-icon" style="<%= bt[:bg_style] %>">
                    <% if bt[:icon] %>
                      <i class="<%= bt[:icon] %>" style="<%= bt[:icon_style] %>"></i>
                    <% end %>
                  </div>
                  <span class="bg-type-label"><%= bt[:label] %></span>
                </button>
              <% end %>
            </div>

            <%# Contextual hint for panoramic %>
            <div data-screenshot-editor-target="panoramicHint" class="bg-type-hint rounded-xl bg-info/10 border border-info/20 px-3 py-2 <%= 'hidden' unless bg_val == 'panoramic' %>">
              <p class="text-[10px] text-info leading-relaxed">
                <i class="fa-solid fa-circle-info mr-1"></i>
                Upload one wide image &mdash; each scene displays a different slice, creating a continuous flow across your screenshots.
              </p>
            </div>

            <%# Solid color picker (shown for solid type) %>
            <div data-screenshot-editor-target="solidControls" class="<%= "hidden" unless bg_val == "solid" %>">
              <div class="flex items-center gap-1">
                <input type="color" value="<%= s.dig("background_color") || "#000000" %>"
                       class="w-7 h-7 rounded-lg border border-base-200 cursor-pointer shrink-0"
                       aria-label="Background color"
                       data-screenshot-editor-target="backgroundColor"
                       data-action="input->screenshot-editor#updatePreview">
                <input type="text" value="<%= s.dig("background_color") || "#000000" %>"
                       class="input input-bordered input-xs flex-1 font-mono text-[10px] min-w-0"
                       aria-label="Background color hex value"
                       data-screenshot-editor-target="backgroundColorText"
                       data-action="input->screenshot-editor#syncBackgroundColor">
                <% if brand["background_color"].present? %>
                  <button type="button" class="w-5 h-5 rounded-full border border-base-300 shrink-0 cursor-pointer" style="background: <%= brand['background_color'] %>" title="Brand background color"
                          data-action="click->screenshot-editor#applyBrandColor" data-color="<%= brand['background_color'] %>" data-target-input="backgroundColor"></button>
                <% end %>
              </div>
            </div>

            <%# Gradient controls %>
            <div data-screenshot-editor-target="gradientControls" class="<%= "hidden" unless bg_val == "gradient" %>">
              <div class="grid grid-cols-3 gap-1.5">
                <div>
                  <span class="text-[10px] text-base-content/50">Start</span>
                  <input type="color" value="<%= s.dig("gradient_start") || "#000000" %>"
                         class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                         data-screenshot-editor-target="gradientStart"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
                <div>
                  <span class="text-[10px] text-base-content/50">End</span>
                  <input type="color" value="<%= s.dig("gradient_end") || "#764BA2" %>"
                         class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                         data-screenshot-editor-target="gradientEnd"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
                <div>
                  <span class="text-[10px] text-base-content/50">Direction</span>
                  <% gd_val = s.dig("gradient_direction") == "to-right" ? "to-right" : "to-bottom" %>
                  <details class="dropdown w-full" data-controller="custom-select">
                    <input type="hidden" value="<%= gd_val %>"
                           data-custom-select-target="input"
                           data-screenshot-editor-target="gradientDirection"
                           data-action="change->screenshot-editor#updatePreview input->screenshot-editor#updatePreview">
                    <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-[10px]" data-custom-select-target="label"><%= gd_val == "to-right" ? "L-R" : "T-B" %></summary>
                    <ul class="dropdown-content bg-base-200 rounded-box z-[100] w-36 p-2 shadow-lg mt-1 flex flex-col gap-1">
                      <li><a href="#" data-action="click->custom-select#select" data-value="to-bottom" data-label="T-B" class="<%= 'active' if gd_val == 'to-bottom' %>">Top to Bottom</a></li>
                      <li><a href="#" data-action="click->custom-select#select" data-value="to-right" data-label="L-R" class="<%= 'active' if gd_val == 'to-right' %>">Left to Right</a></li>
                    </ul>
                  </details>
                </div>
              </div>
            </div>

            <%# Mesh Gradient controls %>
            <% mesh_preset_val = s.dig("mesh_preset") || "sunset" %>
            <div data-screenshot-editor-target="meshControls" class="<%= "hidden" unless bg_val == "mesh" %> space-y-2">
              <input type="hidden" value="<%= mesh_preset_val %>" data-screenshot-editor-target="meshPreset">
              <span class="text-[10px] text-base-content/50">Preset</span>
              <div class="grid grid-cols-4 gap-1.5" data-mesh-grid>
                <% mesh_presets = {
                  "sunset" => { base: "#1a0533", c1: "#FF6B35", c2: "#F7931E", c3: "#D4145A" },
                  "ocean" => { base: "#0a1628", c1: "#0077B6", c2: "#00B4D8", c3: "#023E8A" },
                  "aurora" => { base: "#0B0B1A", c1: "#00C9A7", c2: "#845EC2", c3: "#00B8A9" },
                  "lavender" => { base: "#1A1025", c1: "#9B59B6", c2: "#8E44AD", c3: "#D4A5FF" },
                  "coral" => { base: "#1A0A0A", c1: "#FF6F61", c2: "#FF9671", c3: "#FFC75F" },
                  "forest" => { base: "#0A1A0A", c1: "#2D6A4F", c2: "#40916C", c3: "#52B788" },
                  "candy" => { base: "#1A0820", c1: "#FF6B9D", c2: "#C44DFF", c3: "#FF85A1" },
                  "midnight" => { base: "#050510", c1: "#1A1A4E", c2: "#2D2D7F", c3: "#4040B0" },
                  "neon" => { base: "#0A0A0A", c1: "#00FF87", c2: "#FF00E5", c3: "#00D4FF" },
                  "peach" => { base: "#1A1008", c1: "#FFBE76", c2: "#FF9F43", c3: "#FECA57" },
                  "arctic" => { base: "#0A1520", c1: "#74B9FF", c2: "#A29BFE", c3: "#81ECEC" },
                  "ember" => { base: "#1A0800", c1: "#E74C3C", c2: "#E67E22", c3: "#C0392B" }
                } %>
                <% mesh_presets.each do |key, colors| %>
                  <button type="button"
                          class="w-full aspect-square rounded-xl border border-base-200 cursor-pointer transition-all hover:scale-105 <%= 'ring-2 ring-primary' if key == mesh_preset_val %>"
                          style="background: radial-gradient(circle at 30% 30%, <%= colors[:c1] %>, transparent 70%), radial-gradient(circle at 70% 50%, <%= colors[:c2] %>, transparent 70%), radial-gradient(circle at 50% 80%, <%= colors[:c3] %>, transparent 70%), <%= colors[:base] %>"
                          data-action="click->screenshot-editor#selectMeshPreset"
                          data-preset="<%= key %>"
                          title="<%= key.titleize %>">
                  </button>
                <% end %>
              </div>
              <div class="grid grid-cols-3 gap-1.5 pt-1">
                <div>
                  <span class="text-[10px] text-base-content/50">Color 1</span>
                  <input type="color" value="<%= s.dig("mesh_color_1").presence || mesh_presets.dig(mesh_preset_val, :c1) || "#FF6B35" %>"
                         class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                         data-screenshot-editor-target="meshColor1"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
                <div>
                  <span class="text-[10px] text-base-content/50">Color 2</span>
                  <input type="color" value="<%= s.dig("mesh_color_2").presence || mesh_presets.dig(mesh_preset_val, :c2) || "#F7931E" %>"
                         class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                         data-screenshot-editor-target="meshColor2"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
                <div>
                  <span class="text-[10px] text-base-content/50">Color 3</span>
                  <input type="color" value="<%= s.dig("mesh_color_3").presence || mesh_presets.dig(mesh_preset_val, :c3) || "#D4145A" %>"
                         class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                         data-screenshot-editor-target="meshColor3"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
              </div>
            </div>

            <%# Pattern controls %>
            <% pattern_id_val = s.dig("pattern_id") || "dots" %>
            <div data-screenshot-editor-target="patternControls" class="<%= "hidden" unless bg_val == "pattern" %> space-y-2">
              <input type="hidden" value="<%= pattern_id_val %>" data-screenshot-editor-target="patternId">
              <span class="text-[10px] text-base-content/50">Pattern</span>
              <div class="grid grid-cols-5 gap-1.5" data-pattern-grid>
                <% ScreenshotProject::PATTERN_LIBRARY[:tiles].each do |tile| %>
                  <button type="button"
                          class="w-full aspect-square rounded-lg border border-base-200 cursor-pointer transition-all hover:scale-105 flex items-center justify-center bg-base-200/30 <%= 'ring-2 ring-primary' if tile[:id] == pattern_id_val %>"
                          data-action="click->screenshot-editor#selectPattern"
                          data-pattern-id="<%= tile[:id] %>"
                          title="<%= tile[:label] %>">
                    <img src="<%= image_path(tile[:file]) %>" class="w-5 h-5 opacity-60 pattern-tile-preview" alt="<%= tile[:label] %>">
                  </button>
                <% end %>
                <% ScreenshotProject::PATTERN_LIBRARY[:procedural].each do |proc_pattern| %>
                  <button type="button"
                          class="w-full aspect-square rounded-lg border border-base-200 cursor-pointer transition-all hover:scale-105 flex items-center justify-center text-[8px] font-medium text-base-content/50 bg-base-200/30 <%= 'ring-2 ring-primary' if proc_pattern[:id] == pattern_id_val %>"
                          data-action="click->screenshot-editor#selectPattern"
                          data-pattern-id="<%= proc_pattern[:id] %>"
                          title="<%= proc_pattern[:label] %>">
                    <%= proc_pattern[:label] %>
                  </button>
                <% end %>
              </div>
              <div class="grid grid-cols-2 gap-1.5 pt-1">
                <div>
                  <span class="text-[10px] text-base-content/50">Pattern Color</span>
                  <div class="flex items-center gap-1">
                    <input type="color" value="<%= s.dig("pattern_color") || "#FFFFFF" %>"
                           class="w-7 h-7 rounded-lg border border-base-200 cursor-pointer shrink-0"
                           aria-label="Pattern color"
                           data-screenshot-editor-target="patternColor"
                           data-action="input->screenshot-editor#updatePreview">
                    <input type="text" value="<%= s.dig("pattern_color") || "#FFFFFF" %>"
                           class="input input-bordered input-xs flex-1 font-mono text-[10px] min-w-0"
                           aria-label="Pattern color hex value"
                           data-screenshot-editor-target="patternColorText"
                           data-action="input->screenshot-editor#syncPatternColor">
                  </div>
                </div>
                <div>
                  <span class="text-[10px] text-base-content/50">Bg Color</span>
                  <div class="flex items-center gap-1">
                    <input type="color" value="<%= s.dig("pattern_bg_color") || "#000000" %>"
                           class="w-7 h-7 rounded-lg border border-base-200 cursor-pointer shrink-0"
                           aria-label="Pattern background color"
                           data-screenshot-editor-target="patternBgColor"
                           data-action="input->screenshot-editor#updatePreview">
                    <input type="text" value="<%= s.dig("pattern_bg_color") || "#000000" %>"
                           class="input input-bordered input-xs flex-1 font-mono text-[10px] min-w-0"
                           aria-label="Pattern background color hex value"
                           data-screenshot-editor-target="patternBgColorText"
                           data-action="input->screenshot-editor#syncPatternBgColor">
                  </div>
                </div>
              </div>
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] text-base-content/50">Scale</span>
                  <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="patternScaleLabel"><%= s.dig("pattern_scale") || 100 %>%</span>
                </div>
                <input type="range" min="50" max="200" value="<%= s.dig("pattern_scale") || 100 %>"
                       class="range range-primary range-xs"
                       data-screenshot-editor-target="patternScale"
                       data-action="input->screenshot-editor#updatePreview">
              </div>
            </div>

            <%# Background Image controls %>
            <div data-screenshot-editor-target="imageControls" class="<%= "hidden" unless bg_val == "image" %> space-y-2">
              <div class="flex items-center gap-2">
                <label class="btn btn-xs btn-outline gap-1 flex-1 cursor-pointer">
                  <i class="fa-solid fa-cloud-arrow-up text-[10px]"></i>
                  <span>Upload Image</span>
                  <input type="file" class="hidden" accept="image/png,image/jpeg,image/webp"
                         data-action="change->screenshot-editor#uploadBackgroundImage">
                </label>
                <button type="button"
                        class="btn btn-xs btn-ghost btn-error gap-1 <%= 'hidden' unless @project.background_image.attached? %>"
                        data-screenshot-editor-target="backgroundImageRemoveBtn"
                        data-action="click->screenshot-editor#removeBackgroundImage">
                  <i class="fa-solid fa-trash text-[10px]"></i>
                  Remove
                </button>
              </div>
              <% if @project.background_image.attached? %>
                <img src="<%= "#{organization_screenshot_project_path(@organization, @project)}/background_image_file" %>"
                     class="w-full h-16 object-cover rounded-lg border border-base-200"
                     data-screenshot-editor-target="backgroundImagePreview"
                     alt="Background preview">
              <% else %>
                <img src="" class="w-full h-16 object-cover rounded-lg border border-base-200 hidden"
                     data-screenshot-editor-target="backgroundImagePreview"
                     alt="Background preview">
              <% end %>
              <div>
                <span class="text-[10px] text-base-content/50">Fit Mode</span>
                <% fit_val = s.dig("background_image_fit") || "cover" %>
                <details class="dropdown w-full" data-controller="custom-select">
                  <input type="hidden" value="<%= fit_val %>"
                         data-custom-select-target="input"
                         data-screenshot-editor-target="backgroundImageFit"
                         data-action="change->screenshot-editor#updatePreview input->screenshot-editor#updatePreview">
                  <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-xs" data-custom-select-target="label"><%= fit_val == "contain" ? "Contain" : "Cover" %></summary>
                  <ul class="dropdown-content bg-base-200 rounded-box z-[100] w-full p-2 shadow-lg mt-1 flex flex-col gap-1">
                    <li><a href="#" data-action="click->custom-select#select" data-value="cover" data-label="Cover" class="<%= 'active' if fit_val == 'cover' %>">Cover</a></li>
                    <li><a href="#" data-action="click->custom-select#select" data-value="contain" data-label="Contain" class="<%= 'active' if fit_val == 'contain' %>">Contain</a></li>
                  </ul>
                </details>
              </div>
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] text-base-content/50">Blur</span>
                  <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="backgroundImageBlurLabel"><%= s.dig("background_image_blur") || 0 %>px</span>
