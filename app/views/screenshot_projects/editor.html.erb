<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# Preload only active font+weight pairs; additional weights load on-demand via font_loader.js %>
  <% _settings = @project.settings || {} %>
  <% font_pairs = [
       [_settings.dig("caption_font_family") || "Inter", (_settings.dig("caption_font_weight") || 700).to_i],
       [_settings.dig("subtitle_font_family") || "Inter", (_settings.dig("subtitle_font_weight") || 400).to_i]
     ] %>
  <% allowed_weights = [300, 400, 500, 600, 700, 800, 900] %>
  <% family_weights = {} %>
  <% font_pairs.each do |family, weight| %>
    <% normalized = allowed_weights.include?(weight) ? weight : 400 %>
    <% family_weights[family] ||= [] %>
    <% family_weights[family] << normalized %>
  <% end %>
  <% family_weights.each do |family, weights| %>
    <% encoded_family = ERB::Util.url_encode(family).gsub("%20", "+") %>
    <% encoded_weights = weights.uniq.sort.join(";") %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=<%= encoded_family %>:wght@<%= encoded_weights %>&display=swap">
  <% end %>
  <style>
    /* Editor panel tab system */
    .editor-tab-btn { transition: all 0.15s ease; }
    .editor-tab-btn.active { background: oklch(var(--p) / 0.12); color: oklch(var(--p)); }
    .editor-tab-btn:not(.active):hover { background: oklch(var(--bc) / 0.06); }
    .editor-tab-content { display: none; }
    .editor-tab-content.active { display: block; }
    /* Sticky preview on desktop */
    @media (min-width: 1024px) {
      .editor-preview-col { position: sticky; top: 1rem; align-self: start; }
    }
    /* Match DaisyUI round theme for all editor elements */
    .editor-panel-scroll .grid > * { min-width: 0; }
    .editor-panel-scroll input[type="color"] {
      -webkit-appearance: none;
      appearance: none;
      border: 1px solid oklch(var(--bc) / 0.2);
      padding: 2px;
      border-radius: var(--rounded-btn, 0.5rem);
      overflow: hidden;
      cursor: pointer;
    }
    .editor-panel-scroll input[type="color"]::-webkit-color-swatch-wrapper {
      padding: 0;
      border-radius: inherit;
    }
    .editor-panel-scroll input[type="color"]::-webkit-color-swatch {
      border: none;
      border-radius: inherit;
    }
    .editor-panel-scroll input[type="color"]::-moz-color-swatch {
      border: none;
      border-radius: inherit;
    }
    /* Pattern tile previews — SVGs use currentColor which resolves to black in <img> tags */
    [data-theme*="dark"] .pattern-tile-preview { filter: invert(1); }
    /* Background type selector */
    .bg-type-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 6px 2px;
      border-radius: var(--rounded-btn, 0.5rem);
      border: 1.5px solid oklch(var(--bc) / 0.1);
      background: oklch(var(--b2) / 0.5);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .bg-type-btn:hover { border-color: oklch(var(--bc) / 0.25); background: oklch(var(--b2)); }
    .bg-type-btn.active {
      border-color: oklch(var(--p));
      background: oklch(var(--p) / 0.08);
      box-shadow: 0 0 0 1px oklch(var(--p) / 0.3);
    }
    .bg-type-btn .bg-type-icon {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }
    .bg-type-btn .bg-type-label {
      font-size: 9px;
      font-weight: 500;
      line-height: 1;
      text-align: center;
      color: oklch(var(--bc) / 0.55);
      white-space: nowrap;
    }
    .bg-type-btn.active .bg-type-label { color: oklch(var(--p)); font-weight: 600; }
    /* Override-active: dim controls when scene override is enabled */
    .override-active {
      opacity: 0.35;
      pointer-events: none;
      user-select: none;
      transition: opacity 0.2s ease;
    }
    /* Panoramic hint animation */
    .bg-type-hint { animation: bgHintSlide 0.2s ease-out; }
    @keyframes bgHintSlide { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    /* 3D Perspective preset buttons */
    .perspective-preset-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 6px 2px;
      border-radius: var(--rounded-btn, 0.5rem);
      border: 1.5px solid oklch(var(--bc) / 0.12);
      background: transparent;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .perspective-preset-btn:hover { border-color: oklch(var(--bc) / 0.25); }
    .perspective-preset-btn.active {
      border-color: oklch(var(--p));
      background: oklch(var(--p) / 0.12);
      box-shadow: 0 0 0 1px oklch(var(--p) / 0.3);
    }
    .perspective-preset-btn .persp-thumb {
      width: 24px;
      height: 36px;
      border: 2.5px solid currentColor;
      border-radius: 4px;
      background: transparent;
      transition: transform 0.2s ease;
      opacity: 0.5;
    }
    .perspective-preset-btn:hover .persp-thumb { opacity: 0.7; }
    .perspective-preset-btn.active .persp-thumb {
      border-color: oklch(var(--p));
      opacity: 1;
    }
    .perspective-preset-btn .persp-label {
      font-size: 8px;
      font-weight: 500;
      line-height: 1;
      text-align: center;
      color: oklch(var(--bc) / 0.7);
      white-space: nowrap;
    }
    .perspective-preset-btn.active .persp-label { color: oklch(var(--p)); font-weight: 600; }
  </style>
<% end %>

<%
  s = @project.settings || {}
  fonts = ScreenshotProject::GOOGLE_FONTS
  fonts_by_category = ScreenshotProject::GOOGLE_FONTS_BY_CATEGORY
  weight_options = [["Light (300)", "300"], ["Regular (400)", "400"], ["Medium (500)", "500"], ["SemiBold (600)", "600"], ["Bold (700)", "700"], ["ExtraBold (800)", "800"], ["Black (900)", "900"]]
  brand = @brand_settings || {}
%>

<section class="space-y-3 sm:space-y-4 min-w-0 w-full overflow-hidden"
         data-controller="screenshot-editor screenshot-export screenshot-store-upload screenshot-bulk-edit"
         data-screenshot-editor-project-id-value="<%= @project.id %>"
         data-screenshot-editor-project-url-value="<%= organization_screenshot_project_path(@organization, @project) %>"
         data-screenshot-editor-settings-value="<%= (@project.settings || {}).to_json %>"
         data-screenshot-editor-presets-value="<%= ScreenshotProject::EXPORT_PRESETS.to_json %>"
         data-screenshot-editor-frames-value="<%= ScreenshotProject::DEVICE_FRAMES.each_with_object({}) { |(key, frame), hash|
           hash[key] = key == "none" ? frame : frame.merge(image_url: image_path("device_frames/#{key}.svg"))
         }.to_json %>"
         data-screenshot-editor-brand-value="<%= @brand_settings.to_json %>"
         data-screenshot-editor-locales-value="<%= (@project.locales || []).to_json %>"
         data-screenshot-editor-current-locale-value="<%= @project.default_locale %>"
         data-screenshot-editor-template-value="<%= @project.template %>"
         data-screenshot-editor-platform-value="<%= @project.platform %>"
         data-screenshot-editor-background-image-url-value="<%= @project.background_image.attached? ? "#{organization_screenshot_project_path(@organization, @project)}/background_image_file" : "" %>"
         data-screenshot-editor-pattern-library-value="<%= {
           tiles: ScreenshotProject::PATTERN_LIBRARY[:tiles].map { |t| t.merge(image_url: image_path(t[:file])) },
           procedural: ScreenshotProject::PATTERN_LIBRARY[:procedural]
         }.to_json %>"
         data-screenshot-editor-sticker-library-value="<%= ScreenshotProject::STICKER_LIBRARY.transform_values { |cat|
           cat.merge(items: cat[:items].map { |item| item.merge(image_url: image_path(item[:file])) })
         }.to_json %>"
         data-screenshot-editor-custom-sticker-images-value="<%= @project.custom_sticker_images.map { |a|
           {
             signed_id: a.blob.signed_id,
             attachment_id: a.id,
             url: "#{organization_screenshot_project_path(@organization, @project)}/custom_sticker_images/#{a.id}",
             filename: a.blob.filename.to_s
           }
         }.to_json %>"
         data-screenshot-export-presets-value="<%= ScreenshotProject::EXPORT_PRESETS.to_json %>"
         data-screenshot-store-upload-project-id-value="<%= @project.id %>"
         data-screenshot-store-upload-organization-id-value="<%= @organization.id %>"
         data-screenshot-store-upload-has-asc-credentials-value="<%= @has_asc_credentials %>"
         data-screenshot-store-upload-has-gp-credentials-value="<%= @has_gp_credentials %>"
         data-screenshot-store-upload-store-uploads-enabled-value="<%= @organization.store_upload_enabled? %>"
         data-screenshot-store-upload-current-plan-value="<%= @organization.plan_tier %>"
         data-screenshot-store-upload-next-plan-value="<%= @organization.entitlements.next_plan_tier %>"
         data-screenshot-store-upload-daily-uploads-used-value="<%= @plan_payload.dig(:usage, :store_uploads_last_24_hours) %>"
         data-screenshot-store-upload-daily-upload-limit-value="<%= @organization.entitlements.max_store_uploads_per_day_per_organization %>"
         data-screenshot-store-upload-daily-limit-reached-value="<%= @organization.entitlements.max_store_uploads_per_day_per_organization.to_i.positive? && @plan_payload.dig(:usage, :store_uploads_last_24_hours).to_i >= @organization.entitlements.max_store_uploads_per_day_per_organization %>"
         data-screenshot-bulk-edit-bulk-update-url-value="<%= bulk_update_organization_screenshot_project_screenshot_scenes_path(@organization, @project) %>"
         data-screenshot-bulk-edit-locales-value="<%= (@project.locales || []).to_json %>">

  <%# ══════════════════════════════════════════ %>
  <%# Page Header (compact) %>
  <%# ══════════════════════════════════════════ %>
  <%= render "shared/page_header",
             title: "Screenshot Studio",
             description: @project.name,
             gradient: "from-violet-500/10 via-base-100 to-fuchsia-500/10",
             badge_icon: "fa-solid fa-images",
             badge_text: "Editor",
             actions: (capture do %>
    <%= link_to organization_screenshot_projects_path(@organization), class: "btn btn-ghost btn-sm gap-2" do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span class="hidden sm:inline">Projects</span>
    <% end %>
    <details class="dropdown dropdown-end">
      <summary class="btn btn-ghost btn-sm gap-2">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span class="hidden sm:inline">Templates</span>
      </summary>
      <ul class="dropdown-content bg-base-200 rounded-box z-[100] w-72 p-2 shadow-lg mt-1 max-h-80 overflow-y-auto flex flex-col gap-1">
        <% ScreenshotProject::TEMPLATES.each do |key, template| %>
          <li>
            <button type="button"
                    class="flex items-center gap-3 w-full p-2 rounded-2xl hover:bg-base-300 transition-colors text-left"
                    data-action="click->screenshot-editor#applyTemplate"
                    data-template-key="<%= key %>"
                    data-template-settings="<%= template[:settings].to_json %>">
              <div class="w-8 h-8 rounded-xl shrink-0 border border-base-300" style="background: <%= template_preview_bg(template[:settings]) %>"></div>
              <div class="min-w-0">
                <span class="text-sm font-medium block"><%= template[:label] %></span>
                <span class="text-xs text-base-content/50"><%= template[:description] %></span>
              </div>
            </button>
          </li>
        <% end %>
      </ul>
    </details>
    <% if @scenes.any? %>
      <button type="button" class="btn btn-ghost btn-sm gap-2" data-action="click->screenshot-bulk-edit#open" title="Bulk Edit Captions">
        <i class="fa-solid fa-table-cells"></i>
        <span class="hidden sm:inline">Bulk Edit</span>
      </button>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm btn-circle" data-action="click->screenshot-editor#_toggleShortcutsHelp" title="Keyboard Shortcuts (?)">
      <i class="fa-solid fa-keyboard"></i>
    </button>
    <%= link_to edit_organization_screenshot_project_path(@organization, @project), class: "btn btn-ghost btn-sm gap-2" do %>
      <i class="fa-solid fa-gear"></i>
      <span class="hidden sm:inline">Settings</span>
    <% end %>
  <% end) %>

  <%= render "shared/plan_overage_banner", status: pricing_overage_status(@organization), current_project: @project, compact: true %>
  <% scheduled_change_impact = scheduled_plan_change_impact(current_user&.current_billing_subscription, organization: @organization, only_if_affected: true) if user_signed_in? %>
  <% if scheduled_change_impact.present? %>
    <%= render "shared/scheduled_plan_change_banner", impact: scheduled_change_impact, compact: true, current_only: true %>
  <% end %>

  <%# ══════════════════════════════════════════ %>
  <%# Scene Strip %>
  <%# ══════════════════════════════════════════ %>
  <div class="card bg-base-100 border border-base-200 shadow-lg overflow-hidden">
    <div class="card-body p-3 sm:p-4">
      <div class="flex items-center gap-2 mb-2">
        <h2 class="text-sm font-semibold">Scenes</h2>
        <span class="badge badge-ghost badge-xs"><%= @scenes.size %></span>
      </div>
      <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-thin">
        <% @scenes.each_with_index do |scene, idx| %>
          <%= render "scene_thumbnail", scene: scene, organization: @organization, project: @project, selected: idx == 0, has_other_projects: @has_other_projects %>
        <% end %>
        <%= render "upload_zone", organization: @organization, project: @project %>
      </div>
    </div>
  </div>

  <%# ══════════════════════════════════════════ %>
  <%# Locale Tabs (multi-locale only) %>
  <%# ══════════════════════════════════════════ %>
  <% if @project.multi_locale? %>
    <div class="card bg-base-100 border border-base-200 shadow-lg overflow-hidden">
      <div class="card-body p-3 sm:p-4">
        <div class="flex items-center gap-2 mb-2">
          <h2 class="text-sm font-semibold">Locale</h2>
          <span class="badge badge-ghost badge-xs"><%= @project.locales.size %></span>
        </div>
        <div class="flex gap-1 overflow-x-auto pb-1 scrollbar-thin" data-screenshot-editor-target="localeBar">
          <% @project.locales.each_with_index do |locale, idx| %>
            <button type="button"
                    class="btn btn-xs <%= idx == 0 ? 'btn-primary' : 'btn-ghost' %>"
                    data-action="click->screenshot-editor#switchLocale"
                    data-locale="<%= locale %>">
              <%= locale %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# ══════════════════════════════════════════════════════════════════ %>
  <%# MAIN EDITOR: Preview (sticky) + Tabbed Settings Panel           %>
  <%# ══════════════════════════════════════════════════════════════════ %>
  <div class="flex flex-col lg:grid lg:grid-cols-5 gap-3 lg:gap-4">

    <%# ── Preview Column (sticky on desktop) ── %>
    <div class="lg:col-span-3 editor-preview-col min-w-0">
      <div class="card bg-base-100 border border-base-200 shadow-lg overflow-hidden">
        <div class="card-body p-3 sm:p-4">
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-sm font-semibold">Preview</h2>
            <div class="flex items-center gap-1">
              <button type="button" class="btn btn-ghost btn-xs btn-circle" disabled
                      data-screenshot-editor-target="undoButton"
                      data-action="click->screenshot-editor#undo"
                      title="Undo (Ctrl+Z)">
                <i class="fa-solid fa-rotate-left text-[10px]"></i>
              </button>
              <button type="button" class="btn btn-ghost btn-xs btn-circle" disabled
                      data-screenshot-editor-target="redoButton"
                      data-action="click->screenshot-editor#redo"
                      title="Redo (Ctrl+Shift+Z)">
                <i class="fa-solid fa-rotate-right text-[10px]"></i>
              </button>
              <div class="divider divider-horizontal mx-0.5 h-4 self-center"></div>
              <button type="button" class="btn btn-ghost btn-xs btn-circle"
                      data-screenshot-editor-target="darkModeToggle"
                      data-action="click->screenshot-editor#toggleDarkMode"
                      title="Generate dark variant">
                <i class="fa-solid fa-moon text-[10px]" data-screenshot-editor-target="darkModeIcon"></i>
              </button>
              <span class="badge badge-ghost badge-xs ml-1" data-screenshot-editor-target="previewSize">--</span>
            </div>
          </div>
          <div class="flex items-center justify-center bg-base-200/30 rounded-2xl p-2 sm:p-4 min-h-[300px]" data-screenshot-editor-target="canvasContainer">
            <% if @scenes.any? %>
              <div class="w-full max-w-[28rem] aspect-[9/16]">
                <canvas data-screenshot-editor-target="canvas"
                        class="w-full h-full rounded-2xl shadow-lg"
                        width="1080"
                        height="1920"
                        data-action="mousedown->screenshot-editor#onCanvasMouseDown touchstart->screenshot-editor#onCanvasTouchStart"></canvas>
              </div>
            <% else %>
              <div class="text-center py-16">
                <div class="w-16 h-16 rounded-full bg-violet-500/10 flex items-center justify-center mx-auto mb-4">
                  <i class="fa-solid fa-image text-2xl text-violet-500/50"></i>
                </div>
                <h3 class="text-lg font-bold mb-2">No Scenes Yet</h3>
                <p class="text-sm text-base-content/60 max-w-xs mx-auto">
                  Upload screenshots using the "Add" button above to start creating your app store screenshots.
                </p>
              </div>
            <% end %>
          </div>

          <%# Google Play text compliance warning %>
          <% if @project.platform == "android" || @project.platform == "both" %>
            <div data-screenshot-editor-target="googlePlayTextWarning"
                 class="hidden mt-2 flex items-start gap-2 px-3 py-2 rounded-lg bg-warning/10 border border-warning/20 text-warning text-xs leading-tight">
              <i class="fa-solid fa-triangle-exclamation text-[11px] mt-0.5 shrink-0"></i>
              <div>
                <span class="font-semibold">Google Play:</span>
                Text overlays cover <span data-screenshot-editor-target="googlePlayTextPercent">0</span>% of the image area (limit: 20%).
                Exceeding this may cause rejection.
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── Settings Panel (tabbed) ── %>
    <div class="lg:col-span-2 min-w-0">
      <div class="card bg-base-100 border border-base-200 shadow-lg overflow-visible min-w-0">

        <%# Brand button %>
        <% if @organization.brand_configured? %>
          <div class="px-3 pt-3">
            <button type="button" class="btn btn-sm w-full gap-2 btn-outline btn-primary"
                    data-action="click->screenshot-editor#applyBrand">
              <i class="fa-solid fa-swatchbook"></i>
              Apply Brand
            </button>
          </div>
        <% end %>

        <%# ── Tab Navigation ── %>
        <div class="flex border-b border-base-200 px-1 pt-2 gap-0.5 overflow-x-auto scrollbar-none">
          <button type="button" class="editor-tab-btn active flex items-center gap-1.5 px-3 py-2 rounded-t-2xl text-xs font-medium whitespace-nowrap"
                  data-screenshot-editor-target="editorTabBtn" data-tab="caption" data-action="click->screenshot-editor#switchTab">
            <i class="fa-solid fa-font text-[10px]"></i>
            <span>Caption</span>
          </button>
          <button type="button" class="editor-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-t-2xl text-xs font-medium whitespace-nowrap"
                  data-screenshot-editor-target="editorTabBtn" data-tab="style" data-action="click->screenshot-editor#switchTab">
            <i class="fa-solid fa-palette text-[10px]"></i>
            <span>Style</span>
          </button>
          <button type="button" class="editor-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-t-2xl text-xs font-medium whitespace-nowrap"
                  data-screenshot-editor-target="editorTabBtn" data-tab="frame" data-action="click->screenshot-editor#switchTab">
            <i class="fa-solid fa-mobile-screen text-[10px]"></i>
            <span>Frame</span>
          </button>
          <button type="button" class="editor-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-t-2xl text-xs font-medium whitespace-nowrap"
                  data-screenshot-editor-target="editorTabBtn" data-tab="stickers" data-action="click->screenshot-editor#switchTab">
            <i class="fa-regular fa-face-smile text-[10px]"></i>
            <span>Stickers</span>
          </button>
        </div>

        <%# ── Tab Content Area ── %>
        <div class="editor-panel-scroll p-3 min-w-0">

          <%# ════════════════════════════════════════ %>
          <%# TAB 1: CAPTION & TEXT                   %>
          <%# ════════════════════════════════════════ %>
          <div id="tab-caption" class="editor-tab-content active space-y-3 pb-4" data-screenshot-editor-target="editorTabContent" data-tab="caption">

            <%# Title + Subtitle inputs %>
            <div class="space-y-1.5">
              <textarea class="textarea textarea-bordered textarea-xs w-full leading-tight"
                        rows="2"
                        placeholder="Title text..."
                        data-screenshot-editor-target="captionText"
                        data-action="input->screenshot-editor#updatePreview"><%= @scenes.first&.caption_text %></textarea>
              <textarea class="textarea textarea-bordered textarea-xs w-full leading-tight"
                        rows="1"
                        placeholder="Subtitle text..."
                        data-screenshot-editor-target="subtitleText"
                        data-action="input->screenshot-editor#updatePreview"><%= @scenes.first&.subtitle_text %></textarea>
            </div>

            <%# Font pickers %>
            <div class="grid grid-cols-2 gap-1.5">
              <div>
                <span class="text-[10px] text-base-content/50">Title Font</span>
                <% cf_val = s.dig("caption_font_family") || "Inter" %>
                <details class="dropdown w-full" data-controller="custom-select">
                  <input type="hidden" value="<%= cf_val %>"
                         data-custom-select-target="input"
                         data-screenshot-editor-target="captionFontFamily"
                         data-action="change->screenshot-editor#fontChanged input->screenshot-editor#fontChanged">
                  <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-xs" data-custom-select-target="label" style="font-family: '<%= cf_val %>'"><%= cf_val %></summary>
                  <div class="dropdown-content bg-base-200 rounded-box z-[100] w-64 shadow-lg mt-1">
                    <div class="p-1.5 border-b border-base-300 sticky top-0 bg-base-200 z-10 rounded-t-box">
                      <input type="text" placeholder="Search fonts..." class="input input-xs input-bordered w-full font-search-input" data-action="input->custom-select#filterFonts">
                    </div>
                    <ul class="p-2 max-h-60 overflow-y-auto flex flex-col gap-0.5">
                      <% fonts_by_category.each do |category, cat_fonts| %>
                        <li class="font-category-header text-[9px] font-bold text-base-content/40 uppercase tracking-wider px-2 pt-2 pb-0.5 select-none"><%= category %></li>
                        <% cat_fonts.each do |font| %>
                          <li class="font-option"><a href="#" data-action="click->custom-select#select" data-value="<%= font %>" data-label="<%= font %>" class="<%= 'active' if font == cf_val %>" style="font-family: '<%= font %>'"><%= font %></a></li>
                        <% end %>
                      <% end %>
                    </ul>
                    <div class="hidden p-3 text-center text-xs text-base-content/40 font-no-results">No fonts found</div>
                  </div>
                </details>
              </div>
              <div>
                <span class="text-[10px] text-base-content/50">Subtitle Font</span>
                <% sf_val = s.dig("subtitle_font_family") || "Inter" %>
                <details class="dropdown w-full" data-controller="custom-select">
                  <input type="hidden" value="<%= sf_val %>"
                         data-custom-select-target="input"
                         data-screenshot-editor-target="subtitleFontFamily"
                         data-action="change->screenshot-editor#subtitleFontChanged input->screenshot-editor#subtitleFontChanged">
                  <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-xs" data-custom-select-target="label" style="font-family: '<%= sf_val %>'"><%= sf_val %></summary>
                  <div class="dropdown-content bg-base-200 rounded-box z-[100] w-64 shadow-lg mt-1">
                    <div class="p-1.5 border-b border-base-300 sticky top-0 bg-base-200 z-10 rounded-t-box">
                      <input type="text" placeholder="Search fonts..." class="input input-xs input-bordered w-full font-search-input" data-action="input->custom-select#filterFonts">
                    </div>
                    <ul class="p-2 max-h-60 overflow-y-auto flex flex-col gap-0.5">
                      <% fonts_by_category.each do |category, cat_fonts| %>
                        <li class="font-category-header text-[9px] font-bold text-base-content/40 uppercase tracking-wider px-2 pt-2 pb-0.5 select-none"><%= category %></li>
                        <% cat_fonts.each do |font| %>
                          <li class="font-option"><a href="#" data-action="click->custom-select#select" data-value="<%= font %>" data-label="<%= font %>" class="<%= 'active' if font == sf_val %>" style="font-family: '<%= font %>'"><%= font %></a></li>
                        <% end %>
                      <% end %>
                    </ul>
                    <div class="hidden p-3 text-center text-xs text-base-content/40 font-no-results">No fonts found</div>
                  </div>
                </details>
              </div>
            </div>

            <%# Weight pickers %>
            <div class="grid grid-cols-2 gap-1.5">
              <div>
                <span class="text-[10px] text-base-content/50">Title Weight</span>
                <% cfw_val = (s.dig("caption_font_weight") || 700).to_s %>
                <details class="dropdown w-full" data-controller="custom-select">
                  <input type="hidden" value="<%= cfw_val %>"
                         data-custom-select-target="input"
                         data-screenshot-editor-target="captionFontWeight"
                         data-action="change->screenshot-editor#fontChanged input->screenshot-editor#fontChanged">
                  <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-xs" data-custom-select-target="label"><%= weight_options.find { |l, v| v == cfw_val }&.first || "Bold (700)" %></summary>
                  <ul class="dropdown-content bg-base-200 rounded-box z-[100] w-44 p-2 shadow-lg mt-1 max-h-60 overflow-y-auto flex flex-col gap-1">
                    <% weight_options.each do |label, value| %>
                      <li><a href="#" data-action="click->custom-select#select" data-value="<%= value %>" data-label="<%= label %>" class="<%= 'active' if value == cfw_val %>"><%= label %></a></li>
                    <% end %>
                  </ul>
                </details>
              </div>
              <div>
                <span class="text-[10px] text-base-content/50">Sub Weight</span>
                <% sfw_val = (s.dig("subtitle_font_weight") || 400).to_s %>
                <details class="dropdown w-full" data-controller="custom-select">
                  <input type="hidden" value="<%= sfw_val %>"
                         data-custom-select-target="input"
                         data-screenshot-editor-target="subtitleFontWeight"
                         data-action="change->screenshot-editor#subtitleFontChanged input->screenshot-editor#subtitleFontChanged">
                  <summary class="select select-bordered select-xs w-full flex items-center cursor-pointer text-xs" data-custom-select-target="label"><%= weight_options.find { |l, v| v == sfw_val }&.first || "Regular (400)" %></summary>
                  <ul class="dropdown-content bg-base-200 rounded-box z-[100] w-44 p-2 shadow-lg mt-1 max-h-60 overflow-y-auto flex flex-col gap-1">
                    <% weight_options.each do |label, value| %>
                      <li><a href="#" data-action="click->custom-select#select" data-value="<%= value %>" data-label="<%= label %>" class="<%= 'active' if value == sfw_val %>"><%= label %></a></li>
                    <% end %>
                  </ul>
                </details>
              </div>
            </div>

            <%# Size sliders + Colors (overridable by per-scene styling) %>
            <div data-screenshot-editor-target="overridableControls">
              <div class="grid grid-cols-2 gap-1.5">
                <label>
                  <span class="text-[10px] text-base-content/50">Title Size</span>
                  <input type="range" min="16" max="144" value="<%= s.dig("caption_font_size") || 32 %>"
                         class="range range-primary range-xs"
                         data-screenshot-editor-target="captionFontSize"
                         data-action="input->screenshot-editor#updatePreview">
                </label>
                <label>
                  <span class="text-[10px] text-base-content/50">Subtitle Size</span>
                  <input type="range" min="10" max="96" value="<%= s.dig("subtitle_font_size") || 20 %>"
                         class="range range-primary range-xs"
                         data-screenshot-editor-target="subtitleFontSize"
                         data-action="input->screenshot-editor#updatePreview">
                </label>
              </div>

              <div class="grid grid-cols-2 gap-1.5 mt-1.5">
                <div>
                  <span class="text-[10px] text-base-content/50">Title Color</span>
                  <div class="flex items-center gap-1">
                    <input type="color" value="<%= s.dig("caption_color") || "#FFFFFF" %>"
                           class="w-7 h-7 rounded-lg border border-base-200 cursor-pointer shrink-0"
                           aria-label="Title color"
                           data-screenshot-editor-target="captionColor"
                           data-action="input->screenshot-editor#updatePreview">
                    <input type="text" value="<%= s.dig("caption_color") || "#FFFFFF" %>"
                           class="input input-bordered input-xs flex-1 font-mono text-[10px] min-w-0"
                           aria-label="Title color hex value"
                           data-screenshot-editor-target="captionColorText"
                           data-action="input->screenshot-editor#syncCaptionColor">
                    <% if brand["text_color"].present? %>
                      <button type="button" class="w-5 h-5 rounded-full border border-base-300 shrink-0 cursor-pointer" style="background: <%= brand['text_color'] %>" title="Brand text color"
                              data-action="click->screenshot-editor#applyBrandColor" data-color="<%= brand['text_color'] %>" data-target-input="captionColor"></button>
                    <% end %>
                  </div>
                </div>
                <div>
                  <span class="text-[10px] text-base-content/50">Subtitle Color</span>
                  <div class="flex items-center gap-1">
                    <input type="color" value="<%= s.dig("subtitle_color") || "#CCCCCC" %>"
                           class="w-7 h-7 rounded-lg border border-base-200 cursor-pointer shrink-0"
                           aria-label="Subtitle color"
                           data-screenshot-editor-target="subtitleColor"
                           data-action="input->screenshot-editor#updatePreview">
                    <input type="text" value="<%= s.dig("subtitle_color") || "#CCCCCC" %>"
                           class="input input-bordered input-xs flex-1 font-mono text-[10px] min-w-0"
                           aria-label="Subtitle color hex value"
                           data-screenshot-editor-target="subtitleColorText"
                           data-action="input->screenshot-editor#syncSubtitleColor">
                    <% if brand["secondary_color"].present? %>
                      <button type="button" class="w-5 h-5 rounded-full border border-base-300 shrink-0 cursor-pointer" style="background: <%= brand['secondary_color'] %>" title="Brand secondary color"
                              data-action="click->screenshot-editor#applyBrandColor" data-color="<%= brand['secondary_color'] %>" data-target-input="subtitleColor"></button>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <div data-screenshot-editor-target="overrideActiveIndicator" class="hidden">
              <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg bg-warning/10 border border-warning/20 mt-1">
                <i class="fa-solid fa-circle-info text-[9px] text-warning"></i>
                <span class="text-[10px] text-warning leading-tight">
                  These controls are overridden for this scene. Edit in <strong>Per-Scene Styling</strong> below, or disable it to use these defaults.
                </span>
              </div>
            </div>

            <%# Alignment %>
            <div data-screenshot-editor-target="alignmentControls">
              <span class="text-[10px] text-base-content/50">Alignment</span>
              <input type="hidden" value="<%= s.dig("caption_text_align") || "center" %>" data-screenshot-editor-target="captionTextAlign">
              <% ta_val = s.dig("caption_text_align") || "center" %>
              <div class="join w-full">
                <button type="button" class="btn btn-xs join-item flex-1 <%= "btn-active" if ta_val == "left" %>"
                        data-action="click->screenshot-editor#setAlignment" data-align="left"
                        data-screenshot-editor-target="alignLeft">
                  <i class="fa-solid fa-align-left text-[10px]"></i>
                </button>
                <button type="button" class="btn btn-xs join-item flex-1 <%= "btn-active" if ta_val == "center" %>"
                        data-action="click->screenshot-editor#setAlignment" data-align="center"
                        data-screenshot-editor-target="alignCenter">
                  <i class="fa-solid fa-align-center text-[10px]"></i>
                </button>
                <button type="button" class="btn btn-xs join-item flex-1 <%= "btn-active" if ta_val == "right" %>"
                        data-action="click->screenshot-editor#setAlignment" data-align="right"
                        data-screenshot-editor-target="alignRight">
                  <i class="fa-solid fa-align-right text-[10px]"></i>
                </button>
              </div>
            </div>

            <%# Layout section %>
            <details class="group" open>
              <summary class="flex items-center justify-between cursor-pointer py-1 border-t border-base-200 mt-1">
                <div class="flex flex-col">
                  <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wide">Layout</span>
                  <span class="text-[9px] text-base-content/30 font-normal normal-case tracking-normal">Zone spacing, vertical position, freeform drag</span>
                </div>
                <i class="fa-solid fa-chevron-down text-[8px] text-base-content/30 transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="space-y-1.5 pt-1">
                <input type="hidden" value="<%= @project.settings&.dig("layout_mode") || "auto" %>" data-screenshot-editor-target="layoutMode">

                <% _layout_mode = @project.settings&.dig("layout_mode") || "auto" %>
                <div class="flex gap-0.5 p-0.5 bg-base-200 rounded-full">
                  <button type="button"
                          class="btn btn-xs flex-1 gap-1 <%= _layout_mode == "auto" ? "btn-active" : "btn-ghost" %>"
                          data-action="click->screenshot-editor#setPositioningMode"
                          data-mode="auto"
                          data-screenshot-editor-target="posModeBtnAuto">
                    <i class="fa-solid fa-table-cells text-[9px]"></i>
                    Auto Layout
                  </button>
                  <button type="button"
                          class="btn btn-xs flex-1 gap-1 <%= _layout_mode == "freeform" ? "btn-active" : "btn-ghost" %>"
                          data-action="click->screenshot-editor#setPositioningMode"
                          data-mode="freeform"
                          data-screenshot-editor-target="posModeBtnFreeform">
                    <i class="fa-solid fa-hand text-[9px]"></i>
                    Freeform
                  </button>
                </div>

                <%# Auto Layout Panel %>
                <div data-screenshot-editor-target="autoLayoutPanel" class="space-y-1.5">
                  <input type="hidden" value="zone" data-screenshot-editor-target="captionMode">
                  <input type="hidden" value="top" data-screenshot-editor-target="captionPosition">

                  <div data-screenshot-editor-target="modeZoneControls">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] text-base-content/50">Zone Size</span>
                      <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="captionZoneSizeLabel"><%= s.dig("caption_zone_size") || 12 %>%</span>
                    </div>
                    <input type="range" min="0" max="30" value="<%= s.dig("caption_zone_size") || 12 %>"
                           class="range range-primary range-xs"
                           data-screenshot-editor-target="captionZoneSize"
                           data-action="input->screenshot-editor#updatePreview">
                  </div>

                  <div>
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] text-base-content/50">Vertical Pos.</span>
                      <div class="flex items-center gap-1">
                        <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="captionVerticalPositionLabel"><%= s.dig("caption_vertical_position").present? ? "#{s.dig("caption_vertical_position")}%" : "Auto" %></span>
                        <button type="button" class="text-[9px] text-primary hover:underline" data-action="click->screenshot-editor#clearVerticalPosition">Reset</button>
                      </div>
                    </div>
                    <input type="range" min="5" max="95" step="1" value="<%= s.dig("caption_vertical_position") || 50 %>"
                           class="range range-primary range-xs"
                           data-screenshot-editor-target="captionVerticalPosition"
                           data-action="input->screenshot-editor#updatePreview">
                  </div>
                </div>

                <%# Freeform Panel %>
                <div data-screenshot-editor-target="freeformPanel" class="hidden">
                  <div class="bg-base-200/50 rounded-2xl p-2.5 space-y-2.5">
                    <div class="flex items-center gap-2.5">
                      <div class="w-6 h-6 rounded-full bg-indigo-500/10 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-arrows-up-down-left-right text-[10px] text-indigo-500"></i>
                      </div>
                      <div>
                        <div class="text-[10px] font-medium leading-tight">Drag text to reposition</div>
                        <div class="text-[9px] text-base-content/40 leading-tight">Drag corners to resize &middot; Drag top handle to rotate</div>
                      </div>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] text-base-content/50">Position</span>
                      <span class="text-[10px] text-base-content/40 font-mono" data-screenshot-editor-target="dragPositionLabel">Auto</span>
                    </div>
                    <button type="button"
                            class="btn btn-xs btn-ghost w-full gap-1 hidden"
                            data-action="click->screenshot-editor#resetDragPosition"
                            data-screenshot-editor-target="resetDragButton">
                      <i class="fa-solid fa-rotate-left text-[9px]"></i>
                      Reset Position
                    </button>
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] text-base-content/50">Rotation</span>
                      <span class="text-[10px] text-base-content/40 font-mono" data-screenshot-editor-target="rotationLabel">0&deg;</span>
                    </div>
                    <button type="button"
                            class="btn btn-xs btn-ghost w-full gap-1 hidden"
                            data-action="click->screenshot-editor#resetRotation"
                            data-screenshot-editor-target="resetRotationButton">
                      <i class="fa-solid fa-rotate-left text-[9px]"></i>
                      Reset Rotation
                    </button>
                  </div>
                </div>
              </div>
            </details>

            <%# Spacing section %>
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer py-1 border-t border-base-200">
                <div class="flex flex-col">
                  <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wide">Spacing</span>
                  <span class="text-[9px] text-base-content/30 font-normal normal-case tracking-normal">Letter spacing, line height</span>
                </div>
                <i class="fa-solid fa-chevron-down text-[8px] text-base-content/30 transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="space-y-1.5 pt-1">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] text-base-content/50">Letter Spacing</span>
                    <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="captionLetterSpacingLabel"><%= s.dig("caption_letter_spacing") || 0 %>px</span>
                  </div>
                  <input type="range" min="-2" max="10" step="0.5" value="<%= s.dig("caption_letter_spacing") || 0 %>"
                         class="range range-primary range-xs"
                         data-screenshot-editor-target="captionLetterSpacing"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
                <div>
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] text-base-content/50">Line Height</span>
                    <span class="text-[10px] text-base-content/40" data-screenshot-editor-target="captionLineHeightLabel"><%= s.dig("caption_line_height") || 1.3 %></span>
                  </div>
                  <input type="range" min="0.8" max="2.5" step="0.1" value="<%= s.dig("caption_line_height") || 1.3 %>"
                         class="range range-primary range-xs"
                         data-screenshot-editor-target="captionLineHeight"
                         data-action="input->screenshot-editor#updatePreview">
                </div>
              </div>
            </details>

            <%# Effects section (text effects) %>
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer py-1 border-t border-base-200">
                <div class="flex flex-col">
                  <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wide">
                    <i class="fa-solid fa-wand-magic-sparkles text-[8px] mr-0.5"></i> Effects
                  </span>
                  <span class="text-[9px] text-base-content/30 font-normal normal-case tracking-normal">Gradient fill, text stroke, background pill</span>
                </div>
                <div class="flex items-center gap-1">
                  <span data-screenshot-editor-target="effectsActiveBadge" class="hidden badge badge-xs badge-primary badge-outline">ON</span>
                  <i class="fa-solid fa-chevron-down text-[8px] text-base-content/30 transition-transform group-open:rotate-180"></i>
                </div>
              </summary>
              <div class="space-y-2 pt-1.5">
                <%# Gradient Fill %>
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="text-[10px] text-base-content/70">Gradient Fill</span>
                  <input type="checkbox" class="toggle toggle-primary toggle-xs"
                         data-screenshot-editor-target="captionGradientEnabled"
                         data-action="change->screenshot-editor#toggleGradient"
                         <%= "checked" if s.dig("caption_gradient_enabled") %>>
                </label>
                <div data-screenshot-editor-target="captionGradientControls" class="grid grid-cols-2 gap-1.5 <%= "hidden" unless s.dig("caption_gradient_enabled") %>">
                  <div>
                    <span class="text-[10px] text-base-content/50">Start</span>
                    <input type="color" value="<%= s.dig("caption_gradient_start") || "#FF6B6B" %>"
                           class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                           data-screenshot-editor-target="captionGradientStart"
                           data-action="input->screenshot-editor#updatePreview">
                  </div>
                  <div>
                    <span class="text-[10px] text-base-content/50">End</span>
                    <input type="color" value="<%= s.dig("caption_gradient_end") || "#4ECDC4" %>"
                           class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                           data-screenshot-editor-target="captionGradientEnd"
                           data-action="input->screenshot-editor#updatePreview">
                  </div>
                </div>

                <%# Background Pill %>
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="text-[10px] text-base-content/70">Background Pill</span>
                  <input type="checkbox" class="toggle toggle-primary toggle-xs"
                         data-screenshot-editor-target="textBgEnabled"
                         data-action="change->screenshot-editor#toggleTextBg"
                         <%= "checked" if s.dig("text_bg_enabled") %>>
                </label>
                <div data-screenshot-editor-target="textBgControls" class="space-y-1.5 <%= "hidden" unless s.dig("text_bg_enabled") %>">
                  <div class="grid grid-cols-3 gap-1.5">
                    <div>
                      <span class="text-[10px] text-base-content/50">Color</span>
                      <input type="color" value="<%= s.dig("text_bg_color") || "#000000" %>"
                             class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                             data-screenshot-editor-target="textBgColor"
                             data-action="input->screenshot-editor#updatePreview">
                    </div>
                    <div>
                      <div class="flex justify-between"><span class="text-[10px] text-base-content/50">Opacity</span><span class="text-[10px] text-base-content/40" data-screenshot-editor-target="textBgOpacityLabel"><%= s.dig("text_bg_opacity") || 50 %>%</span></div>
                      <input type="range" min="0" max="100" value="<%= s.dig("text_bg_opacity") || 50 %>"
                             class="range range-primary range-xs"
                             data-screenshot-editor-target="textBgOpacity"
                             data-action="input->screenshot-editor#updatePreview">
                    </div>
                    <div>
                      <div class="flex justify-between"><span class="text-[10px] text-base-content/50">Radius</span><span class="text-[10px] text-base-content/40" data-screenshot-editor-target="textBgRadiusLabel"><%= s.dig("text_bg_radius") || 12 %>px</span></div>
                      <input type="range" min="0" max="50" value="<%= s.dig("text_bg_radius") || 12 %>"
                             class="range range-primary range-xs"
                             data-screenshot-editor-target="textBgRadius"
                             data-action="input->screenshot-editor#updatePreview">
                    </div>
                  </div>
                </div>

                <%# Text Stroke %>
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="text-[10px] text-base-content/70">Text Stroke</span>
                  <input type="checkbox" class="toggle toggle-primary toggle-xs"
                         data-screenshot-editor-target="captionStrokeEnabled"
                         data-action="change->screenshot-editor#toggleStroke"
                         <%= "checked" if s.dig("caption_stroke_enabled") %>>
                </label>
                <div data-screenshot-editor-target="captionStrokeControls" class="grid grid-cols-2 gap-1.5 <%= "hidden" unless s.dig("caption_stroke_enabled") %>">
                  <div>
                    <span class="text-[10px] text-base-content/50">Color</span>
                    <input type="color" value="<%= s.dig("caption_stroke_color") || "#000000" %>"
                           class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                           data-screenshot-editor-target="captionStrokeColor"
                           data-action="input->screenshot-editor#updatePreview">
                  </div>
                  <div>
                    <div class="flex justify-between"><span class="text-[10px] text-base-content/50">Width</span><span class="text-[10px] text-base-content/40" data-screenshot-editor-target="captionStrokeWidthLabel"><%= s.dig("caption_stroke_width") || 2 %>px</span></div>
                    <input type="range" min="1" max="8" value="<%= s.dig("caption_stroke_width") || 2 %>"
                           class="range range-primary range-xs"
                           data-screenshot-editor-target="captionStrokeWidth"
                           data-action="input->screenshot-editor#updatePreview">
                  </div>
                </div>
              </div>
            </details>

            <%# Per-Scene Styling section %>
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer py-1 border-t border-base-200">
                <div class="flex flex-col">
                  <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wide">Per-Scene Styling</span>
                  <span class="text-[9px] text-base-content/30 font-normal normal-case tracking-normal">Custom colors & sizes for this scene</span>
                </div>
                <div class="flex items-center gap-1">
                  <span data-screenshot-editor-target="overrideBadge" class="hidden badge badge-xs badge-primary badge-outline">ON</span>
                  <i class="fa-solid fa-chevron-down text-[8px] text-base-content/30 transition-transform group-open:rotate-180"></i>
                </div>
              </summary>
              <div class="space-y-1.5 pt-1">
                <p class="text-[9px] text-base-content/40 leading-relaxed mb-1">
                  Customize colors and sizes for just this scene, overriding the defaults above.
                </p>
                <label class="flex items-center justify-between cursor-pointer">
                  <span class="text-[10px] text-base-content/70">Enable per-scene customization</span>
                  <input type="checkbox" class="toggle toggle-primary toggle-xs"
                         data-screenshot-editor-target="sceneOverrideEnabled"
                         data-action="change->screenshot-editor#toggleSceneOverride">
                </label>
                <div data-screenshot-editor-target="sceneOverrideControls" class="space-y-1.5 hidden">
                  <div class="grid grid-cols-2 gap-1.5">
                    <div>
                      <span class="text-[10px] text-base-content/50">Title Color</span>
                      <input type="color" value="<%= s.dig("caption_color") || "#FFFFFF" %>"
                             class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                             data-screenshot-editor-target="sceneOverrideCaptionColor"
                             data-action="input->screenshot-editor#updatePreview">
                    </div>
                    <div>
                      <span class="text-[10px] text-base-content/50">Subtitle Color</span>
                      <input type="color" value="<%= s.dig("subtitle_color") || "#CCCCCC" %>"
                             class="w-full h-6 rounded-xl border border-base-200 cursor-pointer"
                             data-screenshot-editor-target="sceneOverrideSubtitleColor"
                             data-action="input->screenshot-editor#updatePreview">
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-1.5">
                    <label>
                      <span class="text-[10px] text-base-content/50">Title Size</span>
                      <input type="range" min="16" max="144" value="<%= s.dig("caption_font_size") || 32 %>"
                             class="range range-primary range-xs"
                             data-screenshot-editor-target="sceneOverrideCaptionFontSize"
                             data-action="input->screenshot-editor#updatePreview">
                    </label>
                    <label>
                      <span class="text-[10px] text-base-content/50">Subtitle Size</span>
                      <input type="range" min="10" max="96" value="<%= s.dig("subtitle_font_size") || 20 %>"
                             class="range range-primary range-xs"
                             data-screenshot-editor-target="sceneOverrideSubtitleFontSize"
                             data-action="input->screenshot-editor#updatePreview">
