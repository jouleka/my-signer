<style>
  .bg-type-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 6px 2px;
    border-radius: var(--rounded-btn, 0.5rem);
    border: 1.5px solid oklch(var(--bc) / 0.1);
    background: oklch(var(--b2) / 0.5);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .bg-type-btn:hover { border-color: oklch(var(--bc) / 0.25); background: oklch(var(--b2)); }
  .bg-type-btn.active {
    border-color: oklch(var(--p));
    background: oklch(var(--p) / 0.08);
    box-shadow: 0 0 0 1px oklch(var(--p) / 0.3);
  }
  .bg-type-btn .bg-type-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .bg-type-btn .bg-type-label {
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    color: oklch(var(--bc) / 0.55);
    white-space: nowrap;
  }
  .bg-type-btn.active .bg-type-label { color: oklch(var(--p)); font-weight: 600; }
</style>

<%
  form_data = { turbo: false }
  if local_assigns[:upgrade_gate].present?
    form_data.merge!(
      controller: "upgrade-gate",
      action: "submit->upgrade-gate#intercept",
      upgrade_gate_blocked_value: upgrade_gate[:blocked],
      upgrade_gate_prompt_value: json_escape(upgrade_gate[:prompt].to_json)
    )
  end
%>
<%= form_with model: [@organization, project], data: form_data, html: { class: "space-y-6 sm:space-y-8 min-w-0" } do |f| %>
  <% if project.errors.any? %>
    <div class="alert alert-error shadow-lg text-sm">
      <i class="fa-solid fa-circle-exclamation shrink-0"></i>
      <div class="min-w-0">
        <h3 class="font-bold">Validation Failed</h3>
        <ul class="text-sm mt-1 space-y-0.5">
          <% project.errors.full_messages.each do |msg| %>
            <li>&bull; <%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# Step 1: Basic Info %>
  <div class="space-y-4">
    <div class="flex items-center gap-3 mb-2 sm:mb-4">
      <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">1</div>
      <h2 class="text-base sm:text-lg font-bold">Project Details</h2>
    </div>

    <div class="form-control w-full min-w-0">
      <label class="label px-0">
        <span class="label-text font-medium flex items-center gap-2">
          <i class="fa-solid fa-tag text-xs text-base-content/50"></i>
          Project Name
        </span>
        <span class="label-text-alt badge badge-ghost badge-xs shrink-0">Required</span>
      </label>
      <%= f.text_field :name, class: "input input-bordered w-full focus:input-primary", placeholder: "e.g. MyApp v2.0 Screenshots", required: true %>
      <p class="text-xs text-base-content/50 mt-1.5 break-words">A name to identify this screenshot project</p>
    </div>
  </div>

  <div class="divider my-0"></div>

  <%# Step 2: Platform %>
  <div class="space-y-4">
    <div class="flex items-center gap-3 mb-2 sm:mb-4">
      <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">2</div>
      <h2 class="text-base sm:text-lg font-bold">Target Platform</h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-3">
      <label class="flex items-center gap-3 p-3 sm:p-4 rounded-xl border border-base-200 bg-base-100 cursor-pointer hover:border-primary/50 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
        <%= f.radio_button :platform, "both", class: "radio radio-primary radio-sm" %>
        <div class="min-w-0">
          <span class="font-semibold block text-sm">Both Platforms</span>
          <span class="text-xs text-base-content/60">iOS + Android</span>
        </div>
      </label>
      <label class="flex items-center gap-3 p-3 sm:p-4 rounded-xl border border-base-200 bg-base-100 cursor-pointer hover:border-primary/50 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
        <%= f.radio_button :platform, "ios", class: "radio radio-primary radio-sm" %>
        <div class="min-w-0">
          <span class="font-semibold block text-sm"><i class="fa-brands fa-apple"></i> iOS Only</span>
          <span class="text-xs text-base-content/60">App Store</span>
        </div>
      </label>
      <label class="flex items-center gap-3 p-3 sm:p-4 rounded-xl border border-base-200 bg-base-100 cursor-pointer hover:border-primary/50 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
        <%= f.radio_button :platform, "android", class: "radio radio-primary radio-sm" %>
        <div class="min-w-0">
          <span class="font-semibold block text-sm"><i class="fa-brands fa-android"></i> Android Only</span>
          <span class="text-xs text-base-content/60">Google Play</span>
        </div>
      </label>
    </div>
  </div>

  <div class="divider my-0"></div>

  <%# Step 3: Choose a Template %>
  <div class="space-y-4">
    <div class="flex items-center gap-3 mb-2 sm:mb-4">
      <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">3</div>
      <h2 class="text-base sm:text-lg font-bold">Choose a Template</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3" data-template-selector>
      <%# Custom (no template) %>
      <label class="flex flex-col gap-2 p-3 sm:p-4 rounded-xl border border-base-200 bg-base-100 cursor-pointer hover:border-primary/50 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
        <div class="flex items-center gap-3">
          <input type="radio" name="screenshot_project[template]" value="" class="radio radio-primary radio-sm" data-template-radio <%= "checked" if project.template.blank? %>>
          <div class="min-w-0">
            <span class="font-semibold block text-sm">Custom</span>
            <span class="text-xs text-base-content/60">Start from scratch</span>
          </div>
        </div>
        <div class="h-12 rounded-lg border border-base-200 bg-base-200/50 flex items-center justify-center">
          <span class="text-xs text-base-content/40">No template</span>
        </div>
      </label>

      <% ScreenshotProject::TEMPLATES.each do |key, template| %>
        <label class="flex flex-col gap-2 p-3 sm:p-4 rounded-xl border border-base-200 bg-base-100 cursor-pointer hover:border-primary/50 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
          <div class="flex items-center gap-3">
            <input type="radio" name="screenshot_project[template]" value="<%= key %>" class="radio radio-primary radio-sm" data-template-radio <%= "checked" if project.template == key %>>
            <div class="min-w-0">
              <span class="font-semibold block text-sm"><%= template[:label] %></span>
              <span class="text-xs text-base-content/60"><%= template[:description] %></span>
            </div>
          </div>
          <div class="h-12 rounded-lg flex items-center justify-center" style="background: <%= template_preview_bg(template[:settings]) %>">
            <span class="text-xs font-semibold" style="color: <%= template[:settings]['caption_color'] %>; font-family: '<%= template[:settings]['caption_font_family'] %>'">
              Sample Text
            </span>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="divider my-0"></div>

  <%# Step 4: Default Settings %>
  <div class="space-y-4" id="default-appearance-section">
    <div class="flex items-center gap-3 mb-2 sm:mb-4">
      <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">4</div>
      <h2 class="text-base sm:text-lg font-bold">Default Appearance</h2>
    </div>

    <div id="template-hint" class="alert alert-info text-sm py-2 <%= "hidden" if project.template.blank? %>">
      <i class="fa-solid fa-circle-info shrink-0"></i>
      <span>Template selected &mdash; these settings will be overridden by the template.</span>
    </div>

    <% _bg_type = project.settings&.dig("background_type") || "solid" %>
    <div class="bg-base-200/30 p-3 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl space-y-4 sm:space-y-5 border border-base-200 overflow-visible transition-opacity duration-200 <%= "opacity-40 pointer-events-none" unless project.template.blank? %>" id="default-appearance-fields">

      <%# Background Type selector %>
      <div class="form-control w-full min-w-0">
        <label class="label px-0">
          <span class="label-text font-medium flex items-center gap-2 text-sm">
            <i class="fa-solid fa-palette text-xs text-base-content/50"></i>
            Background Type
          </span>
        </label>
        <input type="hidden" name="screenshot_project[settings][background_type]" value="<%= _bg_type %>" id="form-bg-type-input">
        <div class="grid grid-cols-4 gap-2" id="form-bg-type-selector">
          <button type="button" class="bg-type-btn <%= "active" if _bg_type == "solid" %>" data-bg-type="solid">
            <div class="bg-type-icon" style="background: #000"></div>
            <span class="bg-type-label">Solid</span>
          </button>
          <button type="button" class="bg-type-btn <%= "active" if _bg_type == "gradient" %>" data-bg-type="gradient">
            <div class="bg-type-icon" style="background: linear-gradient(to bottom, #6366f1, #ec4899)"></div>
            <span class="bg-type-label">Gradient</span>
          </button>
          <button type="button" class="bg-type-btn <%= "active" if _bg_type == "mesh" %>" data-bg-type="mesh">
            <div class="bg-type-icon" style="background: radial-gradient(circle at 30% 30%, #FF6B35, transparent 70%), radial-gradient(circle at 70% 60%, #D4145A, #1a0533)"></div>
            <span class="bg-type-label">Mesh</span>
          </button>
          <button type="button" class="bg-type-btn <%= "active" if _bg_type == "pattern" %>" data-bg-type="pattern">
            <div class="bg-type-icon" style="background: repeating-linear-gradient(45deg, #334155, #334155 2px, #1e293b 2px, #1e293b 6px)"></div>
            <span class="bg-type-label">Pattern</span>
          </button>
        </div>
      </div>

      <%# Solid background options %>
      <div id="form-bg-solid" class="<%= "hidden" unless _bg_type == "solid" %>">
        <div class="form-control w-full min-w-0">
          <label class="label px-0">
            <span class="label-text font-medium flex items-center gap-2 text-sm">Background Color</span>
          </label>
          <div class="flex items-center gap-3" data-controller="color-sync">
            <input type="color" name="screenshot_project[settings][background_color]" value="<%= project.settings&.dig("background_color") || "#000000" %>" class="w-10 h-10 rounded-lg border border-base-200 cursor-pointer" data-action="input->color-sync#sync">
            <input type="text" value="<%= project.settings&.dig("background_color") || "#000000" %>" class="input input-bordered input-sm flex-1 font-mono text-sm" placeholder="#000000" data-action="input->color-sync#sync">
          </div>
        </div>
      </div>

      <%# Gradient background options %>
      <div id="form-bg-gradient" class="<%= "hidden" unless _bg_type == "gradient" %>">
        <div class="grid grid-cols-2 gap-4">
          <div class="form-control w-full min-w-0">
            <label class="label px-0">
              <span class="label-text font-medium text-sm">Start Color</span>
            </label>
            <div class="flex items-center gap-3" data-controller="color-sync">
              <input type="color" name="screenshot_project[settings][gradient_start]" value="<%= project.settings&.dig("gradient_start") || "#6366F1" %>" class="w-10 h-10 rounded-lg border border-base-200 cursor-pointer" data-action="input->color-sync#sync">
              <input type="text" value="<%= project.settings&.dig("gradient_start") || "#6366F1" %>" class="input input-bordered input-sm flex-1 font-mono text-sm" placeholder="#6366F1" data-action="input->color-sync#sync">
            </div>
          </div>
          <div class="form-control w-full min-w-0">
            <label class="label px-0">
              <span class="label-text font-medium text-sm">End Color</span>
            </label>
            <div class="flex items-center gap-3" data-controller="color-sync">
              <input type="color" name="screenshot_project[settings][gradient_end]" value="<%= project.settings&.dig("gradient_end") || "#EC4899" %>" class="w-10 h-10 rounded-lg border border-base-200 cursor-pointer" data-action="input->color-sync#sync">
              <input type="text" value="<%= project.settings&.dig("gradient_end") || "#EC4899" %>" class="input input-bordered input-sm flex-1 font-mono text-sm" placeholder="#EC4899" data-action="input->color-sync#sync">
            </div>
          </div>
        </div>
        <input type="hidden" name="screenshot_project[settings][gradient_direction]" value="<%= project.settings&.dig("gradient_direction") || "to-bottom" %>">
      </div>

      <%# Mesh background options %>
      <div id="form-bg-mesh" class="<%= "hidden" unless _bg_type == "mesh" %>">
        <div class="form-control w-full min-w-0">
          <label class="label px-0">
            <span class="label-text font-medium text-sm">Mesh Preset</span>
          </label>
          <% _mesh_val = project.settings&.dig("mesh_preset") || "sunset"
             _mesh_thumbs = {
               "sunset"   => "linear-gradient(135deg, #FF6B35 0%, #D4145A 50%, #1a0533 100%)",
               "ocean"    => "linear-gradient(135deg, #00B4D8 0%, #0077B6 50%, #023E8A 100%)",
               "aurora"   => "linear-gradient(135deg, #00C9A7 0%, #845EC2 50%, #0B0B1A 100%)",
               "lavender" => "linear-gradient(135deg, #D4A5FF 0%, #9B59B6 50%, #1A1025 100%)",
               "coral"    => "linear-gradient(135deg, #FFC75F 0%, #FF6F61 50%, #1A0A0A 100%)",
               "forest"   => "linear-gradient(135deg, #52B788 0%, #2D6A4F 50%, #0A1A0A 100%)",
               "candy"    => "linear-gradient(135deg, #FF6B9D 0%, #C44DFF 50%, #1A0820 100%)",
               "midnight" => "linear-gradient(135deg, #2D2D7F 0%, #1A1A4E 50%, #050510 100%)",
               "neon"     => "linear-gradient(135deg, #00FF87 0%, #FF00E5 50%, #00D4FF 100%)",
               "peach"    => "linear-gradient(135deg, #FECA57 0%, #FFBE76 50%, #FF9F43 100%)",
               "arctic"   => "linear-gradient(135deg, #81ECEC 0%, #74B9FF 50%, #A29BFE 100%)",
               "ember"    => "linear-gradient(135deg, #E67E22 0%, #E74C3C 50%, #C0392B 100%)"
             } %>
          <input type="hidden" name="screenshot_project[settings][mesh_preset]" value="<%= _mesh_val %>" id="form-mesh-preset-input">
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-2" id="form-mesh-grid">
            <% _mesh_thumbs.each do |key, gradient| %>
              <button type="button"
                      class="w-full aspect-square rounded-lg border-2 cursor-pointer transition-all hover:scale-105 <%= key == _mesh_val ? "border-primary ring-2 ring-primary/30" : "border-base-200" %>"
                      style="background: <%= gradient %>"
                      data-mesh-key="<%= key %>"
                      title="<%= key.titleize %>">
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <%# Pattern background options %>
      <div id="form-bg-pattern" class="<%= "hidden" unless _bg_type == "pattern" %>">
        <div class="space-y-3">
          <div class="form-control w-full min-w-0">
            <label class="label px-0">
              <span class="label-text font-medium text-sm">Pattern</span>
            </label>
            <% _pattern_val = project.settings&.dig("pattern_id") || "dots"
               all_patterns = ScreenshotProject::PATTERN_LIBRARY[:tiles] + ScreenshotProject::PATTERN_LIBRARY[:procedural]
               _pattern_label = all_patterns.find { |p| p[:id] == _pattern_val }&.[](:label) || "Dots" %>
            <details class="dropdown dropdown-top w-full" data-controller="custom-select">
              <input type="hidden" name="screenshot_project[settings][pattern_id]" value="<%= _pattern_val %>" data-custom-select-target="input">
              <summary class="select select-bordered select-sm w-full flex items-center cursor-pointer" data-custom-select-target="label"><%= _pattern_label %></summary>
              <ul class="dropdown-content bg-base-200 rounded-box z-50 w-full p-2 shadow-lg mb-1 flex flex-col gap-1 max-h-60 overflow-y-auto">
                <% all_patterns.each do |pattern| %>
                  <li><a href="#" data-action="click->custom-select#select" data-value="<%= pattern[:id] %>" data-label="<%= pattern[:label] %>" class="<%= 'active' if pattern[:id] == _pattern_val %>"><%= pattern[:label] %></a></li>
                <% end %>
              </ul>
            </details>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="form-control w-full min-w-0">
              <label class="label px-0">
                <span class="label-text font-medium text-sm">Pattern Color</span>
              </label>
              <div class="flex items-center gap-3" data-controller="color-sync">
                <input type="color" name="screenshot_project[settings][pattern_color]" value="<%= project.settings&.dig("pattern_color") || "#FFFFFF" %>" class="w-10 h-10 rounded-lg border border-base-200 cursor-pointer" data-action="input->color-sync#sync">
                <input type="text" value="<%= project.settings&.dig("pattern_color") || "#FFFFFF" %>" class="input input-bordered input-sm flex-1 font-mono text-sm" data-action="input->color-sync#sync">
              </div>
            </div>
            <div class="form-control w-full min-w-0">
              <label class="label px-0">
                <span class="label-text font-medium text-sm">Background Color</span>
              </label>
              <div class="flex items-center gap-3" data-controller="color-sync">
                <input type="color" name="screenshot_project[settings][pattern_bg_color]" value="<%= project.settings&.dig("pattern_bg_color") || "#000000" %>" class="w-10 h-10 rounded-lg border border-base-200 cursor-pointer" data-action="input->color-sync#sync">
                <input type="text" value="<%= project.settings&.dig("pattern_bg_color") || "#000000" %>" class="input input-bordered input-sm flex-1 font-mono text-sm" data-action="input->color-sync#sync">
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Caption Font Family %>
      <div class="form-control w-full min-w-0">
        <label class="label px-0">
          <span class="label-text font-medium flex items-center gap-2 text-sm">
            <i class="fa-solid fa-font text-xs text-base-content/50"></i>
            Caption Font Family
          </span>
        </label>
        <% _font_val = project.settings&.dig("caption_font_family") || "Inter"
           _form_fonts = %w[Inter DM\ Sans Bebas\ Neue Playfair\ Display Anton Urbanist Pacifico JetBrains\ Mono Sora Outfit Plus\ Jakarta\ Sans Crimson\ Text Barlow\ Condensed Caveat Fira\ Code] %>
        <details class="dropdown dropdown-top w-full" data-controller="custom-select">
          <input type="hidden" name="screenshot_project[settings][caption_font_family]" value="<%= _font_val %>" data-custom-select-target="input">
          <summary class="select select-bordered select-sm w-full flex items-center cursor-pointer" data-custom-select-target="label"><%= _font_val %></summary>
          <ul class="dropdown-content bg-base-200 rounded-box z-50 w-full p-2 shadow-lg mb-1 flex flex-col gap-1 max-h-60 overflow-y-auto">
            <% _form_fonts.each do |font| %>
              <li><a href="#" data-action="click->custom-select#select" data-value="<%= font %>" data-label="<%= font %>" class="<%= 'active' if font == _font_val %>" style="font-family: '<%= font %>'"><%= font %></a></li>
            <% end %>
          </ul>
        </details>
      </div>

      <%# Caption Color %>
      <div class="grid md:grid-cols-2 gap-4 sm:gap-5">
        <div class="form-control w-full min-w-0">
          <label class="label px-0">
            <span class="label-text font-medium flex items-center gap-2 text-sm">
              <i class="fa-solid fa-eye-dropper text-xs text-base-content/50"></i>
              Caption Color
            </span>
          </label>
          <div class="flex items-center gap-3" data-controller="color-sync">
            <input type="color" name="screenshot_project[settings][caption_color]" value="<%= project.settings&.dig("caption_color") || "#FFFFFF" %>" class="w-10 h-10 rounded-lg border border-base-200 cursor-pointer" data-action="input->color-sync#sync">
            <input type="text" value="<%= project.settings&.dig("caption_color") || "#FFFFFF" %>" class="input input-bordered input-sm flex-1 font-mono text-sm" placeholder="#FFFFFF" data-action="input->color-sync#sync">
          </div>
        </div>

      </div>

      <%# Device Frame %>
      <div class="form-control w-full min-w-0">
        <label class="label px-0">
          <span class="label-text font-medium flex items-center gap-2 text-sm">
            <i class="fa-solid fa-mobile-screen text-xs text-base-content/50"></i>
            Device Frame
          </span>
        </label>
        <% df_val = project.settings&.dig("device_frame") || "none"
           df_options = ScreenshotProject::DEVICE_FRAMES.reject { |k, f|
             (project.platform == "ios" && f[:platform] == "android") ||
             (project.platform == "android" && f[:platform] == "ios")
           }
           df_label = df_options[df_val]&.[](:label) || "No Frame" %>
        <details class="dropdown dropdown-top w-full" data-controller="custom-select">
          <input type="hidden" name="screenshot_project[settings][device_frame]" value="<%= df_val %>" data-custom-select-target="input">
          <summary class="select select-bordered select-sm w-full flex items-center cursor-pointer" data-custom-select-target="label"><%= df_label %></summary>
          <ul class="dropdown-content bg-base-200 rounded-box z-50 w-full p-2 shadow-lg mb-1 flex flex-col gap-1 max-h-60 overflow-y-auto">
            <% df_options.each do |key, frame| %>
              <li><a href="#" data-action="click->custom-select#select" data-value="<%= key %>" data-label="<%= frame[:label] %>" class="<%= 'active' if key == df_val %>"><%= frame[:label] %></a></li>
            <% end %>
          </ul>
        </details>
      </div>
    </div>
  </div>

  <div class="divider my-0"></div>

  <%# Step 5: Locales (only shown for existing projects) %>
  <% if project.persisted? %>
    <div class="space-y-4">
      <div class="flex items-center gap-3 mb-2 sm:mb-4">
        <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-primary-content font-bold text-xs sm:text-sm shrink-0">5</div>
        <h2 class="text-base sm:text-lg font-bold">Locales</h2>
      </div>
      <p class="text-xs text-base-content/50">Select locales for multi-language screenshot captions. The first locale is the default.</p>

      <div class="bg-base-200/30 p-3 sm:p-5 rounded-xl border border-base-200 max-h-64 overflow-y-auto">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
          <% ScreenshotProject::APP_STORE_LOCALES.each do |locale| %>
            <label class="flex items-center gap-2 cursor-pointer text-sm p-1.5 rounded-lg hover:bg-base-200 transition-colors">
              <input type="checkbox" name="screenshot_project[locales][]" value="<%= locale %>"
                     class="checkbox checkbox-primary checkbox-xs"
                     <%= "checked" if project.locales&.include?(locale) %>>
              <span class="truncate"><%= locale %></span>
            </label>
          <% end %>
        </div>
      </div>
      <%# Hidden empty value so unchecking all sends empty array %>
      <input type="hidden" name="screenshot_project[locales][]" value="">
    </div>
  <% end %>

  <%# Submit Section %>
  <div class="flex flex-col gap-3 pt-4 sm:pt-6 border-t border-base-200">
    <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <p class="text-xs text-base-content/50 flex items-center gap-2 justify-center sm:justify-start">
        <i class="fa-solid fa-images text-violet-500 shrink-0"></i>
        <span>You can adjust all settings later in the editor</span>
      </p>
      <div class="flex items-center gap-2 sm:gap-3">
        <%= link_to "Cancel", organization_screenshot_projects_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md flex-1 sm:flex-initial" %>
        <%= f.submit project.persisted? ? "Save Changes" : "Create Project", class: "btn btn-primary btn-sm sm:btn-md gap-2 px-4 sm:px-6 flex-1 sm:flex-initial" %>
      </div>
    </div>
  </div>
<% end %>

<script>
  (function() {
    function initFormInteractions() {
      // Template toggle
      var radios = document.querySelectorAll("[data-template-radio]");
      var fields = document.getElementById("default-appearance-fields");
      var hint = document.getElementById("template-hint");
      if (!radios.length || !fields) return;

      radios.forEach(function(radio) {
        radio.addEventListener("change", function() {
          var isCustom = this.value === "";
          fields.classList.toggle("opacity-40", !isCustom);
          fields.classList.toggle("pointer-events-none", !isCustom);
          if (hint) hint.classList.toggle("hidden", isCustom);
        });
      });

      // Background type switching
      var bgTypeInput = document.getElementById("form-bg-type-input");
      var bgTypeBtns = document.querySelectorAll("#form-bg-type-selector .bg-type-btn");
      var bgPanels = {
        solid: document.getElementById("form-bg-solid"),
        gradient: document.getElementById("form-bg-gradient"),
        mesh: document.getElementById("form-bg-mesh"),
        pattern: document.getElementById("form-bg-pattern")
      };

      bgTypeBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
          var type = this.getAttribute("data-bg-type");
          bgTypeInput.value = type;
          bgTypeBtns.forEach(function(b) { b.classList.remove("active"); });
          this.classList.add("active");
          Object.keys(bgPanels).forEach(function(k) {
            if (bgPanels[k]) bgPanels[k].classList.toggle("hidden", k !== type);
          });
        });
      });

      // Mesh preset selection
      var meshInput = document.getElementById("form-mesh-preset-input");
      var meshBtns = document.querySelectorAll("#form-mesh-grid button[data-mesh-key]");
      meshBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
          var key = this.getAttribute("data-mesh-key");
          meshInput.value = key;
          meshBtns.forEach(function(b) {
            b.classList.remove("border-primary", "ring-2", "ring-primary/30");
            b.classList.add("border-base-200");
          });
          this.classList.remove("border-base-200");
          this.classList.add("border-primary", "ring-2", "ring-primary/30");
        });
      });
    }

    // Run immediately (elements already exist above this script)
    initFormInteractions();
    // Also re-run on Turbo navigations
    document.addEventListener("turbo:load", initFormInteractions);
  })();
</script>
