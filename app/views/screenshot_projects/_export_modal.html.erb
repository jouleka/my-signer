<%# locals: (project:) %>
<dialog id="export_modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-2xl" data-screenshot-export-target="modal">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500/20 to-fuchsia-500/20 flex items-center justify-center">
        <i class="fa-solid fa-download text-violet-600"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold">Export Screenshots</h3>
        <p class="text-sm text-base-content/60">Select sizes to export as a ZIP file</p>
      </div>
    </div>

    <% if project.platform != "android" %>
      <div class="space-y-3 mb-4">
        <h4 class="font-semibold text-sm flex items-center gap-2">
          <i class="fa-brands fa-apple"></i>
          iOS App Store
        </h4>
        <div class="bg-base-200/30 rounded-xl p-3 space-y-2 border border-base-200">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" data-screenshot-export-target="sizeCheckbox" data-preset="ios_required" checked data-action="change->screenshot-export#syncExportButton">
            <div>
              <span class="text-sm font-medium">Required Sizes</span>
              <span class="text-xs text-base-content/50 block">6.9" (1320x2868), 6.7" (1290x2796), 6.5" (1242x2688)</span>
            </div>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" data-screenshot-export-target="sizeCheckbox" data-preset="ios_optional" data-action="change->screenshot-export#syncExportButton">
            <div>
              <span class="text-sm font-medium">iPhone 5.5"</span>
              <span class="text-xs text-base-content/50 block">1242x2208</span>
            </div>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" data-screenshot-export-target="sizeCheckbox" data-preset="ios_ipad" data-action="change->screenshot-export#syncExportButton">
            <div>
              <span class="text-sm font-medium">iPad Sizes</span>
              <span class="text-xs text-base-content/50 block">12.9" (2048x2732), 11" (1668x2388)</span>
            </div>
          </label>
        </div>
      </div>
    <% end %>

    <% if project.platform != "ios" %>
      <div class="space-y-3 mb-4">
        <h4 class="font-semibold text-sm flex items-center gap-2">
          <i class="fa-brands fa-android"></i>
          Google Play
        </h4>
        <div class="bg-base-200/30 rounded-xl p-3 space-y-2 border border-base-200">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" data-screenshot-export-target="sizeCheckbox" data-preset="android_phone" checked data-action="change->screenshot-export#syncExportButton">
            <div>
              <span class="text-sm font-medium">Phone</span>
              <span class="text-xs text-base-content/50 block">1080x1920</span>
            </div>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" data-screenshot-export-target="sizeCheckbox" data-preset="android_tablet_7" data-action="change->screenshot-export#syncExportButton">
            <div>
              <span class="text-sm font-medium">7" Tablet</span>
              <span class="text-xs text-base-content/50 block">1200x1920</span>
            </div>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" data-screenshot-export-target="sizeCheckbox" data-preset="android_tablet_10" data-action="change->screenshot-export#syncExportButton">
            <div>
              <span class="text-sm font-medium">10" Tablet</span>
              <span class="text-xs text-base-content/50 block">1600x2560</span>
            </div>
          </label>
        </div>
      </div>
    <% end %>

    <%# Locale selection (multi-locale only) %>
    <% if project.multi_locale? %>
      <div class="space-y-3 mb-4">
        <h4 class="font-semibold text-sm flex items-center gap-2">
          <i class="fa-solid fa-language"></i>
          Locales
        </h4>
        <div class="bg-base-200/30 rounded-xl p-3 border border-base-200">
          <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
            <% project.locales.each do |locale| %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="checkbox checkbox-primary checkbox-sm"
                       data-screenshot-export-target="localeCheckbox"
                       data-locale="<%= locale %>" checked>
                <span class="text-sm"><%= locale %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Export format options %>
    <div class="space-y-3 mb-4">
      <h4 class="font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-folder-tree"></i>
        Folder Structure
      </h4>
      <div class="bg-base-200/30 rounded-xl p-3 border border-base-200">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" class="toggle toggle-primary toggle-sm"
                 data-screenshot-export-target="fastlaneToggle">
          <div>
            <span class="text-sm font-medium">Fastlane layout</span>
            <span class="text-xs text-base-content/50 block">
              Organizes as <code class="text-xs">screenshots/{locale}/screenshot_01.png</code> for fastlane deliver
            </span>
          </div>
        </label>
      </div>
    </div>

    <%# Progress bar (hidden by default) %>
    <div class="hidden" data-screenshot-export-target="progressContainer">
      <div class="flex items-center gap-3 mb-2">
        <span class="loading loading-spinner loading-sm text-primary"></span>
        <span class="text-sm font-medium" data-screenshot-export-target="progressText">Exporting...</span>
      </div>
      <progress class="progress progress-primary w-full" value="0" max="100" data-screenshot-export-target="progressBar"></progress>
    </div>

    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-ghost">Cancel</button>
      </form>
      <button class="btn btn-primary gap-2" data-action="click->screenshot-export#startExport" data-screenshot-export-target="exportButton">
        <i class="fa-solid fa-download"></i>
        Export ZIP
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
