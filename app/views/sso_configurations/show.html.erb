<%= breadcrumbs([
  { label: @organization.name, path: organization_path(@organization) },
  { label: "SSO" }
]) %>

<section class="flex flex-col gap-5">
  <%# ═══════════════════════════════════════════════════════ %>
  <%# PAGE HEADER                                              %>
  <%# ═══════════════════════════════════════════════════════ %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-[1.375rem] font-extrabold leading-tight tracking-[-0.02em] text-base-content/95">
        <i class="fa-solid fa-id-card-clip text-primary/50 mr-1"></i>
        Single Sign-On
      </h1>
      <p class="text-xs text-base-content/40 mt-1">
        <% if @config&.enabled? %>
          SSO is live for <strong class="text-base-content/60"><%= @organization.name %></strong>.
        <% else %>
          Configure SAML 2.0 SSO with Okta, Microsoft Entra ID, Google Workspace, or any SAML-compatible IdP.
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <% if @config.present? %>
        <%# Test SSO: opens the live flow in a new tab so the admin's own
            session isn't disrupted. Works whether SSO is enabled or not
            (routed via /auth/sso?slug=X which checks enabled state itself). %>
        <% if @config.enabled? %>
          <%= link_to sso_initiation_path(slug: @organization.slug),
              target: "_blank",
              rel: "noopener",
              class: btn_accent_sm_classes do %>
            <i class="fa-solid fa-flask"></i> Test SSO login
          <% end %>
        <% end %>
        <%= link_to edit_organization_sso_configuration_path(@organization), class: btn_ghost_sm_classes do %>
          <i class="fa-solid fa-pen"></i> Edit
        <% end %>
        <%= button_to organization_sso_configuration_path(@organization),
            method: :delete,
            data: { turbo_confirm: "Remove SSO configuration? Your team will need to sign in with passwords until SSO is reconfigured." },
            form_class: "inline",
            class: btn_destructive_sm_classes do %>
          <i class="fa-solid fa-trash"></i> Remove
        <% end %>
      <% else %>
        <%= link_to new_organization_sso_configuration_path(@organization), class: btn_primary_sm_classes do %>
          <i class="fa-solid fa-plus"></i> Configure SSO
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ═══════════════════════════════════════════════════════ %>
  <%# STATUS ROW                                               %>
  <%# ═══════════════════════════════════════════════════════ %>
  <% if @config.present? %>
    <% enforcement_warning = @config.enforced? && !@config.enabled? %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <%# Enabled/disabled card %>
      <div class="<%= card_container_classes %>">
        <div class="<%= card_body_classes %> py-4">
          <div class="<%= label_uppercase_classes %>">Status</div>
          <div class="mt-2 flex items-center gap-2">
            <% if @config.enabled? %>
              <span class="inline-flex w-2 h-2 rounded-full bg-success animate-pulse"></span>
              <span class="text-sm font-semibold text-success">Enabled</span>
            <% else %>
              <span class="inline-flex w-2 h-2 rounded-full bg-base-content/30"></span>
              <span class="text-sm font-semibold text-base-content/55">Disabled</span>
            <% end %>
          </div>
        </div>
      </div>

      <%# Enforcement card %>
      <div class="<%= card_container_classes %>">
        <div class="<%= card_body_classes %> py-4">
          <div class="<%= label_uppercase_classes %>">Enforcement</div>
          <div class="mt-2 flex items-center gap-2">
            <% if @config.enforced? %>
              <i class="fa-solid fa-lock text-warning text-xs"></i>
              <span class="text-sm font-semibold text-warning">SSO required</span>
            <% else %>
              <i class="fa-solid fa-lock-open text-base-content/40 text-xs"></i>
              <span class="text-sm font-semibold text-base-content/55">Optional</span>
            <% end %>
          </div>
        </div>
      </div>

      <%# JIT role card %>
      <div class="<%= card_container_classes %>">
        <div class="<%= card_body_classes %> py-4">
          <div class="<%= label_uppercase_classes %>">New-user role</div>
          <div class="mt-2 text-sm font-semibold text-base-content/85">
            <%= @config.jit_default_role.to_s.titleize %>
          </div>
        </div>
      </div>
    </div>

    <% if enforcement_warning %>
      <div class="<%= sn_warning_classes %>">
        <div class="flex items-start gap-2.5 p-1.5">
          <div class="<%= sn_icon_warning_classes %>"><i class="fa-solid fa-triangle-exclamation text-[0.6rem]"></i></div>
          <div class="text-xs text-warning/90 leading-relaxed">
            <strong>Inconsistent state:</strong> enforcement is on but SSO itself is disabled.
            Either enable SSO or turn off enforcement — right now members would be blocked from
            both SSO and password login.
            <%= link_to edit_organization_sso_configuration_path(@organization),
                class: "underline font-semibold ml-1" do %>Fix this<% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# ═══════════════════════════════════════════════════════ %>
  <%# CONFIG DETAIL TWO-COLUMN                                 %>
  <%# ═══════════════════════════════════════════════════════ %>
  <% if @config.present? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
      <%# IdP details (what the admin entered) %>
      <div class="<%= card_container_classes %>">
        <div class="<%= card_header_classes %>">
          <div class="<%= card_icon_classes %>"><i class="fa-solid fa-sitemap"></i></div>
          <span class="<%= card_title_classes %>">Identity provider</span>
        </div>
        <div class="<%= card_body_classes %> space-y-4">
          <div>
            <div class="<%= label_uppercase_classes %>">IdP Entity ID</div>
            <div class="mt-1 text-xs font-mono text-base-content/75 break-all p-2 rounded-md bg-base-content/[0.03] border border-base-content/[0.04]">
              <%= @config.idp_entity_id %>
            </div>
          </div>
          <div>
            <div class="<%= label_uppercase_classes %>">IdP SSO URL</div>
            <div class="mt-1 text-xs font-mono text-base-content/75 break-all p-2 rounded-md bg-base-content/[0.03] border border-base-content/[0.04]">
              <%= @config.idp_sso_target_url %>
            </div>
          </div>
          <% if @config.idp_slo_target_url.present? %>
            <div>
              <div class="<%= label_uppercase_classes %>">IdP SLO URL</div>
              <div class="mt-1 text-xs font-mono text-base-content/75 break-all p-2 rounded-md bg-base-content/[0.03] border border-base-content/[0.04]">
                <%= @config.idp_slo_target_url %>
              </div>
            </div>
          <% end %>
          <div>
            <div class="<%= label_uppercase_classes %>">x509 Certificate</div>
            <div class="mt-1 flex items-center gap-2 p-2 rounded-md bg-success/[0.06] border border-success/15">
              <i class="fa-solid fa-circle-check text-success text-xs"></i>
              <span class="text-xs text-success/85 font-medium">Certificate on file (encrypted at rest)</span>
            </div>
          </div>
        </div>
      </div>

      <%# SP details (what we give the IdP) %>
      <div class="<%= card_container_classes %>">
        <div class="<%= card_header_classes %>">
          <div class="<%= card_icon_classes %>"><i class="fa-solid fa-arrow-right-from-bracket"></i></div>
          <span class="<%= card_title_classes %>">Service provider (MySigner)</span>
        </div>
        <div class="<%= card_body_classes %> space-y-4">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="<%= label_uppercase_classes %>">SP Entity ID / Metadata URL</span>
              <button type="button"
                      class="<%= icon_btn_sm_classes %>"
                      data-controller="clipboard"
                      data-clipboard-content-value="<%= @config.sp_entity_id %>"
                      data-action="click->clipboard#copy"
                      title="Copy">
                <i class="fa-solid fa-copy text-[0.65rem]"></i>
              </button>
            </div>
            <div class="mt-1 text-xs font-mono text-base-content/75 break-all p-2 rounded-md bg-base-content/[0.03] border border-base-content/[0.04]">
              <%= @config.sp_entity_id %>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="<%= label_uppercase_classes %>">Assertion Consumer Service (ACS)</span>
              <button type="button"
                      class="<%= icon_btn_sm_classes %>"
                      data-controller="clipboard"
                      data-clipboard-content-value="<%= @config.acs_url %>"
                      data-action="click->clipboard#copy"
                      title="Copy">
                <i class="fa-solid fa-copy text-[0.65rem]"></i>
              </button>
            </div>
            <div class="mt-1 text-xs font-mono text-base-content/75 break-all p-2 rounded-md bg-base-content/[0.03] border border-base-content/[0.04]">
              <%= @config.acs_url %>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="<%= label_uppercase_classes %>">Test URL</span>
              <button type="button"
                      class="<%= icon_btn_sm_classes %>"
                      data-controller="clipboard"
                      data-clipboard-content-value="<%= sso_initiation_url(slug: @organization.slug) %>"
                      data-action="click->clipboard#copy"
                      title="Copy">
                <i class="fa-solid fa-copy text-[0.65rem]"></i>
              </button>
            </div>
            <div class="mt-1 text-xs font-mono text-base-content/75 break-all p-2 rounded-md bg-base-content/[0.03] border border-base-content/[0.04]">
              <%= sso_initiation_url(slug: @organization.slug) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ═══════════════════════════════════════════════════════ %>
  <%# EMPTY STATE (no config yet)                              %>
  <%# ═══════════════════════════════════════════════════════ %>
  <% if @config.blank? %>
    <div class="<%= card_container_classes %>">
      <div class="<%= card_body_classes %> py-10">
        <div class="max-w-xl mx-auto text-center space-y-4">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary/10 border border-primary/15">
            <i class="fa-solid fa-id-card-clip text-primary text-xl"></i>
          </div>
          <h2 class="text-lg font-extrabold tracking-[-0.01em] text-base-content/90">No SSO configured yet</h2>
          <p class="text-sm text-base-content/55 leading-relaxed">
            Set up SAML 2.0 with your identity provider so your team signs in through Okta,
            Microsoft Entra ID, Google Workspace, or any SAML 2.0-compatible IdP.
            We'll walk you through the config and give you everything your IdP needs.
          </p>
          <div class="flex items-center justify-center gap-2 pt-1">
            <%= link_to new_organization_sso_configuration_path(@organization), class: btn_primary_classes do %>
              <i class="fa-solid fa-plus"></i> Configure SSO
            <% end %>
            <a href="/docs/sso-setup-guide" target="_blank" class="btn btn-ghost gap-1.5 text-sm">
              <i class="fa-solid fa-book-open text-xs"></i> Read the setup guide
            </a>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>
