<%= breadcrumbs([
  { label: @organization.name, path: organization_path(@organization) },
  { label: "SSO", path: organization_sso_configuration_path(@organization) },
  { label: "Edit" }
]) %>

<section class="flex flex-col gap-5">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-[1.375rem] font-extrabold leading-tight tracking-[-0.02em] text-base-content/95">
        <i class="fa-solid fa-id-card-clip text-primary/50 mr-1"></i>
        Edit SSO Configuration
      </h1>
      <p class="text-xs text-base-content/40 mt-1">
        Update your IdP details. Changes take effect on the next sign-in; existing sessions stay valid.
      </p>
    </div>
  </div>

  <%= render "form" %>
</section>
