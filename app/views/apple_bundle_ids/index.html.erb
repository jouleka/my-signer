<%= render "shared/ios_breadcrumbs", organization: @organization, active_tab: :bundle_ids %>

<section class="space-y-4 sm:space-y-6 min-w-0 w-full overflow-hidden">
  <%= render "shared/page_header",
             title: "Bundle IDs",
             description: "Manage your app identifiers and capabilities. Register new bundle IDs and configure entitlements.",
             gradient: "from-purple-500/10 via-base-100 to-indigo-500/10",
             badge_icon: "fa-solid fa-fingerprint",
             badge_text: "App Identifiers",
             stats: (capture do %>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">Total</div>
          <div class="stat-value text-xl sm:text-2xl"><%= @total_bundle_ids %></div>
          <div class="stat-desc">bundle IDs</div>
        </div>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">With Capabilities</div>
          <div class="stat-value text-xl sm:text-2xl text-success"><%= @with_capabilities %></div>
          <div class="stat-desc">configured</div>
        </div>
        <% if @q_platform.present? || @q_query.present? %>
          <div class="stat py-2 px-3 sm:py-3 sm:px-5">
            <div class="stat-title text-xs">Filtered</div>
            <div class="stat-value text-xl sm:text-2xl text-accent"><%= @bundle_ids.size %></div>
            <div class="stat-desc">showing</div>
          </div>
        <% end %>
             <% end),
             actions: (capture do %>
      <%= link_to new_organization_apple_bundle_id_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-plus"></i>
        <span class="hidden sm:inline">Register Bundle ID</span>
        <span class="sm:hidden">Register</span>
      <% end %>
      <%= link_to organization_apple_apps_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="hidden sm:inline">Back to Apps</span>
        <span class="sm:hidden">Back</span>
      <% end %>
             <% end) %>

  <%= render "shared/content_card",
             filter_class: "lg:flex-row lg:items-end",
             filter: (capture do %>
    <%= form_with url: organization_apple_bundle_ids_path(@organization), method: :get, local: true, class: "flex flex-col sm:flex-row gap-3 sm:gap-4 flex-1 min-w-0" do %>
      <div class="form-control flex-1 min-w-0 sm:max-w-[160px]">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-mobile-screen text-[10px] text-base-content/50"></i>
            Platform
          </span>
        </label>
        <%= render "shared/custom_select", name: "platform", options: [["All platforms", ""]] + @platforms.map { |p| [p, p] }, selected: @q_platform.to_s %>
      </div>
      <div class="form-control flex-1 min-w-0 sm:max-w-xs">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-magnifying-glass text-[10px] text-base-content/50"></i>
            Search
          </span>
        </label>
        <input type="text" name="q" value="<%= @q_query %>" placeholder="Identifier or name..." class="input input-bordered input-sm w-full" autocomplete="off">
      </div>
      <div class="flex items-end gap-2">
        <button class="btn btn-primary btn-sm gap-2" type="submit">
          <i class="fa-solid fa-filter"></i>
          Apply
        </button>
        <% if @q_platform.present? || @q_query.present? %>
          <%= link_to organization_apple_bundle_ids_path(@organization), class: "btn btn-ghost btn-sm gap-2" do %>
            <i class="fa-solid fa-xmark"></i>
            Clear
          <% end %>
        <% end %>
      </div>
    <% end %>
             <% end) do %>

    <% if @bundle_ids.any? %>
      <%# Desktop Table %>
      <div class="hidden lg:block">
        <div class="overflow-x-auto rounded-2xl border border-base-200">
          <table class="table">
            <thead>
              <tr class="bg-base-200/50 text-xs uppercase text-base-content/60 font-bold tracking-wider">
                <th>Bundle ID</th>
                <th>Team</th>
                <th>Platform</th>
                <th>Capabilities</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @bundle_ids.each do |b| %>
                <tr class="hover:bg-base-200/30 transition-colors">
                  <td>
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500/20 to-indigo-500/20 flex items-center justify-center">
                        <i class="fa-solid <%= b.platform_icon %> text-purple-600"></i>
                      </div>
                      <div>
                        <div class="font-semibold"><%= b.name %></div>
                        <code class="text-xs text-base-content/60"><%= b.identifier %></code>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if b.team_id.present? %>
                      <code class="text-xs bg-base-200 px-2 py-0.5 rounded"><%= b.team_id %></code>
                    <% else %>
                      <span class="text-base-content/30">-</span>
                    <% end %>
                  </td>
                  <td>
                    <span class="badge badge-outline badge-sm gap-1.5">
                      <% if b.platform == "IOS" %>
                        <i class="fa-brands fa-apple text-[10px]"></i>
                      <% elsif b.platform == "MAC_OS" %>
                        <i class="fa-solid fa-laptop text-[10px]"></i>
                      <% else %>
                        <i class="fa-solid fa-layer-group text-[10px]"></i>
                      <% end %>
                      <%= b.platform %>
                    </span>
                  </td>
                  <td>
                    <% cap_count = b.apple_bundle_id_capabilities.size %>
                    <% if cap_count > 0 %>
                      <span class="badge badge-success gap-1.5">
                        <i class="fa-solid fa-puzzle-piece text-[10px]"></i>
                        <%= cap_count %> <%= "capability".pluralize(cap_count) %>
                      </span>
                    <% else %>
                      <span class="badge badge-ghost badge-sm">None</span>
                    <% end %>
                  </td>
                  <td class="text-right">
                    <div class="flex items-center justify-end gap-1">
                      <%= link_to organization_apple_bundle_id_path(@organization, b), class: "btn btn-ghost btn-xs gap-1.5" do %>
                        <i class="fa-solid fa-eye"></i>
                        View
                      <% end %>
                      <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                              data-controller="copy"
                              data-action="click->copy#copy"
                              data-copy-text-value="<%= b.identifier %>">
                        <i class="fa-solid fa-copy"></i>
                      </button>
                      <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                              data-controller="raw-json"
                              data-action="click->raw-json#show"
                              data-raw-json-content-value="<%= b.raw_json %>"
                              data-raw-json-title-value="Bundle ID: <%= b.identifier %>">
                        <i class="fa-solid fa-code"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%# Mobile Cards %>
      <div class="lg:hidden space-y-3">
        <% @bundle_ids.each do |b| %>
          <div class="card border border-base-200 shadow-sm overflow-hidden">
            <div class="card-body p-3 sm:p-4 space-y-3 min-w-0">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-indigo-500/20 flex items-center justify-center shrink-0">
                  <i class="fa-solid <%= b.platform_icon %> text-purple-600 sm:text-lg"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-semibold text-sm sm:text-base truncate"><%= b.name %></div>
                  <code class="text-xs text-base-content/60 truncate block"><%= b.identifier %></code>
                </div>
                <span class="badge badge-outline badge-sm shrink-0"><%= b.platform %></span>
              </div>

              <div class="grid gap-2 text-sm bg-base-200/50 rounded-xl p-2 sm:p-3">
                <% if b.team_id.present? %>
                  <div class="flex justify-between items-center">
                    <span class="text-base-content/60 text-xs">Team</span>
                    <code class="text-xs"><%= b.team_id %></code>
                  </div>
                <% end %>
                <div class="flex justify-between items-center">
                  <span class="text-base-content/60 text-xs">Capabilities</span>
                  <% cap_count = b.apple_bundle_id_capabilities.size %>
                  <% if cap_count > 0 %>
                    <span class="badge badge-success badge-sm"><%= cap_count %></span>
                  <% else %>
                    <span class="text-xs text-base-content/50">None</span>
                  <% end %>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 sm:gap-2">
                <%= link_to organization_apple_bundle_id_path(@organization, b), class: "btn btn-primary btn-xs gap-1.5" do %>
                  <i class="fa-solid fa-eye"></i>
                  View
                <% end %>
                <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                        data-controller="copy"
                        data-action="click->copy#copy"
                        data-copy-text-value="<%= b.identifier %>">
                  <i class="fa-solid fa-copy"></i>
                  Copy
                </button>
                <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                        data-controller="raw-json"
                        data-action="click->raw-json#show"
                        data-raw-json-content-value="<%= b.raw_json %>"
                        data-raw-json-title-value="Bundle ID: <%= b.identifier %>">
                  <i class="fa-solid fa-code"></i>
                  JSON
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="flex flex-col items-center justify-center py-10 sm:py-16 text-center px-2">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-purple-500/20 to-indigo-500/20 flex items-center justify-center mb-4">
          <i class="fa-solid fa-fingerprint text-2xl sm:text-3xl text-purple-500/50"></i>
        </div>
        <h3 class="text-lg sm:text-xl font-bold">No Bundle IDs Found</h3>
        <p class="text-base-content/60 max-w-sm mt-2 mb-6 text-sm break-words">
          <% if @q_platform.present? || @q_query.present? %>
            No bundle IDs match the current filters. Try adjusting your search criteria.
          <% else %>
            Sync your App Store Connect data or register a new bundle ID to get started.
          <% end %>
        </p>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          <% if @q_platform.present? || @q_query.present? %>
            <%= link_to organization_apple_bundle_ids_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
              <i class="fa-solid fa-xmark"></i>
              Clear Filters
            <% end %>
          <% end %>
          <%= link_to new_organization_apple_bundle_id_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
            <i class="fa-solid fa-plus"></i>
            <span class="hidden sm:inline">Register Bundle ID</span>
            <span class="sm:hidden">Register</span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>

