<%= render "shared/ios_breadcrumbs", organization: @organization, active_tab: :devices %>

<% total_devices = @organization.apple_devices.count %>
<% enabled_devices = @organization.apple_devices.where(status: "ENABLED").count %>

<section class="space-y-4 sm:space-y-6 min-w-0 w-full overflow-hidden" data-controller="rename-device" data-rename-device-base-url-value="<%= organization_apple_devices_path(@organization) %>">
  <%= render "shared/page_header",
             title: "Apple Devices",
             description: "Manage UDIDs for development and ad-hoc distribution. Register new devices without leaving MySigner.",
             gradient: "from-cyan-500/10 via-base-100 to-teal-500/10",
             badge_icon: "fa-solid fa-mobile-screen-button",
             badge_text: "Test Devices",
             stats: (capture do %>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">Total</div>
          <div class="stat-value text-xl sm:text-2xl"><%= total_devices %></div>
          <div class="stat-desc">devices</div>
        </div>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">Enabled</div>
          <div class="stat-value text-xl sm:text-2xl text-success"><%= enabled_devices %></div>
          <div class="stat-desc">active</div>
        </div>
        <% if @q_platform.present? || @q_status.present? || @q_query.present? %>
          <div class="stat py-2 px-3 sm:py-3 sm:px-5">
            <div class="stat-title text-xs">Filtered</div>
            <div class="stat-value text-xl sm:text-2xl text-accent"><%= @devices.size %></div>
            <div class="stat-desc">showing</div>
          </div>
        <% end %>
             <% end),
             actions: (capture do %>
      <button class="btn btn-primary btn-sm sm:btn-md gap-2" data-controller="modal" data-action="click->modal#open" data-modal-target-value="register-device-modal">
        <i class="fa-solid fa-plus"></i>
        <span class="hidden sm:inline">Register Device</span>
        <span class="sm:hidden">Register</span>
      </button>
      <%= link_to organization_apple_devices_path(@organization, format: :csv, platform: @q_platform, status: @q_status, q: @q_query), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-file-csv"></i>
        <span class="hidden sm:inline">Export CSV</span>
        <span class="sm:hidden">CSV</span>
      <% end %>
      <%= link_to organization_apple_apps_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="hidden sm:inline">Back to Apps</span>
        <span class="sm:hidden">Back</span>
      <% end %>
             <% end) %>

  <%# Devices Card %>
  <%= render "shared/content_card",
             filter_class: "lg:flex-row lg:items-end",
             filter: (capture do %>
    <%= form_with url: organization_apple_devices_path(@organization), method: :get, local: true, class: "flex flex-col sm:flex-row gap-3 sm:gap-4 flex-1 min-w-0" do %>
      <div class="form-control flex-1 min-w-0 sm:max-w-[160px]">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-mobile-screen text-[10px] text-base-content/50"></i>
            Platform
          </span>
        </label>
        <%= render "shared/custom_select", name: "platform", options: [["All platforms", ""]] + @platforms.map { |p| [p, p] }, selected: @q_platform.to_s %>
      </div>
      <div class="form-control flex-1 min-w-0 sm:max-w-[160px]">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-toggle-on text-[10px] text-base-content/50"></i>
            Status
          </span>
        </label>
        <%= render "shared/custom_select", name: "status", options: [["All statuses", ""]] + @statuses.map { |s| [s, s] }, selected: @q_status.to_s %>
      </div>
      <div class="form-control flex-1 min-w-0 sm:max-w-xs">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-magnifying-glass text-[10px] text-base-content/50"></i>
            Search
          </span>
        </label>
        <input type="text" name="q" value="<%= @q_query %>" placeholder="Name or UDID..." class="input input-bordered input-sm w-full" autocomplete="off" />
      </div>
      <div class="flex items-end gap-2">
        <button class="btn btn-primary btn-sm gap-2" type="submit">
          <i class="fa-solid fa-filter"></i>
          Apply
        </button>
        <% if @q_platform.present? || @q_status.present? || @q_query.present? %>
          <%= link_to organization_apple_devices_path(@organization), class: "btn btn-ghost btn-sm gap-2" do %>
            <i class="fa-solid fa-xmark"></i>
            Clear
          <% end %>
        <% end %>
      </div>
    <% end %>
             <% end) do %>

    <% if @devices.any? %>
        <%# Desktop Table %>
        <div class="hidden lg:block">
          <div class="overflow-x-auto rounded-2xl border border-base-200">
            <table class="table">
              <thead>
                <tr class="bg-base-200/50 text-xs uppercase text-base-content/60 font-bold tracking-wider">
                  <th>Device</th>
                  <th>UDID</th>
                  <th>Platform</th>
                  <th>Class</th>
                  <th>Status</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @devices.each do |d| %>
                  <% 
                    model = JSON.parse(d.raw_json)["attributes"]["model"] rescue nil
                    device_icon = case d.device_class
                      when "IPHONE" then "fa-mobile-screen"
                      when "IPAD" then "fa-tablet-screen-button"
                      when "APPLE_WATCH" then "fa-clock"
                      when "APPLE_TV" then "fa-tv"
                      when "MAC" then "fa-laptop"
                      else "fa-microchip"
                    end
                  %>
                  <tr class="hover:bg-base-200/30 transition-colors">
                    <td>
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500/20 to-teal-500/20 flex items-center justify-center">
                          <i class="fa-solid <%= device_icon %> text-cyan-600"></i>
                        </div>
                        <div>
                          <div class="font-semibold"><%= d.name %></div>
                          <% if model.present? %>
                            <div class="text-xs text-base-content/50"><%= model %></div>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="flex items-center gap-2">
                        <code class="text-xs bg-base-200 px-2 py-0.5 rounded"><%= d.udid.truncate(20) %></code>
                        <button type="button" class="btn btn-ghost btn-xs btn-square"
                                data-controller="copy"
                                data-action="click->copy#copy"
                                data-copy-text-value="<%= d.udid %>">
                          <i class="fa-solid fa-copy text-base-content/50"></i>
                        </button>
                      </div>
                    </td>
                    <td>
                      <span class="badge badge-outline badge-sm gap-1.5">
                        <% if d.platform == "IOS" %>
                          <i class="fa-brands fa-apple text-[10px]"></i>
                        <% elsif d.platform == "MAC_OS" %>
                          <i class="fa-solid fa-laptop text-[10px]"></i>
                        <% else %>
                          <i class="fa-solid fa-tv text-[10px]"></i>
                        <% end %>
                        <%= d.platform %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-ghost badge-sm"><%= d.device_class %></span>
                    </td>
                    <td>
                      <div class="flex items-center gap-2">
                        <% if d.status == "ENABLED" %>
                          <span class="badge badge-success gap-1.5">
                            <i class="fa-solid fa-check text-[10px]"></i>
                            Enabled
                          </span>
                        <% else %>
                          <span class="badge badge-error gap-1.5">
                            <i class="fa-solid fa-xmark text-[10px]"></i>
                            Disabled
                          </span>
                        <% end %>
                      </div>
                    </td>
                    <td class="text-right">
                      <div class="flex items-center justify-end gap-1">
                        <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                                data-action="click->rename-device#showModal"
                                data-device-id="<%= d.id %>"
                                data-device-name="<%= d.name %>">
                          <i class="fa-solid fa-pen"></i>
                          Rename
                        </button>
                        <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                                data-controller="raw-json"
                                data-action="click->raw-json#show"
                                data-raw-json-content-value="<%= d.raw_json %>"
                                data-raw-json-title-value="Device: <%= d.name %>">
                          <i class="fa-solid fa-code"></i>
                          JSON
                        </button>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# Mobile Cards %>
        <div class="lg:hidden space-y-3">
          <% @devices.each do |d| %>
            <%
              model = JSON.parse(d.raw_json)["attributes"]["model"] rescue nil
              device_icon = case d.device_class
                when "IPHONE" then "fa-mobile-screen"
                when "IPAD" then "fa-tablet-screen-button"
                when "APPLE_WATCH" then "fa-clock"
                when "APPLE_TV" then "fa-tv"
                when "MAC" then "fa-laptop"
                else "fa-microchip"
              end
            %>
            <div class="card border border-base-200 shadow-sm overflow-hidden">
              <div class="card-body p-3 sm:p-4 space-y-3 min-w-0">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-cyan-500/20 to-teal-500/20 flex items-center justify-center shrink-0">
                    <i class="fa-solid <%= device_icon %> text-cyan-600 sm:text-lg"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold text-sm sm:text-base truncate"><%= d.name %></div>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                      <span class="badge badge-ghost badge-sm"><%= d.device_class %></span>
                      <span class="badge badge-outline badge-sm"><%= d.platform %></span>
                    </div>
                  </div>
                  <% if d.status == "ENABLED" %>
                    <span class="badge badge-success badge-sm gap-1 shrink-0">
                      <i class="fa-solid fa-check text-[8px]"></i>
                      On
                    </span>
                  <% else %>
                    <span class="badge badge-error badge-sm gap-1 shrink-0">
                      <i class="fa-solid fa-xmark text-[8px]"></i>
                      Off
                    </span>
                  <% end %>
                </div>

                <div class="grid gap-2 text-sm bg-base-200/50 rounded-xl p-2 sm:p-3">
                  <div class="flex justify-between items-center">
                    <span class="text-base-content/60 text-xs">UDID</span>
                    <code class="text-xs truncate max-w-[180px]"><%= d.udid %></code>
                  </div>
                  <% if model.present? %>
                    <div class="flex justify-between items-center">
                      <span class="text-base-content/60 text-xs">Model</span>
                      <span class="text-xs"><%= model %></span>
                    </div>
                  <% end %>
                  <% if d.added_at.present? %>
                    <div class="flex justify-between items-center">
                      <span class="text-base-content/60 text-xs">Added</span>
                      <span class="text-xs"><%= time_ago_in_words(d.added_at) %> ago</span>
                    </div>
                  <% end %>
                </div>

                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                          data-action="click->rename-device#showModal"
                          data-device-id="<%= d.id %>"
                          data-device-name="<%= d.name %>">
                    <i class="fa-solid fa-pen"></i>
                    Rename
                  </button>
                  <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                          data-controller="copy"
                          data-action="click->copy#copy"
                          data-copy-text-value="<%= d.udid %>">
                    <i class="fa-solid fa-copy"></i>
                    Copy
                  </button>
                  <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                          data-controller="raw-json"
                          data-action="click->raw-json#show"
                          data-raw-json-content-value="<%= d.raw_json %>"
                          data-raw-json-title-value="Device: <%= d.name %>">
                    <i class="fa-solid fa-code"></i>
                    JSON
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%# Empty State %>
        <div class="flex flex-col items-center justify-center py-10 sm:py-16 text-center px-2">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-teal-500/20 flex items-center justify-center mb-4">
            <i class="fa-solid fa-mobile-screen-button text-2xl sm:text-3xl text-cyan-500/50"></i>
          </div>
          <h3 class="text-lg sm:text-xl font-bold">No Devices Found</h3>
          <p class="text-base-content/60 max-w-sm mt-2 mb-6 text-sm break-words">
            <% if @q_platform.present? || @q_status.present? || @q_query.present? %>
              No devices match the current filters. Try adjusting your search criteria.
            <% else %>
              Register a device to start building for real hardware.
            <% end %>
          </p>
          <div class="flex flex-wrap gap-2 sm:gap-3">
            <% if @q_platform.present? || @q_status.present? || @q_query.present? %>
              <%= link_to organization_apple_devices_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
                <i class="fa-solid fa-xmark"></i>
                Clear Filters
              <% end %>
            <% end %>
            <button class="btn btn-primary btn-sm sm:btn-md gap-2" data-controller="modal" data-action="click->modal#open" data-modal-target-value="register-device-modal">
              <i class="fa-solid fa-plus"></i>
              <span class="hidden sm:inline">Register Device</span>
              <span class="sm:hidden">Register</span>
            </button>
          </div>
        </div>
      <% end %>
  <% end %>

  <%# Rename Device Modal — must be inside the rename-device controller scope %>
  <dialog id="rename-device-modal" class="modal modal-bottom sm:modal-middle" data-rename-device-target="modal">
    <div class="modal-box">
      <div class="flex items-start gap-4 mb-6">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500/20 to-teal-500/20 flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-pen text-cyan-600 text-lg"></i>
        </div>
        <div>
          <h3 class="text-xl font-bold">Rename Device</h3>
          <p class="text-sm text-base-content/60 mt-1">
            Update the device name in App Store Connect.
          </p>
        </div>
      </div>

      <form id="rename-device-form" method="post" class="space-y-4" data-rename-device-target="form">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium flex items-center gap-2">
              <i class="fa-solid fa-tag text-xs text-base-content/50"></i>
              Device Name
            </span>
          </label>
          <input type="text" name="device[name]" id="rename-device-name"
                 class="input input-bordered w-full focus:input-primary" required
                 placeholder="Jane's iPhone 15 Pro"
                 data-rename-device-target="nameInput" />
        </div>

        <div class="modal-action pt-4 border-t border-base-200">
          <button type="button" class="btn btn-ghost" data-action="click->rename-device#closeModal">Cancel</button>
          <button type="submit" class="btn btn-primary gap-2">
            <i class="fa-solid fa-check"></i>
            Save
          </button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</section>

<%# Register Device Modal %>
<dialog id="register-device-modal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box w-full max-w-lg overflow-hidden">
    <div class="flex items-start gap-3 sm:gap-4 mb-6">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-cyan-500/20 to-teal-500/20 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-mobile-screen-button text-cyan-600 sm:text-lg"></i>
      </div>
      <div class="min-w-0">
        <h3 class="text-lg sm:text-xl font-bold">Register Device</h3>
        <p class="text-sm text-base-content/60 mt-1">
          Add a UDID for development and ad-hoc distribution builds.
        </p>
      </div>
    </div>

    <%= form_with url: organization_apple_devices_path(@organization), method: :post, scope: :device, class: "space-y-4" do |f| %>
      <div class="form-control">
        <label class="label">
          <span class="label-text font-medium flex items-center gap-2">
            <i class="fa-solid fa-tag text-xs text-base-content/50"></i>
            Device Name
          </span>
        </label>
        <%= f.text_field :name, class: "input input-bordered w-full focus:input-primary", required: true, placeholder: "Jane's iPhone 15 Pro" %>
        <label class="label">
          <span class="label-text-alt text-base-content/50">A friendly name to identify this device</span>
        </label>
      </div>

      <div class="form-control">
        <label class="label">
          <span class="label-text font-medium flex items-center gap-2">
            <i class="fa-solid fa-fingerprint text-xs text-base-content/50"></i>
            UDID
          </span>
        </label>
        <%= f.text_field :udid, class: "input input-bordered w-full font-mono focus:input-primary", required: true, placeholder: "00008030-001A2B3C4D5E6F78" %>
        <label class="label">
          <span class="label-text-alt text-base-content/50 text-wrap">
            Finder → iPhone → Trust → Copy UDID, or Xcode → Devices
          </span>
        </label>
      </div>

      <div class="form-control">
        <label class="label">
          <span class="label-text font-medium flex items-center gap-2">
            <i class="fa-solid fa-mobile-screen text-xs text-base-content/50"></i>
            Platform
          </span>
        </label>
        <%= render "shared/custom_select",
                   name: "device[platform]",
                   options: [["iOS (iPhone, iPad)", "IOS"], ["macOS", "MAC_OS"], ["tvOS (Apple TV)", "TV_OS"]],
                   size: "md" %>
      </div>

      <div class="modal-action pt-4 border-t border-base-200">
        <button type="button" class="btn btn-ghost" data-controller="modal" data-action="click->modal#close" data-modal-target-value="register-device-modal">Cancel</button>
        <%= f.submit "Register Device", class: "btn btn-primary gap-2" %>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<% if @show_register_modal %>
  <%= javascript_tag nonce: true do %>
    document.addEventListener("turbo:load", function handler() {
      var modal = document.getElementById("register-device-modal");
      if (modal && typeof modal.showModal === "function") { modal.showModal(); }
      var url = new URL(window.location.href);
      if (url.searchParams.has("register")) {
        url.searchParams.delete("register");
        var newUrl = url.pathname;
        var qs = url.searchParams.toString();
        if (qs) newUrl += "?" + qs;
        if (url.hash) newUrl += url.hash;
        window.history.replaceState({}, document.title, newUrl);
      }
      document.removeEventListener("turbo:load", handler);
    });
  <% end %>
<% end %>
