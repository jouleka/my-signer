<% content_for(:title) { "Restoration link not valid" } %>
<% content_for(:description) { "This account-restoration link is not valid." } %>

<section class="mx-auto max-w-md py-16 px-6 text-center">
  <div class="rounded-2xl border border-base-200 bg-base-100 p-8 space-y-5">
    <div class="text-3xl"><i class="fa-solid fa-circle-xmark text-error" aria-hidden="true"></i></div>
    <h1 class="text-2xl font-bold">Restoration link not valid</h1>
    <p class="text-sm text-base-content/75">
      This restoration link doesn't match an account scheduled for deletion. It may
      have already been used, the token may be wrong, or the account may have already
      been permanently deleted.
    </p>
    <p class="text-sm text-base-content/75">
      If you think this is a mistake, please email
      <a href="mailto:<%= legal_support_email %>" class="link link-primary"><%= legal_support_email %></a>.
    </p>
    <%= link_to "Back to home", "/", class: "btn btn-ghost btn-sm" %>
  </div>
</section>
