<% content_for(:title) { "Restore your account" } %>
<% content_for(:description) { "Confirm that you want to restore your MySigner account." } %>

<%
  provider_label = case @user.provider
                   when "google_oauth2" then "Google"
                   when "github"        then "GitHub"
                   when "apple"         then "Apple"
                   else nil
                   end
  oauth_provider_supported = Users::AccountRestorationsController::OAUTH_RESTORE_PROVIDERS.include?(@user.provider)
  has_password_path = @user.provider.blank?
%>

<section class="mx-auto max-w-md py-16 px-6 text-center">
  <div class="rounded-2xl border border-base-200 bg-base-100 p-8 space-y-5">
    <div class="text-3xl"><i class="fa-solid fa-rotate-left text-primary" aria-hidden="true"></i></div>
    <h1 class="text-2xl font-bold">Restore your account?</h1>
    <p class="text-sm text-base-content/75">
      Hi <%= @user.name.presence || mask_email(@user.email) %>. Your account is currently
      scheduled for deletion on
      <strong><%= ((@user.deleted_at + PendingDeletionPurgeJob::RETENTION_DAYS.days).to_date).strftime("%B %-d, %Y") %></strong>.
    </p>
    <p class="text-sm text-base-content/75">
      To restore, prove this is your account. Your data, organizations,
      credentials, and settings will all come back exactly as they were.
    </p>

    <% if flash[:alert].present? %>
      <div class="flex items-start gap-2 px-3 py-2 rounded-lg bg-base-200/50 border border-error/30 text-sm text-left">
        <i class="fa-solid fa-circle-exclamation text-error mt-0.5"></i>
        <span class="text-base-content/70"><%= flash[:alert] %></span>
      </div>
    <% end %>

    <% if has_password_path %>
      <%= form_with url: account_restoration_path(token: params[:token]), method: :post, local: true, class: "space-y-3 text-left" do |f| %>
        <%= f.label :current_password, "Your password", class: "label label-text" %>
        <%= f.password_field :current_password,
                             autocomplete: "current-password",
                             autofocus: true,
                             required: true,
                             class: "input input-bordered w-full" %>
        <%= f.submit "Restore my account", class: "btn btn-primary btn-block" %>
      <% end %>
    <% elsif oauth_provider_supported %>
      <p class="text-xs text-base-content/60">
        Your account uses <strong><%= provider_label %></strong> sign-in. Continue with
        <%= provider_label %> to confirm and restore.
      </p>
      <%= button_to "Continue with #{provider_label}",
                    account_restoration_path(token: params[:token]),
                    method: :post,
                    class: "btn btn-primary btn-block" %>
    <% else %>
      <%= form_with url: account_restoration_path(token: params[:token]), method: :post, local: true do |f| %>
        <%= f.submit "Restore my account", class: "btn btn-primary btn-block" %>
      <% end %>
    <% end %>

    <p class="text-xs text-base-content/50">
      Didn't request this? You can safely ignore this page — your account stays scheduled for deletion.
    </p>
  </div>
</section>
