<% content_for(:title) { "Restoration link expired" } %>
<% content_for(:description) { "This account-restoration link has expired." } %>

<section class="mx-auto max-w-md py-16 px-6 text-center">
  <div class="rounded-2xl border border-base-200 bg-base-100 p-8 space-y-5">
    <div class="text-3xl"><i class="fa-solid fa-clock-rotate-left text-warning" aria-hidden="true"></i></div>
    <h1 class="text-2xl font-bold">Restoration link expired</h1>
    <p class="text-sm text-base-content/75">
      Account restoration is only available for 90 days after you request deletion.
      That window has now passed and any associated data has either already been or
      will shortly be permanently deleted.
    </p>
    <p class="text-sm text-base-content/75">
      You're welcome to sign up again any time. If you have questions, email
      <a href="mailto:<%= legal_support_email %>" class="link link-primary"><%= legal_support_email %></a>.
    </p>
    <%= link_to "Back to home", "/", class: "btn btn-ghost btn-sm" %>
  </div>
</section>
