<%# Analytics Overview — key metrics from the last 30 days with trends %>
<div class="<%= card_container_classes %>">
  <div class="<%= card_header_split_classes %>">
    <div class="flex items-center gap-2.5">
      <div class="<%= card_icon_classes %>">
        <i class="fa-solid fa-chart-bar"></i>
      </div>
      <span class="<%= card_title_classes %>">Analytics</span>
      <span class="<%= muted_badge_classes %>">30d</span>
    </div>
    <%= link_to organization_analytics_path(@organization), class: btn_ghost_xs_classes do %>
      Full Report <i class="fa-solid fa-arrow-right text-[0.5rem]"></i>
    <% end %>
  </div>
  <div class="<%= card_body_classes %>">
    <% if @analytics_data[:has_data] %>
      <div class="grid grid-cols-2 gap-4">
        <%# Downloads %>
        <div class="p-3.5 rounded-lg border border-base-content/[0.05] bg-base-content/[0.015]">
          <p class="<%= label_uppercase_classes %> mb-2">
            <i class="fa-solid fa-download text-[0.5rem]"></i> Downloads
          </p>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-2xl font-extrabold text-base-content/90 tabular-nums tracking-tight">
              <%= number_with_delimiter(@analytics_data[:downloads]) %>
            </span>
          </div>
          <% if @analytics_data[:downloads_change] %>
            <%= pct_change_html(@analytics_data[:downloads_change]) %>
          <% else %>
            <span class="<%= hint_text_classes %>">vs prev 30d</span>
          <% end %>
        </div>

        <%# Impressions %>
        <div class="p-3.5 rounded-lg border border-base-content/[0.05] bg-base-content/[0.015]">
          <p class="<%= label_uppercase_classes %> mb-2">
            <i class="fa-solid fa-eye text-[0.5rem]"></i> Impressions
          </p>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-2xl font-extrabold text-base-content/90 tabular-nums tracking-tight">
              <%= number_with_delimiter(@analytics_data[:impressions]) %>
            </span>
          </div>
          <% if @analytics_data[:impressions_change] %>
            <%= pct_change_html(@analytics_data[:impressions_change]) %>
          <% else %>
            <span class="<%= hint_text_classes %>">vs prev 30d</span>
          <% end %>
        </div>

        <%# Conversion Rate %>
        <div class="p-3.5 rounded-lg border border-base-content/[0.05] bg-base-content/[0.015]">
          <p class="<%= label_uppercase_classes %> mb-2">
            <i class="fa-solid fa-bullseye text-[0.5rem]"></i> Conversion
          </p>
          <% if @analytics_data[:conversion_rate] %>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-2xl font-extrabold text-base-content/90 tabular-nums tracking-tight">
                <%= @analytics_data[:conversion_rate] %>%
              </span>
            </div>
            <% if @analytics_data[:conversion_change] %>
              <%= pct_change_html(@analytics_data[:conversion_change]) %>
            <% end %>
          <% else %>
            <p class="<%= empty_inline_classes %> py-2">
              <i class="fa-solid fa-minus"></i> No data
            </p>
          <% end %>
        </div>

        <%# Crash Rate %>
        <div class="p-3.5 rounded-lg border border-base-content/[0.05] bg-base-content/[0.015]">
          <p class="<%= label_uppercase_classes %> mb-2">
            <i class="fa-solid fa-bug text-[0.5rem]"></i> Crash Rate
          </p>
          <% if @analytics_data[:crash_rate] %>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-2xl font-extrabold tabular-nums tracking-tight <%= @analytics_data[:crash_rate].to_f > 1.0 ? 'text-error/80' : 'text-base-content/90' %>">
                <%= @analytics_data[:crash_rate] %>%
              </span>
            </div>
            <% if @analytics_data[:crash_rate_change] %>
              <%= pct_change_html(@analytics_data[:crash_rate_change], invert: true) %>
            <% end %>
          <% else %>
            <p class="<%= empty_inline_classes %> py-2">
              <i class="fa-solid fa-minus"></i> No data
            </p>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="flex flex-col items-center py-8 text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary/[0.06] text-primary/40 mb-3">
          <i class="fa-solid fa-chart-bar text-lg"></i>
        </div>
        <p class="text-sm font-semibold text-base-content/50 mb-1">No analytics data</p>
        <p class="<%= meta_text_classes %> max-w-[16rem] mb-3">Sync your apps to start tracking downloads, crash rates, and conversion metrics.</p>
        <%= link_to organization_analytics_path(@organization), class: btn_ghost_sm_classes do %>
          <i class="fa-solid fa-chart-bar"></i> View Analytics
        <% end %>
      </div>
    <% end %>
  </div>
</div>
