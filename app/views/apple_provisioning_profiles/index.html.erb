<%= render "shared/ios_breadcrumbs", organization: @organization, active_tab: :profiles %>

<% total_profiles = @organization.apple_provisioning_profiles.count %>
<% invalid_profiles = @organization.apple_provisioning_profiles.where(state: "INVALID").count %>

<section class="space-y-4 sm:space-y-6 min-w-0 w-full overflow-hidden">
  <%= render "shared/page_header",
             title: "Provisioning Profiles",
             description: "Manage bundle IDs, keep profiles valid, and download artifacts straight from the dashboard.",
             gradient: "from-purple-500/10 via-base-100 to-fuchsia-500/10",
             badge_icon: "fa-solid fa-id-badge",
             badge_text: "Provisioning",
             stats: (capture do %>
        <div class="stat py-2 px-3 sm:py-3 sm:px-5">
          <div class="stat-title text-xs">Total</div>
          <div class="stat-value text-xl sm:text-2xl"><%= total_profiles %></div>
          <div class="stat-desc">profiles</div>
        </div>
        <% if invalid_profiles > 0 %>
          <div class="stat py-2 px-3 sm:py-3 sm:px-5">
            <div class="stat-title text-xs">Invalid</div>
            <div class="stat-value text-xl sm:text-2xl text-error"><%= invalid_profiles %></div>
            <div class="stat-desc">need attention</div>
          </div>
        <% end %>
        <% if @q_type.present? || @q_state.present? || @q_query.present? %>
          <div class="stat py-2 px-3 sm:py-3 sm:px-5">
            <div class="stat-title text-xs">Filtered</div>
            <div class="stat-value text-xl sm:text-2xl text-accent"><%= @profiles.size %></div>
            <div class="stat-desc">showing</div>
          </div>
        <% end %>
             <% end),
             actions: (capture do %>
      <%= link_to new_organization_apple_provisioning_profile_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-plus"></i>
        <span class="hidden sm:inline">Create Profile</span>
        <span class="sm:hidden">Create</span>
      <% end %>
      <%= link_to organization_apple_provisioning_profiles_path(@organization, format: :csv, type: @q_type, state: @q_state, q: @q_query), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-file-csv"></i>
        <span class="hidden sm:inline">Export CSV</span>
        <span class="sm:hidden">CSV</span>
      <% end %>
      <%= link_to organization_apple_apps_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="hidden sm:inline">Back to Apps</span>
        <span class="sm:hidden">Back</span>
      <% end %>
             <% end) %>

  <%# Profiles Card %>
  <%= render "shared/content_card",
             filter_class: "lg:flex-row lg:items-end",
             filter: (capture do %>
    <%= form_with url: organization_apple_provisioning_profiles_path(@organization), method: :get, local: true, class: "flex flex-col sm:flex-row gap-3 sm:gap-4 flex-1 min-w-0" do %>
      <div class="form-control flex-1 min-w-0 sm:max-w-[160px]">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-tag text-[10px] text-base-content/50"></i>
            Type
          </span>
        </label>
        <%= render "shared/custom_select", name: "type", options: [["All types", ""]] + @types.map { |t| [t, t] }, selected: @q_type.to_s %>
      </div>
      <div class="form-control flex-1 min-w-0 sm:max-w-[160px]">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-toggle-on text-[10px] text-base-content/50"></i>
            State
          </span>
        </label>
        <%= render "shared/custom_select", name: "state", options: [["All states", ""]] + @states.map { |s| [s, s] }, selected: @q_state.to_s %>
      </div>
      <div class="form-control flex-1 min-w-0 sm:max-w-xs">
        <label class="label py-1">
          <span class="label-text text-xs font-medium flex items-center gap-1.5">
            <i class="fa-solid fa-magnifying-glass text-[10px] text-base-content/50"></i>
            Search
          </span>
        </label>
        <input type="text" name="q" value="<%= @q_query %>" placeholder="Name or UUID..." class="input input-bordered input-sm w-full" autocomplete="off" />
      </div>
      <div class="flex items-end gap-2">
        <button class="btn btn-primary btn-sm gap-2" type="submit">
          <i class="fa-solid fa-filter"></i>
          Apply
        </button>
        <% if @q_type.present? || @q_state.present? || @q_query.present? %>
          <%= link_to organization_apple_provisioning_profiles_path(@organization), class: "btn btn-ghost btn-sm gap-2" do %>
            <i class="fa-solid fa-xmark"></i>
            Clear
          <% end %>
        <% end %>
      </div>
    <% end %>
             <% end) do %>

    <% if @profiles.any? %>
        <%# Desktop Table %>
        <div class="hidden lg:block">
          <div class="overflow-x-auto rounded-2xl border border-base-200">
            <table class="table">
              <thead>
                <tr class="bg-base-200/50 text-xs uppercase text-base-content/60 font-bold tracking-wider">
                  <th>Profile</th>
                  <th>Type</th>
                  <th>Bundle ID</th>
                  <th>State</th>
                  <th>Expiry</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @profiles.each do |p| %>
                  <% 
                    expires_at = p.expires_at
                    days = expires_at.present? ? (expires_at.to_date - Date.current).to_i : nil
                    expiry_info = if days.nil?
                      { badge: "badge-ghost", icon: nil, text: "Unknown" }
                    elsif days <= 0
                      { badge: "badge-error", icon: "fa-circle-exclamation", text: "Expired" }
                    elsif days <= 30
                      { badge: "badge-warning", icon: "fa-triangle-exclamation", text: expires_at.strftime("%b %d, %Y") }
                    elsif days <= 90
                      { badge: "badge-info", icon: "fa-clock", text: expires_at.strftime("%b %d, %Y") }
                    else
                      { badge: "badge-success", icon: "fa-check", text: expires_at.strftime("%b %d, %Y") }
                    end
                    
                    state_info = case p.state
                      when "ACTIVE" then { badge: "badge-success", icon: "fa-check" }
                      when "INVALID" then { badge: "badge-error", icon: "fa-xmark" }
                      else { badge: "badge-ghost", icon: "fa-circle-question" }
                    end
                    
                    profile_icon = case p.profile_type
                      when /DEVELOPMENT/ then "fa-code"
                      when /STORE/ then "fa-store"
                      when /ADHOC/ then "fa-share-nodes"
                      when /INHOUSE/ then "fa-building"
                      else "fa-id-badge"
                    end
                  %>
                  <tr class="hover:bg-base-200/30 transition-colors">
                    <td>
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500/20 to-fuchsia-500/20 flex items-center justify-center">
                          <i class="fa-solid <%= profile_icon %> text-purple-600"></i>
                        </div>
                        <div>
                          <div class="font-semibold"><%= p.name %></div>
                          <code class="text-xs text-base-content/40"><%= p.uuid.truncate(16) %></code>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge badge-ghost badge-sm"><%= p.profile_type %></span>
                    </td>
                    <td>
                      <% if p.bundle_id_identifier.present? %>
                        <code class="text-xs bg-base-200 px-2 py-0.5 rounded"><%= p.bundle_id_identifier %></code>
                      <% else %>
                        <span class="text-base-content/30">—</span>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge <%= state_info[:badge] %> gap-1.5">
                        <i class="fa-solid <%= state_info[:icon] %> text-[10px]"></i>
                        <%= p.state %>
                      </span>
                    </td>
                    <td>
                      <span class="badge <%= expiry_info[:badge] %> gap-1.5 whitespace-nowrap">
                        <% if expiry_info[:icon] %>
                          <i class="fa-solid <%= expiry_info[:icon] %> text-[10px]"></i>
                        <% end %>
                        <%= expiry_info[:text] %>
                      </span>
                    </td>
                    <td class="text-right">
                      <div class="flex items-center justify-end gap-1">
                        <%= link_to organization_apple_provisioning_profile_path(@organization, p), class: "btn btn-ghost btn-xs gap-1.5" do %>
                          <i class="fa-solid fa-eye"></i>
                          View
                        <% end %>
                        <%= link_to download_organization_apple_provisioning_profile_path(@organization, p), class: "btn btn-ghost btn-xs gap-1.5" do %>
                          <i class="fa-solid fa-download"></i>
                          Download
                        <% end %>
                        <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                                data-controller="raw-json"
                                data-action="click->raw-json#show"
                                data-raw-json-content-value="<%= p.raw_json %>"
                                data-raw-json-title-value="Profile: <%= p.name %>">
                          <i class="fa-solid fa-code"></i>
                          JSON
                        </button>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# Mobile Cards %>
        <div class="lg:hidden space-y-3">
          <% @profiles.each do |p| %>
            <%
              expires_at = p.expires_at
              days = expires_at.present? ? (expires_at.to_date - Date.current).to_i : nil
              expiry_info = if days.nil?
                { badge: "badge-ghost", text: "Unknown", border: "border-base-200" }
              elsif days <= 0
                { badge: "badge-error", text: "Expired", border: "border-error/50 bg-error/5" }
              elsif days <= 30
                { badge: "badge-warning", text: expires_at.strftime("%b %d"), border: "border-warning/50 bg-warning/5" }
              else
                { badge: "badge-success", text: expires_at.strftime("%b %d, %Y"), border: "border-base-200" }
              end

              state_info = case p.state
                when "ACTIVE" then { badge: "badge-success", icon: "fa-check" }
                when "INVALID" then { badge: "badge-error", icon: "fa-xmark" }
                else { badge: "badge-ghost", icon: nil }
              end
            %>
            <div class="card border <%= p.state == 'INVALID' ? 'border-error/50 bg-error/5' : 'border-base-200' %> shadow-sm overflow-hidden">
              <div class="card-body p-3 sm:p-4 space-y-3 min-w-0">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-fuchsia-500/20 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-id-badge text-purple-600 sm:text-lg"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold text-sm sm:text-base truncate"><%= p.name %></div>
                    <span class="badge badge-ghost badge-sm mt-1"><%= p.profile_type %></span>
                  </div>
                  <span class="badge <%= state_info[:badge] %> badge-sm gap-1 shrink-0">
                    <% if state_info[:icon] %>
                      <i class="fa-solid <%= state_info[:icon] %> text-[8px]"></i>
                    <% end %>
                    <%= p.state %>
                  </span>
                </div>

                <div class="grid gap-2 text-sm bg-base-200/50 rounded-xl p-2 sm:p-3">
                  <% if p.bundle_id_identifier.present? %>
                    <div class="flex justify-between items-center">
                      <span class="text-base-content/60 text-xs">Bundle ID</span>
                      <code class="text-xs truncate max-w-[160px]"><%= p.bundle_id_identifier %></code>
                    </div>
                  <% end %>
                  <div class="flex justify-between items-center">
                    <span class="text-base-content/60 text-xs">UUID</span>
                    <code class="text-xs truncate max-w-[160px]"><%= p.uuid %></code>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-base-content/60 text-xs">Expiry</span>
                    <span class="badge <%= expiry_info[:badge] %> badge-xs"><%= expiry_info[:text] %></span>
                  </div>
                </div>

                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  <%= link_to organization_apple_provisioning_profile_path(@organization, p), class: "btn btn-primary btn-xs gap-1.5" do %>
                    <i class="fa-solid fa-eye"></i>
                    View
                  <% end %>
                  <%= link_to download_organization_apple_provisioning_profile_path(@organization, p), class: "btn btn-ghost btn-xs gap-1.5" do %>
                    <i class="fa-solid fa-download"></i>
                    Download
                  <% end %>
                  <button type="button" class="btn btn-ghost btn-xs gap-1.5"
                          data-controller="raw-json"
                          data-action="click->raw-json#show"
                          data-raw-json-content-value="<%= p.raw_json %>"
                          data-raw-json-title-value="Profile: <%= p.name %>">
                    <i class="fa-solid fa-code"></i>
                    JSON
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%# Empty State %>
        <div class="flex flex-col items-center justify-center py-10 sm:py-16 text-center px-2">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-purple-500/20 to-fuchsia-500/20 flex items-center justify-center mb-4">
            <i class="fa-solid fa-id-badge text-2xl sm:text-3xl text-purple-500/50"></i>
          </div>
          <h3 class="text-lg sm:text-xl font-bold">No Profiles Found</h3>
          <p class="text-base-content/60 max-w-sm mt-2 mb-6 text-sm break-words">
            <% if @q_type.present? || @q_state.present? || @q_query.present? %>
              No profiles match the current filters. Try adjusting your search criteria.
            <% else %>
              Sync your App Store Connect data or create a new profile.
            <% end %>
          </p>
          <div class="flex flex-wrap gap-2 sm:gap-3">
            <% if @q_type.present? || @q_state.present? || @q_query.present? %>
              <%= link_to organization_apple_provisioning_profiles_path(@organization), class: "btn btn-ghost btn-sm sm:btn-md gap-2" do %>
                <i class="fa-solid fa-xmark"></i>
                Clear Filters
              <% end %>
            <% end %>
            <%= link_to new_organization_apple_provisioning_profile_path(@organization), class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
              <i class="fa-solid fa-plus"></i>
              <span class="hidden sm:inline">Create Profile</span>
              <span class="sm:hidden">Create</span>
            <% end %>
          </div>
        </div>
      <% end %>
  <% end %>
</section>
