<%# Editor tab: read-only display of current keywords with character count %>
<div class="<%= card_container_classes %>">
  <div class="<%= card_header_split_classes %>">
    <div class="flex items-center gap-2.5">
      <div class="<%= card_icon_classes %>">
        <i class="fa-solid fa-key"></i>
      </div>
      <span class="<%= card_title_classes %>">Keywords</span>
      <% if @current_locale.present? %>
        <span class="<%= locale_badge_classes %>"><%= @current_locale %></span>
      <% end %>
    </div>
    <% if @store_listing %>
      <% if @entitlements.keyword_editor_read_only? %>
        <span class="<%= btn_ghost_sm_classes %> opacity-40 cursor-not-allowed select-none" title="Upgrade to Pro to edit keywords">
          <i class="fa-solid fa-pen-to-square"></i> Edit in Listing <%= pro_badge_html %>
        </span>
      <% else %>
        <%= link_to organization_release_path(@organization, "apple_app_#{@app.id}", tab: "listing", locale: @current_locale),
            class: btn_ghost_sm_classes do %>
          <i class="fa-solid fa-pen-to-square"></i> Edit in Listing
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="<%= card_body_classes %>">
    <% if @store_listing.nil? %>
      <p class="<%= empty_inline_classes %>">
        <i class="fa-solid fa-circle-info"></i>
        No store listing found. Sync from the store first.
      </p>
    <% else %>
      <%# App name and subtitle context %>
      <% if @store_listing.app_name.present? || @store_listing.subtitle.present? %>
        <div class="mb-4 p-3 rounded-lg bg-base-content/[0.02] border border-base-content/[0.05]">
          <p class="<%= label_uppercase_classes %> mb-2">Title & Subtitle (also searchable)</p>
          <div class="flex flex-wrap gap-2">
            <% if @store_listing.app_name.present? %>
              <span data-keyword-editor-target="appName" class="text-sm font-semibold text-base-content/70"><%= @store_listing.app_name %></span>
            <% end %>
            <% if @store_listing.subtitle.present? %>
              <span class="text-base-content/20">|</span>
              <span data-keyword-editor-target="subtitle" class="text-sm text-base-content/55"><%= @store_listing.subtitle %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Keywords display %>
      <div class="mb-4">
        <p class="<%= label_uppercase_classes %> mb-2">Keyword Field</p>
        <div data-keyword-editor-target="keywordsDisplay">
          <%# Rendered by Stimulus controller via renderKeywordTags() %>
        </div>
      </div>

      <%# Character usage %>
      <% keywords_str = @store_listing.keywords || "" %>
      <% char_count = keywords_str.length %>
      <% char_limit = 100 %>
      <div class="flex items-center gap-3">
        <span class="<%= char_badge_classes(char_count, char_limit) %>"><%= char_count %>/<%= char_limit %></span>
        <div class="flex-1 max-w-xs">
          <div class="<%= progress_track_classes %>">
            <div class="<%= progress_fill_classes(char_count, char_limit) %>"
                 style="width: <%= [(char_count.to_f / char_limit * 100).round, 100].min %>%"></div>
          </div>
        </div>
      </div>

      <%# Duplicate detection: keywords that appear in title or subtitle %>
      <% if keywords_str.present? && (@store_listing.app_name.present? || @store_listing.subtitle.present?) %>
        <%
          kw_list = keywords_str.split(",").map(&:strip).reject(&:blank?)
          title_words = (@store_listing.app_name || "").downcase.split(/\s+/)
          subtitle_words = (@store_listing.subtitle || "").downcase.split(/\s+/)
          searchable_words = title_words + subtitle_words
          duplicates = kw_list.select { |kw| searchable_words.include?(kw.downcase) }
        %>
        <% if duplicates.any? %>
          <div class="mt-4 p-3 rounded-lg border border-warning/15 bg-warning/[0.04]">
            <p class="text-xs font-semibold text-warning/80 mb-1.5">
              <i class="fa-solid fa-triangle-exclamation mr-1"></i>
              Duplicate keywords found
            </p>
            <p class="text-xs text-base-content/50 mb-2">
              These keywords already appear in your app name or subtitle and are automatically searchable.
              Removing them frees space for other keywords.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <% duplicates.each do |dup_kw| %>
                <span class="<%= kw_tag_warn_classes %>">
                  <i class="fa-solid fa-copy text-[0.5rem]"></i>
                  <%= dup_kw %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <%# Locale selector %>
      <% if @locales.size > 1 %>
        <div class="mt-5 pt-4 border-t border-base-content/[0.05]">
          <p class="<%= label_uppercase_classes %> mb-2">Other Locales</p>
          <div class="flex flex-wrap gap-1.5">
            <% @locales.each do |loc| %>
              <% next if loc == @current_locale %>
              <%= link_to organization_keyword_path(@organization, params[:id], tab: "editor", locale: loc),
                  data: { action: "click->keyword-editor#confirmLocaleSwitch" },
                  class: "#{locale_badge_classes} hover:bg-primary/[0.08] hover:text-primary/70 transition-colors" do %>
                <%= loc %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
