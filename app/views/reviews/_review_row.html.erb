<%# Single review row in the feed %>
<div class="<%= card_container_classes %>">
  <div class="<%= card_body_classes %>">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <%# Platform + rating + sentiment %>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="<%= platform_badge_classes %>">
          <% if review.apple? %>
            <i class="fa-brands fa-apple"></i> <%= review.reviewable.name.presence || "iOS" %>
          <% else %>
            <i class="fa-brands fa-google-play"></i> <%= review.reviewable.name.presence || "Android" %>
          <% end %>
        </span>

        <%= star_rating_html(review.rating) %>

        <span class="<%= sentiment_badge_classes(review.sentiment) %>">
          <% case review.sentiment %>
          <% when "positive" %>
            <i class="fa-solid fa-face-smile text-[0.6rem]"></i> Positive
          <% when "negative" %>
            <i class="fa-solid fa-face-frown text-[0.6rem]"></i> Negative
          <% else %>
            <i class="fa-solid fa-face-meh text-[0.6rem]"></i> Neutral
          <% end %>
        </span>

        <% if review.reply_status != "none" %>
          <span class="<%= status_badge_classes(review.reply_status == "posted" ? "live" : review.reply_status == "pending" ? "in_review" : "draft") %>">
            <% case review.reply_status %>
            <% when "posted" %>
              <i class="fa-solid fa-check text-[0.55rem]"></i> Replied
            <% when "pending" %>
              <i class="fa-solid fa-clock text-[0.55rem]"></i> Pending
            <% when "failed" %>
              <i class="fa-solid fa-xmark text-[0.55rem]"></i> Failed
            <% end %>
          </span>
        <% end %>
      </div>

      <%# Reviewer info %>
      <div class="flex items-center gap-2">
        <span class="<%= meta_text_classes %>">
          <%= review.reviewer_name.presence || "Anonymous" %>
        </span>
        <% if review.territory.present? %>
          <span class="<%= locale_badge_classes %>"><%= review.territory %></span>
        <% end %>
        <span class="<%= meta_text_classes %>">
          <%= time_ago_in_words(review.reviewed_at) %> ago
        </span>
      </div>

      <% if review.android? && review.raw_json.present? %>
        <% user_comment = review.raw_json.dig("comments", 0, "user_comment") || {} %>
        <% device_meta = user_comment["device_metadata"] || {} %>
        <% if device_meta["product_name"].present? || user_comment["app_version_name"].present? %>
          <div class="flex flex-wrap items-center gap-2 mt-0.5">
            <% if device_meta["product_name"].present? %>
              <span class="<%= hint_text_classes %>">
                <i class="fa-solid fa-mobile-screen text-[0.5rem] mr-0.5"></i>
                <%= device_meta["manufacturer"] %> <%= device_meta["product_name"] %>
              </span>
            <% end %>
            <% if user_comment["app_version_name"].present? %>
              <span class="<%= hint_text_classes %>">v<%= user_comment["app_version_name"] %></span>
            <% end %>
            <% if user_comment["android_os_version"].present? %>
              <span class="<%= hint_text_classes %>">API <%= user_comment["android_os_version"] %></span>
            <% end %>
            <% thumbs_up = user_comment["thumbs_up_count"].to_i %>
            <% if thumbs_up > 0 %>
              <span class="<%= hint_text_classes %>">
                <i class="fa-solid fa-thumbs-up text-[0.5rem]"></i> <%= thumbs_up %>
              </span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Review content %>
    <% if review.title.present? %>
      <h3 class="text-sm font-semibold text-base-content/85 mb-1"><%= review.title %></h3>
    <% end %>
    <p class="text-sm text-base-content/65 leading-relaxed mb-3"><%= truncate(review.body, length: 500) %></p>

    <%# Reply section %>
    <% if review.reply_status == "posted" && review.reply_text.present? %>
      <div class="p-3 rounded-lg bg-primary/[0.04] border border-primary/[0.08]">
        <div class="flex items-center gap-1.5 mb-1">
          <i class="fa-solid fa-reply text-xs text-primary/50"></i>
          <span class="text-xs font-semibold text-primary/60">Developer Response</span>
          <% if review.reply_posted_at %>
            <span class="<%= meta_text_classes %>"><%= time_ago_in_words(review.reply_posted_at) %> ago</span>
          <% end %>
        </div>
        <%# reply_text is user-controlled (up to 5970 chars on iOS); rely on ERB
            auto-escape (`<%%= %%>`) — never render with `raw` or `html_safe`. %>
        <p class="text-sm text-base-content/65 leading-relaxed"><%= review.reply_text %></p>
        <% if review.apple? && review.replied? %>
          <%= button_to delete_reply_organization_review_path(@organization, review),
              method: :delete,
              class: "#{btn_ghost_xs_classes} text-error/60 hover:text-error mt-1",
              data: { turbo_confirm: "Delete this reply from the App Store?" } do %>
            <i class="fa-solid fa-trash-can text-[0.5rem]"></i> Delete Reply
          <% end %>
        <% end %>
      </div>
    <% elsif review.reply_status == "none" %>
      <%= render "reviews/reply_form", review: review, response_templates: response_templates %>
    <% end %>
  </div>
</div>
