<%# № 06 — Early access · talk to us.
    Editorial restyle of the contact section. The form (contacts/_form.html.erb)
    and message rendering are unchanged — just the surrounding chrome. %>
<section id="contact" class="relative" style="background: var(--color-base-200);">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 py-16 sm:py-24">

    <%# Editorial header rail. %>
    <div class="flex items-end justify-between gap-8 flex-wrap">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 text-[11px] uppercase tracking-[0.18em] text-mute mb-4 font-mono">
          <span class="secnum text-base normal-case tracking-normal">№ 06</span>
          <span class="editorial-rule w-12"></span>
          <span class="flex items-center gap-2">
            Early access
            <%# Pulsing dot to echo the existing "we just started" badge. %>
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full rounded-full opacity-75 pulse-dot"
                    style="background: var(--color-success);"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5"
                    style="background: var(--color-success);"></span>
            </span>
          </span>
        </div>
        <h2 class="font-display leading-[1] tracking-tight"
            style="font-size: clamp(40px, 5vw, 76px);">
          We're building this
          <span class="italic" style="color: var(--color-primary);">with you.</span>
        </h2>
      </div>
      <p class="text-mute text-sm max-w-sm">
        MySigner is in early access &mdash; your feedback shapes the roadmap.
        Found a bug? Want a feature? Just want to say hi? Reply to every message gets a real human.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-12 gap-4">

      <%# Left rail: 3 quick contact options + email. %>
      <div class="col-span-12 md:col-span-5 flex flex-col gap-3">
        <% [
             {
               icon: "fa-solid fa-bug",
               icon_color: "var(--color-error)",
               icon_bg_mix: 14,
               icon_token: "var(--color-error)",
               title: "Report a bug",
               blurb: "Something broken? Let us know and we'll fix it fast."
             },
             {
               icon: "fa-solid fa-wand-magic-sparkles",
               icon_token: "var(--color-primary)",
               icon_bg_mix: 14,
               title: "Request a feature",
               blurb: "Have an idea? We're all ears. Your input drives our roadmap."
             },
             {
               icon: "fa-solid fa-comment-dots",
               icon_token: "var(--color-success)",
               icon_bg_mix: 14,
               title: "General feedback",
               blurb: "Tell us what you think. Good, bad, or just ideas."
             }
           ].each do |card| %>
          <div class="rounded-[var(--radius-box)] border border-soft p-5 transition-colors hover:border-base-content/30"
               style="background: var(--color-base-100);">
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-md flex-shrink-0"
                   style="background: color-mix(in oklab, <%= card[:icon_token] %> <%= card[:icon_bg_mix] %>%, transparent); color: <%= card[:icon_token] %>;">
                <i class="<%= card[:icon] %>" aria-hidden="true"></i>
              </div>
              <div>
                <div class="font-medium"><%= card[:title] %></div>
                <div class="mt-1 text-sm text-mute leading-snug"><%= card[:blurb] %></div>
              </div>
            </div>
          </div>
        <% end %>

        <%# Email fallback. %>
        <div class="text-center text-xs text-mute pt-2">
          Or email us directly:
          <!--email_off-->
          <a href="mailto:support@mysigner.dev" class="font-mono text-base-content hover:underline">support@mysigner.dev</a>
          <!--/email_off-->
        </div>
      </div>

      <%# Right column: contact form. %>
      <div class="col-span-12 md:col-span-7">
        <div class="rounded-[var(--radius-box)] border border-soft p-6 sm:p-8"
             style="background: var(--color-base-100);">
          <h3 class="font-display text-2xl leading-tight">Send us a message</h3>
          <p class="mt-1 text-sm text-mute">We read every message and reply as soon as we can.</p>

          <div class="mt-6" id="contact-form-messages">
            <% if flash[:contact_notice] %>
              <%= render "contacts/notice", message: flash[:contact_notice] %>
            <% end %>

            <% if flash[:contact_alert] %>
              <%= render "contacts/alert", message: flash[:contact_alert] %>
            <% end %>
          </div>

          <div id="contact-form" class="mt-4">
            <%= render "contacts/form" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
