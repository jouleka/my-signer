<%# № 02 — Pipeline section.
    Maps to what `mysigner ship` actually does. Tracks, stat cells, step
    operations and companion commands are all sourced from the real CLI:
      tracks      → my-signer-cli/lib/mysigner/cli/build_commands.rb
      poll_interval → 180s ("3 min" cell)
      AES-256     → ActiveRecord::Encryption defaults (AES-256-GCM)
      30-day expiry → schema default `notification_days_before = 30`
    The 6 step cells were trimmed from the design's "Bump" mock (Android-only)
    to a more honest Detect → Build → Sign → Upload → Poll → Submit. %>
<%
  tracks = %w[appstore testflight internal alpha beta production]
  initial_track = "testflight"

  step_cells = [
    {
      number: "01",
      title: "Detect",
      head: "Framework + project",
      sub: "React Native, Expo, Flutter, Capacitor, native iOS/Android",
      progress: 100,
      tone: :primary
    },
    {
      number: "02",
      title: "Build",
      head: "Xcode archive · Gradle",
      sub: "Runs on your machine. Always.",
      progress: 92,
      tone: :primary
    },
    {
      number: "03",
      title: "Sign",
      head: "Cert + profile",
      sub: "Keychain or MySigner-vaulted",
      progress: 78,
      tone: :primary
    },
    {
      number: "04",
      title: "Upload",
      head: "ASC · Play Console",
      sub: "Resumable bytes — token stays vaulted",
      progress: 67,
      tone: :shimmer
    },
    {
      number: "05",
      title: "Poll",
      head: "Apple processing",
      sub: "Every 3 min, until done",
      progress: 33,
      tone: :primary
    },
    {
      number: "06",
      title: "Submit",
      head: "Auto-submit",
      sub: "App Review · Phased rollout",
      progress: 20,
      tone: :warning
    }
  ]

  companion_commands = [
    { cmd: "mysigner sync",     blurb: "Pull store metadata, reviews, analytics, and keyword rankings on demand." },
    { cmd: "mysigner onboard",  blurb: "First-run wizard: token, org, and credentials. One env var in CI: <span class='text-base-content'>MYSIGNER_API_TOKEN</span>." },
    { cmd: "mysigner doctor",   blurb: "Diagnoses signing setup, certs, profiles, and ASC connectivity. Tells you what's missing." }
  ]
%>

<section id="cli" class="relative">
  <%# track-switcher's scope wraps both the pill group and the inline label
      inside the visual card so Stimulus finds both as targets. %>
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 py-16 sm:py-24"
       data-controller="track-switcher"
       data-initial-track="<%= initial_track %>">

    <%# Editorial header rail %>
    <div class="flex items-end justify-between gap-8 flex-wrap">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 text-[11px] uppercase tracking-[0.18em] text-mute mb-4 font-mono">
          <span class="secnum text-base normal-case tracking-normal">№ 02</span>
          <span class="editorial-rule w-12"></span>
          <span>The pipeline</span>
        </div>
        <h2 class="font-display leading-[1] tracking-tight"
            style="font-size: clamp(40px, 5vw, 76px);">
          Six steps you used to do by hand.
          <span class="italic" style="color: var(--color-primary);">One command now.</span>
        </h2>
      </div>
      <div class="text-mute text-sm max-w-sm">
        Every box below is a thing that used to live across App Store Connect tabs,
        the Play Console, your terminal, and Apple's processing slot.
        <span class="font-mono text-base-content">mysigner ship &lt;track&gt;</span>
        walks them in order, retries what's flaky, and tells you what's blocking when it can't.
      </div>
    </div>

    <%# Track switcher — clicking a pill updates the inline ship command. %>
    <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-2">
      <span class="text-xs text-faint mr-2 font-mono shrink-0">track:</span>
      <% tracks.each do |track| %>
        <button type="button"
                class="pill border border-soft shrink-0 cursor-pointer transition-colors"
                data-track="<%= track %>"
                <%= raw('data-initial="true"') if track == initial_track %>
                data-track-switcher-target="pill"
                data-action="click->track-switcher#select"
                aria-pressed="<%= track == initial_track %>">
          <%= track %>
        </button>
      <% end %>
    </div>

    <%# Pipeline visual card. %>
    <div class="mt-8 rounded-[var(--radius-box)] border border-soft overflow-hidden"
         style="background: var(--color-base-200);">

      <%# Top row: input on the left, 4 stat cells on the right. %>
      <div class="grid grid-cols-12 gap-0 border-b border-soft">
        <div class="col-span-12 md:col-span-4 p-5 md:border-r border-soft">
          <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">Input</div>
          <div class="mt-2 font-mono text-sm">
            <span class="text-faint">$</span>
            mysigner ship
            <span data-track-switcher-target="label" style="color: var(--color-primary);"><%= initial_track %></span>
          </div>
          <div class="mt-3 text-xs text-mute flex flex-wrap gap-1.5">
            <span class="pill border border-soft">auto-detect framework</span>
            <span class="pill border border-soft">no config file</span>
          </div>
        </div>

        <div class="col-span-12 md:col-span-8 p-5 grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="flex flex-col gap-1 py-1">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">Polling</div>
            <div class="font-display text-3xl">3<span class="text-mute text-base"> min</span></div>
            <div class="text-[11px] text-mute">ASC processing checks</div>
          </div>
          <div class="flex flex-col gap-1 py-1">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">Profile alerts</div>
            <div class="font-display text-3xl">30<span class="text-mute text-base">d</span></div>
            <div class="text-[11px] text-mute">before expiry · default</div>
          </div>
          <div class="flex flex-col gap-1 py-1">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">Encryption</div>
            <div class="font-display text-3xl">AES<span class="text-mute text-base">-256</span></div>
            <div class="text-[11px] text-mute">credentials at rest</div>
          </div>
          <div class="flex flex-col gap-1 py-1">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">Region</div>
            <div class="font-display text-3xl">Hetzner<span class="text-mute text-base"> · US</span></div>
            <div class="text-[11px] text-mute">no third-party brokers</div>
          </div>
        </div>
      </div>

      <%# 6-step strip. Progress bars are cosmetic (snapshot of an in-flight run). %>
      <div class="grid grid-cols-1 md:grid-cols-6">
        <% step_cells.each_with_index do |step, idx| %>
          <% is_last = idx == step_cells.length - 1 %>
          <div class="p-5 <%= 'md:border-r border-soft' unless is_last %> <%= 'border-t md:border-t-0 border-soft' if idx > 0 %>">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">
              <%= step[:number] %> · <%= step[:title] %>
            </div>
            <div class="mt-2 font-medium text-sm"><%= step[:head] %></div>
            <div class="mt-1 text-[11px] text-mute leading-snug" style="min-height: 2lh;"><%= step[:sub] %></div>

            <div class="mt-3 h-1 rounded-full overflow-hidden"
                 style="background: color-mix(in oklab, var(--color-base-content) 8%, transparent);"
                 aria-hidden="true">
              <% bar_color =
                   case step[:tone]
                   when :warning then "var(--color-warning)"
                   else "var(--color-primary)"
                   end %>
              <div class="h-full <%= 'shimmer' if step[:tone] == :shimmer %> rounded-full"
                   style="width: <%= step[:progress] %>%; <%= "background: #{bar_color};" unless step[:tone] == :shimmer %>"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Companion commands — three cards under the pipeline. %>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-3">
      <% companion_commands.each do |c| %>
        <div class="rounded-[var(--radius-box)] p-5 border border-soft transition-colors hover:border-base-content/30"
             style="background: var(--color-base-200);">
          <div class="font-mono text-sm">
            <span class="text-mute">$</span>
            <span class="text-base-content"><%= c[:cmd] %></span>
          </div>
          <div class="mt-2 text-[13px] text-mute leading-relaxed">
            <%= raw c[:blurb] %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
