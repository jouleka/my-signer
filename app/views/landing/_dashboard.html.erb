<%# № 03 — Web dashboard / bento.
    Every claim below was cross-checked against:
      Pricing::Entitlements   (catalog + tier limits)
      Pricing::PlanPayload    (capability_highlights)
      AuditEventRetentionJob  (RETENTION_DAYS = 365)
      AuditEvent              (immutable, NOT hash-chained)
      config/recurring.yml    (review sync cadence: Pro 2h, Team 30min)
      sticker_library/*.svg   (149 stickers)
      MESH_PRESETS            (12 templates)
      APP_STORE_LOCALES       (44 locales) %>

<section id="dashboard" class="relative" style="background: var(--color-base-200);">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 py-16 sm:py-24">

    <%# Editorial header rail %>
    <div class="flex items-end justify-between gap-8 flex-wrap">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 text-[11px] uppercase tracking-[0.18em] text-mute mb-4 font-mono">
          <span class="secnum text-base normal-case tracking-normal">№ 03</span>
          <span class="editorial-rule w-12"></span>
          <span>Web dashboard</span>
        </div>
        <h2 class="font-display leading-[1] tracking-tight"
            style="font-size: clamp(40px, 5vw, 76px);">
          Five tools,
          <span class="italic" style="color: var(--color-primary);">one tab.</span>
        </h2>
      </div>
      <p class="text-mute text-sm max-w-sm">
        Stop paying $200&ndash;$500/mo to glue Sensor Tower, AppFollow, and Asodesk together.
        Releases, signing, ASO, reviews, analytics, and Screenshot Studio all live under one login.
      </p>
    </div>

    <%# Bento grid. Cards inherit one base style; spans differentiate them. %>
    <div class="mt-8 sm:mt-12 grid grid-cols-12 auto-rows-auto md:auto-rows-[120px] gap-4">

      <%# ── Releases & signing — large hero card ────────────────────── %>
      <article class="col-span-12 md:col-span-7 row-span-1 md:row-span-4 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6 relative overflow-hidden"
               style="background: var(--color-base-100);">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <i class="fa-solid fa-rocket" aria-hidden="true"></i>
            <span class="font-medium">Releases &amp; signing</span>
            <span class="pill"
                  style="background: color-mix(in oklab, var(--color-success) 18%, transparent); color: var(--color-success);">
              Every plan
            </span>
          </div>
          <span class="text-[11px] text-mute font-mono">App Store Connect · Play Console</span>
        </div>
        <h3 class="mt-4 font-display text-2xl sm:text-3xl leading-tight">
          Listings, release notes, phased rollouts &amp; in-app review checklists.
        </h3>

        <%# Stylized release row %>
        <div class="mt-6 rounded-lg border border-soft p-4 font-mono text-xs"
             style="background: var(--color-base-200);">
          <div class="flex flex-wrap items-center gap-3">
            <span class="pill"
                  style="background: color-mix(in oklab, var(--color-info) 18%, transparent); color: var(--color-info);">
              Processing
            </span>
            <span>finchly · 1.4.2 (224)</span>
            <span class="sm:ml-auto text-faint tnum">8m 41s</span>
          </div>
          <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 text-[11px] gap-3 sm:gap-2">
            <div><span class="text-faint">Build</span><div class="text-success">✓ archived</div></div>
            <div><span class="text-faint">Upload</span><div class="text-success">✓ 84.2 MB</div></div>
            <div><span class="text-faint">Polling</span><div class="text-warning">› 02:17 left</div></div>
            <div><span class="text-faint">Submit</span><div class="text-mute">— queued</div></div>
          </div>
        </div>

        <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-y-2 text-sm text-mute">
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-success text-xs" aria-hidden="true"></i> Apple certificates</li>
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-success text-xs" aria-hidden="true"></i> Provisioning profiles</li>
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-success text-xs" aria-hidden="true"></i> Android keystores</li>
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-success text-xs" aria-hidden="true"></i> Build &amp; review history</li>
        </ul>
      </article>

      <%# ── Screenshot Studio ───────────────────────────────────────── %>
      <article class="col-span-12 md:col-span-5 row-span-1 md:row-span-4 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6 relative overflow-hidden"
               style="background: var(--color-base-100);">
        <div class="flex items-center gap-2 text-xs">
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
          <span class="font-medium">Screenshot Studio</span>
          <span class="pill"
                style="background: color-mix(in oklab, var(--color-success) 18%, transparent); color: var(--color-success);">
            Free forever
          </span>
        </div>
        <h3 class="mt-4 font-display text-2xl sm:text-3xl leading-tight">
          Frame, tilt, sticker, translate &mdash; ship.
        </h3>

        <%# Mini studio canvas — three phone mocks. %>
        <div class="mt-5 grid grid-cols-3 gap-2.5">
          <div class="aspect-[9/16] rounded-md relative overflow-hidden"
               style="background: linear-gradient(160deg,#1a1a2e,#533483);">
            <div class="absolute top-2 left-2 right-2 text-[9px] font-bold text-center"
                 style="color:#fbbf24; font-family: 'Instrument Serif', serif;">Celebrate every launch</div>
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[55%] aspect-[9/19] rounded-[4px] border border-white/15 bg-white/5"></div>
          </div>
          <div class="aspect-[9/16] rounded-md relative overflow-hidden"
               style="background: linear-gradient(135deg,#667eea,#764ba2); transform: perspective(500px) rotateY(8deg);">
            <div class="absolute top-2 left-2 right-2 text-[9px] font-bold text-center text-white">Smart, fast,<br>yours.</div>
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[55%] aspect-[9/19] rounded-[4px] border border-white/20 bg-white/10"></div>
          </div>
          <div class="aspect-[9/16] rounded-md relative overflow-hidden"
               style="background: linear-gradient(135deg,#f97316,#ec4899);">
            <div class="absolute top-2 left-2 right-2 text-[9px] font-bold text-center text-white">Now in 44 locales</div>
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[55%] aspect-[9/19] rounded-[4px] border border-white/20 bg-white/10"></div>
          </div>
        </div>

        <div class="mt-4 flex items-center gap-1.5 flex-wrap">
          <span class="pill border border-soft">12 perspective presets</span>
          <span class="pill border border-soft">150+ stickers</span>
          <span class="pill border border-soft">12 templates</span>
          <span class="pill border border-soft">44 App Store locales</span>
        </div>
        <div class="mt-4 text-[12px] text-mute">
          Designed in the dashboard. Pushed to App Store Connect with one click.
        </div>
      </article>

      <%# ── Keywords / ASO ──────────────────────────────────────────── %>
      <article class="col-span-12 md:col-span-4 row-span-1 md:row-span-2 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6"
               style="background: var(--color-base-100);">
        <div class="flex items-center gap-2 text-xs">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <span class="font-medium">Keywords &amp; ASO</span>
          <span class="pill"
                style="background: color-mix(in oklab, var(--color-primary) 18%, transparent); color: var(--color-primary);">
            Pro+
          </span>
        </div>
        <div class="mt-3 font-display text-2xl leading-tight">
          50 keywords on Pro · 200 on Team.
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3 text-[11px]">
          <div class="rounded-md p-2.5" style="background: var(--color-base-200);">
            <div class="text-faint">"budget tracker"</div>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="font-display text-xl">42</span>
              <span class="text-success text-[10px]">+6 ▲</span>
            </div>
            <div class="text-faint mt-0.5">ASA popularity 71</div>
          </div>
          <div class="rounded-md p-2.5" style="background: var(--color-base-200);">
            <div class="text-faint">"split bill app"</div>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="font-display text-xl">18</span>
              <span class="text-error text-[10px]">−2 ▼</span>
            </div>
            <div class="text-faint mt-0.5">ASA popularity 53</div>
          </div>
        </div>
      </article>

      <%# ── Reviews & ratings ───────────────────────────────────────── %>
      <article class="col-span-12 md:col-span-4 row-span-1 md:row-span-2 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6"
               style="background: var(--color-base-100);">
        <div class="flex items-center gap-2 text-xs">
          <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
          <span class="font-medium">Reviews &amp; ratings</span>
          <span class="pill"
                style="background: color-mix(in oklab, var(--color-primary) 18%, transparent); color: var(--color-primary);">
            Pro+
          </span>
        </div>
        <div class="mt-3 font-display text-2xl leading-tight">Apple + Play in one inbox.</div>
        <div class="mt-3 space-y-1.5 text-[12px]">
          <div class="flex items-center gap-2">
            <span class="text-warning">★★★★★</span>
            <span class="text-mute truncate">"finally an app that just works on my phone…"</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-warning">★★★★</span><span class="text-faint">★</span>
            <span class="text-mute truncate">"please add Face ID lock"</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-warning">★★</span><span class="text-faint">★★★</span>
            <span class="text-mute truncate">"crashes opening shared budget"</span>
          </div>
        </div>
        <div class="mt-3 text-[11px] text-mute">
          Refresh: 2h on Pro · 30 min on Team. Filter by stars, locale, build, time.
        </div>
      </article>

      <%# ── Analytics ───────────────────────────────────────────────── %>
      <article class="col-span-12 md:col-span-4 row-span-1 md:row-span-2 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6"
               style="background: var(--color-base-100);">
        <div class="flex items-center gap-2 text-xs">
          <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
          <span class="font-medium">Analytics</span>
          <span class="pill"
                style="background: color-mix(in oklab, var(--color-primary) 18%, transparent); color: var(--color-primary);">
            Pro+
          </span>
        </div>
        <div class="mt-3 font-display text-2xl leading-tight">Plain-language metrics.</div>

        <svg viewBox="0 0 220 60" class="mt-3 w-full h-16" aria-hidden="true">
          <defs>
            <linearGradient id="dashboard-spark-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="currentColor" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g style="color: var(--color-primary);">
            <path d="M0,45 L20,40 L40,46 L60,30 L80,34 L100,22 L120,28 L140,18 L160,24 L180,12 L200,18 L220,8 L220,60 L0,60 Z"
                  fill="url(#dashboard-spark-fill)"/>
            <path d="M0,45 L20,40 L40,46 L60,30 L80,34 L100,22 L120,28 L140,18 L160,24 L180,12 L200,18 L220,8"
                  fill="none" stroke="currentColor" stroke-width="1.5"/>
          </g>
        </svg>

        <div class="grid grid-cols-3 text-[11px] gap-2">
          <div><div class="text-faint">D1</div><div class="font-display text-lg">63%</div></div>
          <div><div class="text-faint">D7</div><div class="font-display text-lg">38%</div></div>
          <div><div class="text-faint">D30</div><div class="font-display text-lg">21%</div></div>
        </div>
        <div class="mt-2 text-[11px] text-mute">90 days on Pro · 365 days on Team.</div>
      </article>

      <%# ── Custom Product Pages ────────────────────────────────────── %>
      <article class="col-span-12 md:col-span-7 row-span-1 md:row-span-2 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6"
               style="background: var(--color-base-100);">
        <div class="flex items-center gap-2 text-xs">
          <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
          <span class="font-medium">Custom Product Pages</span>
          <span class="pill"
                style="background: color-mix(in oklab, var(--color-primary) 18%, transparent); color: var(--color-primary);">
            Pro+
          </span>
        </div>
        <div class="mt-3 font-display text-2xl leading-tight">
          Up to 35 audience-targeted variants — wired to Apple Search Ads, conversion-tracked per-variant.
        </div>
        <div class="mt-4 grid grid-cols-2 sm:grid-cols-5 gap-2 text-[10px]">
          <div class="rounded-md p-2.5 border border-soft text-center">
            <div class="text-faint">CPP</div>
            <div class="font-medium">A/students</div>
            <div class="font-display text-lg mt-1 text-success">7.4%</div>
          </div>
          <div class="rounded-md p-2.5 border border-soft text-center">
            <div class="text-faint">CPP</div>
            <div class="font-medium">B/freelancers</div>
            <div class="font-display text-lg mt-1 text-success">6.1%</div>
          </div>
          <div class="rounded-md p-2.5 border border-soft text-center">
            <div class="text-faint">CPP</div>
            <div class="font-medium">C/couples</div>
            <div class="font-display text-lg mt-1 text-warning">3.8%</div>
          </div>
          <div class="rounded-md p-2.5 border border-soft text-center">
            <div class="text-faint">CPP</div>
            <div class="font-medium">D/de-DE</div>
            <div class="font-display text-lg mt-1 text-success">5.2%</div>
          </div>
          <div class="col-span-2 sm:col-span-1 rounded-md p-2.5 border border-soft text-center text-faint"
               style="background: color-mix(in oklab, var(--color-base-content) 4%, transparent);">
            <div>+31</div>
            <div>more slots</div>
          </div>
        </div>
      </article>

      <%# ── AI translations ─────────────────────────────────────────── %>
      <article class="col-span-12 md:col-span-5 row-span-1 md:row-span-2 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6"
               style="background: var(--color-base-100);">
        <div class="flex items-center gap-2 text-xs">
          <i class="fa-solid fa-language" aria-hidden="true"></i>
          <span class="font-medium">AI translations</span>
          <span class="pill"
                style="background: color-mix(in oklab, var(--color-primary) 18%, transparent); color: var(--color-primary);">
            Pro+
          </span>
        </div>
        <div class="mt-3 font-display text-2xl leading-tight">
          44 App Store locales · 100/mo on Pro · 500/mo on Team.
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5 text-[10px]">
          <% %w[en-US de-DE ja-JP es-MX fr-FR pt-BR ko-KR it-IT tr-TR zh-Hans].each do |loc| %>
            <span class="pill border border-soft"><%= loc %></span>
          <% end %>
          <span class="pill border border-soft text-faint">+34</span>
        </div>
        <div class="mt-3 text-[11px] text-mute">Cached &amp; editable per-locale. Free tier gets 5/mo.</div>
      </article>

      <%# ── Teams (full width) ──────────────────────────────────────── %>
      <article class="col-span-12 row-span-1 md:row-span-2 rounded-[var(--radius-box)] border border-soft p-5 sm:p-6 relative overflow-hidden"
               style="background: var(--color-base-100);">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12 items-start">
          <div class="col-span-1 md:col-span-5 min-w-0">
            <div class="flex items-center gap-2 text-xs">
              <i class="fa-solid fa-shield" aria-hidden="true"></i>
              <span class="font-medium">Teams &amp; access control</span>
              <span class="pill"
                    style="background: color-mix(in oklab, var(--color-accent) 24%, transparent); color: var(--color-accent);">
                Team plan
              </span>
            </div>
            <h3 class="mt-3 font-display text-2xl sm:text-3xl leading-tight">
              SAML 2.0 SSO · RBAC · 365-day immutable audit log.
            </h3>
          </div>
          <div class="col-span-1 md:col-span-7 min-w-0 grid grid-cols-2 sm:grid-cols-4 gap-3 text-[11px]">
            <div class="rounded-md p-3 border border-soft">
              <div class="text-faint uppercase tracking-wider">SSO</div>
              <div class="mt-1 font-medium">Okta</div>
              <div class="font-medium">Entra ID</div>
              <div class="font-medium">Workspace</div>
            </div>
            <div class="rounded-md p-3 border border-soft">
              <div class="text-faint uppercase tracking-wider">Roles</div>
              <div class="mt-1 font-medium">Owner · Admin</div>
              <div class="font-medium">Developer · Viewer</div>
            </div>
            <div class="rounded-md p-3 border border-soft">
              <div class="text-faint uppercase tracking-wider">Audit log</div>
              <div class="mt-1 font-medium">365 days</div>
              <div class="text-faint">immutable · CSV export</div>
            </div>
            <div class="rounded-md p-3 border border-soft">
              <div class="text-faint uppercase tracking-wider">Multi-org</div>
              <div class="mt-1 font-display text-2xl">10 × 10</div>
              <div class="text-faint">orgs × seats</div>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>
