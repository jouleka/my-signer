<%# Editorial landing-only navbar. Renders for unauthenticated visitors on
    the marketing surface; the authenticated app keeps shared/_navbar. %>
<header class="sticky top-0 z-40 backdrop-blur-md"
        style="background: color-mix(in oklab, var(--color-base-100) 75%, transparent);
               border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 8%, transparent);">
  <div class="mx-auto max-w-[1240px] px-6 h-14 flex items-center gap-8">

    <%# Brand — far left, existing icon. Sans-serif wordmark to match the
        docs heading style and stay coherent with the rest of the app. %>
    <%= link_to unauthenticated_root_path, class: "flex items-center gap-2.5 group", aria: { label: "MySigner home" } do %>
      <img src="/icon.svg" alt="" class="h-7 w-7" aria-hidden="true">
      <span class="text-xl font-bold tracking-tight">MySigner</span>
    <% end %>

    <%# Centered nav. Anchors target sections on the same page; pricing & docs
        route to their existing controllers. %>
    <nav class="hidden lg:flex items-center gap-7 text-sm text-mute mx-auto"
         aria-label="Primary">
      <a href="#cli" class="hover:text-base-content transition-colors">CLI</a>
      <a href="#dashboard" class="hover:text-base-content transition-colors">Dashboard</a>
      <a href="#studio" class="hover:text-base-content transition-colors">Screenshot Studio</a>
      <%= link_to "Pricing", pricing_path, class: "hover:text-base-content transition-colors" %>
      <%= link_to "Docs", docs_path, class: "hover:text-base-content transition-colors" %>
    </nav>

    <%# Auth CTAs — right edge. %>
    <div class="ml-auto flex items-center gap-2">
      <%= link_to "Sign in", new_user_session_path,
            class: "hidden sm:inline-flex btn btn-sm btn-ghost" %>
      <%= link_to new_user_registration_path,
            class: "btn btn-sm gap-2",
            style: "background: var(--color-primary); color: var(--color-primary-content); border-color: var(--color-primary);" do %>
        Start free
        <i class="fa-solid fa-arrow-right text-[10px]" aria-hidden="true"></i>
      <% end %>
    </div>
  </div>
</header>
