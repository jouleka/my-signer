<%# № 05 — vs Alternatives ("The math").
    Verified against:
      Billing::PlanCatalog::PLANS  → Pro $12/mo · $96/yr (save 33%) · Team $49/mo · $390/yr
      User::TRIAL_DURATION         → 14 days
      Pricing::Entitlements        → audit_log/rbac/sso are Team-only; everything else
                                     in the bullet list is Pro+ (or every plan).
    Competitor pricing (April 2026):
      AppFollow paid plans start at $179/mo — appfollow.io/blog/new-plans-at-appfollow
      Asodesk published tiers — Pro $47, Guru $159, Power $239, Ultimate $439
        — asodesk.com/pricing
      Range "$160–$440/mo" reflects mid-tier (Guru/Power) through Ultimate.
      Lokalise Explorer $144/mo, Crowdin Pro/Team $59–$179/mo, Phrase team
        ~$375/mo — range "$140–$400/mo" covers entry-tier through real-team
        usage. Sources: lokalise.com/pricing, crowdin.com/pricing, vendr.com.
    Sensor Tower deliberately omitted: no published self-serve tier
    (Vendr median ~$73K/yr) — including it without a real number would be
    speculative, so we compare against tools that publish prices. %>
<%
  alternative_stack = [
    {
      tool: "Fastlane / native CI",
      blurb: "Signs &amp; uploads. Doesn't do ASO, reviews, analytics, localization.",
      price: "&mdash; ish"
    },
    {
      tool: "AppFollow / Asodesk",
      blurb: "ASO, reviews, keywords, analytics. Doesn't ship.",
      price: "$160&ndash;440/mo"
    },
    {
      tool: "Lokalise / Crowdin / Phrase",
      blurb: "Strings &amp; store metadata in N locales. Doesn't ship or do ASO.",
      price: "$140&ndash;400/mo"
    },
    {
      tool: "Screenshot tooling",
      blurb: "Figma plugins, ad-hoc Photoshop, hand-zipping for ASC.",
      price: "hours/release"
    }
  ]

  mysigner_bullets = [
    "Signing &amp; shipping",
    "ASO + keywords",
    "Reviews inbox",
    "Analytics (90/365d)",
    "Custom Product Pages",
    "Screenshot Studio",
    "AI translations",
    "Per-locale captions"
  ]
%>

<section class="relative" style="background: var(--color-base-200);">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 py-16 sm:py-24">

    <%# Editorial header rail. %>
    <div class="flex items-end justify-between gap-8 flex-wrap">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 text-[11px] uppercase tracking-[0.18em] text-mute mb-4 font-mono">
          <span class="secnum text-base normal-case tracking-normal">№ 05</span>
          <span class="editorial-rule w-12"></span>
          <span>The math</span>
        </div>
        <h2 class="font-display leading-[1] tracking-tight"
            style="font-size: clamp(40px, 5vw, 76px);">
          What you used to pay
          <span class="italic" style="color: var(--color-primary);">five tools</span>
          to do.
        </h2>
      </div>
      <p class="text-mute text-sm max-w-sm">
        Fastlane handles signing. AppFollow handles ASO. Lokalise handles strings.
        MySigner does all of it &mdash; at the price of a sandwich.
      </p>
    </div>

    <%# Comparison card: today's stack on the left, MySigner on the right. %>
    <div class="mt-12 rounded-[var(--radius-box)] overflow-hidden border border-soft"
         style="background: var(--color-base-100);">
      <div class="grid grid-cols-12 text-sm">

        <%# Today's stack column. %>
        <div class="col-span-12 md:col-span-5 p-6 md:border-r border-soft">
          <div class="text-[10px] uppercase tracking-[0.16em] text-faint font-mono">Today's stack</div>
          <ul class="mt-4 space-y-3">
            <% alternative_stack.each do |item| %>
              <li class="flex items-baseline justify-between gap-3">
                <span>
                  <span class="font-medium"><%= item[:tool] %></span><br>
                  <span class="text-mute text-xs"><%= raw item[:blurb] %></span>
                </span>
                <span class="font-mono text-mute tnum shrink-0"><%= raw item[:price] %></span>
              </li>
            <% end %>
          </ul>
          <div class="mt-6 pt-5 border-t border-soft flex items-baseline justify-between">
            <span class="text-mute">Combined</span>
            <span class="font-display text-3xl"
                  style="text-decoration: line-through; text-decoration-color: color-mix(in oklab, var(--color-base-content) 50%, transparent); color: color-mix(in oklab, var(--color-base-content) 35%, transparent);">
              $300&ndash;$800/mo
            </span>
          </div>
        </div>

        <%# MySigner column with primary tint. %>
        <div class="col-span-12 md:col-span-7 p-6 relative overflow-hidden"
             style="background: linear-gradient(140deg, color-mix(in oklab, var(--color-primary) 14%, transparent), transparent 70%);">
          <div class="text-[10px] uppercase tracking-[0.16em] font-mono"
               style="color: var(--color-primary);">
            MySigner
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <% mysigner_bullets.each do |b| %>
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-check text-success text-xs" aria-hidden="true"></i>
                <%= raw b %>
              </div>
            <% end %>
          </div>

          <div class="mt-8 flex items-end justify-between gap-4 flex-wrap">
            <div>
              <div class="text-mute text-sm">Pro &mdash; everything above</div>
              <div class="font-display leading-none mt-1"
                   style="font-size: clamp(56px, 7vw, 80px);">
                $12<span class="text-mute" style="font-size: 0.32em;">/mo</span>
              </div>
              <div class="text-xs text-mute mt-2">
                or $96/yr &mdash; <span style="color: var(--color-success);">save 33%</span> &middot; 14-day trial, no card
              </div>
            </div>
            <%= link_to pricing_path,
                  class: "btn",
                  style: "background: var(--color-primary); color: var(--color-primary-content); border-color: var(--color-primary);" do %>
              See plans
              <i class="fa-solid fa-arrow-right text-xs ml-1" aria-hidden="true"></i>
            <% end %>
          </div>

          <%# Team-tier callout — keeps the SSO/RBAC/audit-log capability
              visible but doesn't falsely attribute it to the $12/mo Pro price. %>
          <div class="mt-6 pt-4 border-t border-soft text-[12px] text-mute leading-relaxed">
            <span class="font-medium" style="color: var(--color-base-content);">Team plan ($49/mo)</span>
            adds SAML 2.0 SSO, 365-day immutable audit log, and RBAC for orgs that need it.
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
