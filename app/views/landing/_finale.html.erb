<%# Finale CTA — the closing moment. Centered, dark, grain, big serif.
    Mirrors the design's "Close the tab. Open a terminal." beat. %>
<section class="relative overflow-hidden">
  <div class="grain absolute inset-0" aria-hidden="true"></div>

  <%# Soft violet glow to echo the hero's halo. %>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[420px] w-[820px] rounded-full"
         style="background: radial-gradient(closest-side, color-mix(in oklab, var(--color-primary) 16%, transparent), transparent 70%); filter: blur(20px);"></div>
  </div>

  <div class="relative mx-auto max-w-[1240px] px-6 py-28 text-center">
    <h2 class="font-display leading-[0.95] tracking-tight"
        style="font-size: clamp(56px, 8vw, 128px);">
      Close the tab.<br>
      <span class="italic" style="color: var(--color-primary);">Open a terminal.</span>
    </h2>

    <p class="mt-8 text-mute max-w-xl mx-auto">
      Five minutes from
      <span class="font-mono text-base-content">gem install mysigner</span>
      to "your app is on TestFlight".
    </p>

    <div class="mt-8 flex items-center justify-center gap-3 flex-wrap">
      <%= link_to new_user_registration_path,
            class: "btn btn-lg gap-2",
            style: "background: var(--color-primary); color: var(--color-primary-content); border-color: var(--color-primary);" do %>
        Start free
        <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
      <% end %>
      <%= link_to docs_path, class: "btn btn-lg btn-ghost gap-2 border border-soft" do %>
        <i class="fa-solid fa-book text-xs" aria-hidden="true"></i>
        Read the docs
      <% end %>
    </div>

    <%# Copy-paste install command. The clipboard Stimulus controller is
        already wired by the existing hero — same pattern, no new JS. %>
    <div class="mt-12 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-soft text-xs text-mute font-mono"
         style="background: color-mix(in oklab, var(--color-base-200) 60%, transparent);">
      <span class="text-faint">$</span>
      gem install mysigner
      <button type="button"
              class="ml-1 text-mute hover:text-base-content transition-colors"
              data-controller="clipboard"
              data-clipboard-content-value="gem install mysigner"
              data-action="click->clipboard#copy"
              aria-label="Copy gem install command">
        <i class="fa-regular fa-copy" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</section>
