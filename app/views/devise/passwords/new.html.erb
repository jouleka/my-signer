<%# Editorial forgot password — two-column auth shell. Same visual
    system as sign-up / sign-in: Instrument Serif headline + italic
    primary accent, numbered editorial markers, JetBrains Mono mono
    snippets, warm-stone tokens. Right rail walks through the 3-step
    reset flow + a sample of the email that arrives. %>

<div class="auth-shell grid lg:grid-cols-2 h-screen w-full overflow-hidden">

  <%# ── Left: editorial form ─────────────────────────────────────── %>
  <div class="relative flex flex-col h-full overflow-y-auto bg-base-100">
    <%# Top chrome — Back to Home %>
    <div class="absolute top-5 left-5 sm:top-6 sm:left-8 z-20">
      <%= link_to unauthenticated_root_path,
            class: "inline-flex items-center gap-2 text-xs text-base-content/60 hover:text-base-content transition-colors" do %>
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        <span>Back to Home</span>
      <% end %>
    </div>

    <%# Both columns center vertically — content blocks are roughly
        the same height so the wordmark and the right rail's section
        marker land on similar y-positions while leaving balanced
        breathing room top + bottom. %>
    <div class="flex flex-col min-h-full px-6 sm:px-12 lg:px-14 xl:px-20 pt-20 lg:pt-12 pb-12">
      <div class="w-full max-w-[440px] mx-auto my-auto">

        <%# Wordmark — official MySigner logo + Instrument Serif wordmark %>
        <div class="mb-8">
          <div class="flex items-center gap-2.5 mb-6">
            <img src="/icon.svg" alt="" class="h-7 w-7" aria-hidden="true">
            <span class="font-display text-[26px] tracking-tight">MySigner</span>
          </div>
          <%# Editorial section marker %>
          <div class="flex items-center gap-3 text-[10.5px] uppercase tracking-[0.18em]" style="color: color-mix(in oklab, var(--color-base-content) 55%, transparent);">
            <span class="secnum text-[14px] normal-case tracking-normal">№ 01</span>
            <span class="editorial-rule w-10"></span>
            <span>Forgot password</span>
          </div>
        </div>

        <%# Headline + lede %>
        <h1 class="font-display leading-[0.96] tracking-tight" style="font-size: clamp(48px, 5.5vw, 64px);">
          Lost the <span class="italic" style="color: var(--color-primary);">key?</span>
        </h1>
        <p class="mt-4 text-[14.5px] leading-relaxed text-mute max-w-[420px]">
          Tell us your email and we'll send you a fresh-cut one. The link is good for six hours.
        </p>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name),
              html: { method: :post, class: "mt-8 space-y-0",
                      data: { controller: "form-validator" } }) do |f| %>

          <%# Email %>
          <div class="form-control mb-4">
            <div class="label-row">
              <span class="lbl"><%= t('.email_label') %></span>
            </div>
            <%= f.label :email, class: "input input-bordered field #{'input-error' if resource.errors[:email].any?}" do %>
              <i class="fa-solid fa-envelope lead"></i>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                    placeholder: "you@studio.com",
                    data: { action: "input->form-validator#validate blur->form-validator#validate", field: "email" } %>
            <% end %>
            <div class="validator-error text-error text-[11px] mt-1.5 hidden items-center gap-1.5">
              <i class="fa-solid fa-circle-exclamation text-[10px]"></i>
              <span></span>
            </div>
            <div class="validator-hint hint">The address on your MySigner account.</div>
          </div>

          <button type="submit" class="btn-primary-ms mt-2">
            <i class="fa-solid fa-paper-plane text-[11px]"></i>
            <%= t('.submit') %>
          </button>
        <% end %>

        <%# Privacy-first reassurance — only shown when this page is
            being re-rendered with a notice flash. Devise's default flow
            redirects to sign-in after submit, so this normally only
            appears on edge cases (e.g., form re-render). The shape of
            the message is identical to what the sign-in page toast
            shows so the user gets consistent feedback either way. %>
        <% if flash[:notice].present? && !flash[:notice].to_s.match?(/sign|log/i) %>
          <div class="mt-6 rounded-[var(--radius-field)] border p-4 text-[12.5px] flex items-start gap-3"
               style="border-color: color-mix(in oklab, var(--color-success) 36%, transparent); background: color-mix(in oklab, var(--color-success) 8%, transparent);">
            <i class="fa-solid fa-circle-check mt-0.5" style="color: var(--color-success);"></i>
            <div>
              <div class="font-medium" style="color: var(--color-success);">If we found you, an email is on the way.</div>
              <div class="text-mute mt-1">Check spam if it's not there in 30 seconds. The link will work for 2 hours and can only be used once.</div>
            </div>
          </div>
        <% end %>

        <%# Foot links %>
        <div class="mt-6 text-[12.5px] text-mute space-y-1.5">
          <div>
            Got it back?
            <%= link_to "Sign in", new_user_session_path, class: "alink" %>
          </div>
          <div>
            New here?
            <%= link_to "Create an account", new_user_registration_path, class: "alink" %>
          </div>
          <% if devise_mapping.confirmable? %>
            <div>
              Need a confirmation email instead?
              <%= link_to "Resend confirmation", new_user_confirmation_path, class: "alink" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Right: editorial right rail (hidden under lg) ────────────── %>
  <div class="editorial-right hidden lg:block h-full overflow-hidden relative">
    <div class="absolute inset-0 grain p-12 flex flex-col justify-center">
      <%# Editorial header %>
      <div class="flex items-center gap-3 text-[10.5px] uppercase tracking-[0.18em] text-mute">
        <span class="secnum text-[14px] normal-case tracking-normal">№ 02</span>
        <span class="editorial-rule w-10"></span>
        <span>Reset flow</span>
      </div>

      <h2 class="mt-6 font-display leading-[0.96] tracking-tight" style="font-size: 56px;">
        We'll send a<br>
        <span class="italic" style="color: var(--color-primary);">fresh key.</span>
      </h2>

      <%# Step diagram — 3 steps with progress bars showing where the
          user is in the flow (here: step 1 done, step 2 in progress,
          step 3 not started). Each cell is a flex column with the
          progress bar wrapped in a `mt-auto pt-4` spacer so the bars
          line up at the same y-position across all three columns
          even when one description wraps to two lines. %>
      <div class="mt-10 rounded-[var(--radius-box)] border border-soft overflow-hidden"
           style="background: var(--color-base-100);">
        <div class="grid grid-cols-3 items-stretch">
          <div class="p-5 border-r border-soft flex flex-col">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint">01 &middot; You</div>
            <div class="mt-2 font-medium text-[13.5px]">Enter your email</div>
            <div class="mt-1 text-[11px] text-mute">We'll match it against your MySigner account.</div>
            <div class="mt-auto pt-4">
              <div class="h-1 rounded-full bg-base-300 overflow-hidden">
                <div class="h-full w-full rounded-full" style="background: var(--color-primary);"></div>
              </div>
            </div>
          </div>
          <div class="p-5 border-r border-soft flex flex-col">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint">02 &middot; Inbox</div>
            <div class="mt-2 font-medium text-[13.5px]">Open the email</div>
            <div class="mt-1 text-[11px] text-mute">Link is good for <span class="kbd-mono">6 hours</span>.</div>
            <div class="mt-auto pt-4">
              <div class="h-1 rounded-full bg-base-300 overflow-hidden">
                <div class="h-full rounded-full shimmer" style="width: 66%; background-color: var(--color-primary);"></div>
              </div>
            </div>
          </div>
          <div class="p-5 flex flex-col">
            <div class="text-[10px] uppercase tracking-[0.16em] text-faint">03 &middot; Reset</div>
            <div class="mt-2 font-medium text-[13.5px]">Pick a new password</div>
            <div class="mt-1 text-[11px] text-mute">Min <%= Devise.password_length.min %> chars. Audit log entry written.</div>
            <div class="mt-auto pt-4">
              <div class="h-1 rounded-full bg-base-300 overflow-hidden">
                <div class="h-full rounded-full" style="width: 20%; background: color-mix(in oklab, var(--color-base-content) 25%, transparent);"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Sample email preview — what the user receives in their inbox. %>
      <div class="mt-3 rounded-[var(--radius-box)] border border-soft p-5 relative overflow-hidden"
           style="background: var(--color-base-100); min-height: 180px;">
        <div class="text-[10.5px] uppercase tracking-[0.18em] text-faint mb-3">Sample of what arrives</div>
        <div class="rounded-md border border-soft p-4" style="background: var(--color-base-200);">
          <div class="text-[11px] text-mute font-mono-jb">From: <span class="text-base-content/80">no-reply@mysigner.dev</span></div>
          <div class="text-[11px] text-mute font-mono-jb">Subject: <span class="text-base-content/80">Reset your MySigner password</span></div>
          <div class="mt-3 text-[12px]">Hello &mdash; somebody asked for a password reset. If that was you, hit the button below within the next two hours.</div>
          <div class="mt-3 inline-flex items-center gap-2 px-3 py-2 rounded-md text-[11.5px] font-medium"
               style="background: var(--color-primary); color: var(--color-primary-content);">
            <i class="fa-solid fa-key text-[10px]"></i>
            Set a new password
          </div>
          <div class="mt-2 text-[10.5px] text-faint">If the button doesn't work, paste this URL: mysigner.dev/u/reset/8f3c&hellip;2a90</div>
        </div>
      </div>

      <div class="mt-6 text-[11px] text-faint">
        <i class="fa-solid fa-circle-info mr-1"></i>
        We don't tell strangers whether an email is registered &mdash; same response either way.
      </div>
    </div>
  </div>
</div>
