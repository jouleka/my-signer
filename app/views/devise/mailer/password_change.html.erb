<% @preheader = "Confirmation: your MySigner password was just changed." %>

<%= ms_eyebrow(3, "Security · Password changed") %>
<%= ms_headline("Password <em style=\"font-style:italic; color:#c8a8f5;\" class=\"ms-primary\">updated.</em>") %>

<%= ms_lead("This is a confirmation receipt &mdash; the password for your MySigner account was just changed.") %>

<%= ms_meta_row("Account", ms_meta_pill(@resource.email)) %>
<%= ms_meta_row("Changed at", "<span class=\"ms-ink\" style=\"color:#f4ede0; font-style:italic;\">#{Time.current.strftime('%B %-d, %Y · %H:%M %Z')}</span>".html_safe) %>

<%= ms_callout(
  "If you didn't make this change, write to us straight away and reset the password from the sign-in page. The earlier we hear about it, the easier it is to lock the account back down.",
  variant: :danger,
  accent_label: "Wasn't you?"
) %>

<%= ms_fine_print("This receipt is sent every time the password changes. We do not include the new password in any email, ever.") %>
