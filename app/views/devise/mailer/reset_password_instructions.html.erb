<% @preheader = "Set a new password for your MySigner account. Link expires in 6 hours." %>

<%= ms_eyebrow(2, "Security · Password reset") %>
<%= ms_headline("Reset <em style=\"font-style:italic; color:#c8a8f5;\" class=\"ms-primary\">your password.</em>") %>

<%= ms_lead("We received a request to set a new password for your MySigner account.") %>

<%= ms_meta_row("Account", ms_meta_pill(@resource.email)) %>
<%= ms_meta_row("Link valid", "<span class=\"ms-ink\" style=\"color:#f4ede0; font-style:italic;\">six hours from now</span>".html_safe) %>

<%= ms_cta("Set a new password", edit_password_url(@resource, reset_password_token: @token), variant: :primary, margin_top: 24, margin_bottom: 28) %>

<%= ms_rule(margin_top: 4, margin_bottom: 22) %>

<%= ms_fine_print("Didn't ask for this? Ignore the message &mdash; your password is unchanged. If you start seeing reset requests you didn't make, write to us and we'll help secure the account.") %>
